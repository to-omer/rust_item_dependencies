+#[derive(Clone, Copy, Debug, Eq, PartialEq, StableHash)]
+pub enum MacroInvocationFragmentKind {
+    OptExpr,
+    MethodReceiverExpr,
+    Expr,
+    Pat,
+    Ty,
+    Stmts,
+    Items,
+    TraitItems,
+    ImplItems,
