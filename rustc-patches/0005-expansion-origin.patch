+    Procedural,
+    Legacy,
+    InertAttribute,
+    GlobDelegation,
+}
+
+#[derive(Clone, Debug, StableHash)]
+pub struct MacroInvocationOrigin {
+    /// Expansion whose output contained this invocation when it was collected.
+    pub discovered_in_expansion: ExpnId,
+    /// Span of the unexpanded AST node that contained the invocation.
+    ///
+    /// For a written statement or item macro this includes its trailing semicolon.
+    /// Nested generated invocations retain their expansion context in this span.
+    /// Outer attributes and comments are owned by the source inventory, not this span.
+    pub invocation_node_span: Span,
+    /// Target item for attribute and derive invocations.
+    pub target_span: Option<Span>,
+    pub fragment_kind: MacroInvocationFragmentKind,
+    pub implementation_kind: MacroImplementationKind,
+}
