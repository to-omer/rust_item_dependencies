+fn macro_invocation_fragment_kind(kind: AstFragmentKind) -> MacroInvocationFragmentKind {
+    match kind {
+        AstFragmentKind::OptExpr => MacroInvocationFragmentKind::OptExpr,
+        AstFragmentKind::MethodReceiverExpr => MacroInvocationFragmentKind::MethodReceiverExpr,
+        AstFragmentKind::Expr => MacroInvocationFragmentKind::Expr,
+        AstFragmentKind::Pat => MacroInvocationFragmentKind::Pat,
+        AstFragmentKind::Ty => MacroInvocationFragmentKind::Ty,
+        AstFragmentKind::Stmts => MacroInvocationFragmentKind::Stmts,
+        AstFragmentKind::Items => MacroInvocationFragmentKind::Items,
+        AstFragmentKind::TraitItems => MacroInvocationFragmentKind::TraitItems,
+        AstFragmentKind::ImplItems => MacroInvocationFragmentKind::ImplItems,
+        AstFragmentKind::TraitImplItems => MacroInvocationFragmentKind::TraitImplItems,
+        AstFragmentKind::ForeignItems => MacroInvocationFragmentKind::ForeignItems,
+        AstFragmentKind::Arms => MacroInvocationFragmentKind::Arms,
+        AstFragmentKind::ExprFields => MacroInvocationFragmentKind::ExprFields,
+        AstFragmentKind::PatFields => MacroInvocationFragmentKind::PatFields,
+        AstFragmentKind::GenericParams => MacroInvocationFragmentKind::GenericParams,
+        AstFragmentKind::Params => MacroInvocationFragmentKind::Params,
+        AstFragmentKind::FieldDefs => MacroInvocationFragmentKind::FieldDefs,
+        AstFragmentKind::Variants => MacroInvocationFragmentKind::Variants,
+        AstFragmentKind::WherePredicates => MacroInvocationFragmentKind::WherePredicates,
+        AstFragmentKind::Crate => MacroInvocationFragmentKind::Crate,
+    }
+}
+
+fn macro_implementation_kind(ext: &SyntaxExtension) -> MacroImplementationKind {
+    if ext.builtin_name.is_some() {
+        return MacroImplementationKind::Builtin;
+    }
+    match &ext.kind {
+        SyntaxExtensionKind::MacroRules(_) => MacroImplementationKind::Declarative,
+        SyntaxExtensionKind::Bang(_)
+        | SyntaxExtensionKind::Attr(_)
+        | SyntaxExtensionKind::Derive(_) => MacroImplementationKind::Procedural,
+        SyntaxExtensionKind::LegacyBang(_)
+        | SyntaxExtensionKind::LegacyAttr(_)
+        | SyntaxExtensionKind::LegacyDerive(_) => MacroImplementationKind::Legacy,
+        SyntaxExtensionKind::NonMacroAttr => MacroImplementationKind::InertAttribute,
+        SyntaxExtensionKind::GlobDelegation(_) => MacroImplementationKind::GlobDelegation,
+    }
+}
