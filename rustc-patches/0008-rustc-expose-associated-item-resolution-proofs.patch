+fn codegen_associated_item_proof<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    key: ty::PseudoCanonicalInput<'tcx, (DefId, GenericArgsRef<'tcx>)>,
+) -> Result<&'tcx CodegenAssociatedItemProof<'tcx>, CodegenAssociatedItemProofError> {
+    let PseudoCanonicalInput { typing_env, value: (trait_item_id, args) } = key;
+    if !matches!(tcx.def_kind(trait_item_id), DefKind::AssocFn | DefKind::AssocConst { .. }) {
+        return Err(CodegenAssociatedItemProofError::UnsupportedItemKind);
+    }
+    let trait_id =
+        tcx.trait_of_assoc(trait_item_id).ok_or(CodegenAssociatedItemProofError::NotAssociated)?;
+    let final_instance = tcx
+        .resolve_instance_raw(key)
+        .map_err(CodegenAssociatedItemProofError::Resolution)?
+        .ok_or(CodegenAssociatedItemProofError::Unresolved)?;
+    let rcvr_args = tcx.normalize_erasing_regions(typing_env, Unnormalized::new_wip(args));
+    let trait_ref = ty::TraitRef::from_assoc(tcx, trait_id, rcvr_args);
+    let selection_key = typing_env.as_query_input(trait_ref);
+    let source = tcx
+        .codegen_select_candidate(selection_key)
+        .map_err(CodegenAssociatedItemProofError::Selection)?
+        .clone();
+    let (impl_def_id, impl_args) = match &source {
+        traits::ImplSource::UserDefined(data) => (data.impl_def_id, data.args),
+        traits::ImplSource::Param(_) | traits::ImplSource::Builtin(..) => {
+            return Err(CodegenAssociatedItemProofError::UnsupportedSource);
+        }
+    };
+
+    if tcx.impl_trait_id(impl_def_id) != trait_id {
+        return Err(CodegenAssociatedItemProofError::IncompleteObservation);
+    }
+    let trait_def = tcx.trait_def(trait_id);
+    let ancestors = trait_def
+        .ancestors(tcx, impl_def_id)
+        .map_err(CodegenAssociatedItemProofError::Resolution)?;
+    let leaf_def = ancestors
+        .leaf_def(tcx, trait_item_id)
+        .ok_or(CodegenAssociatedItemProofError::IncompleteObservation)?;
+    let normalized_typing_env = typing_env.with_post_analysis_normalized(tcx);
+    let (infcx, param_env) = tcx.infer_ctxt().build_with_typing_env(normalized_typing_env);
+    let translated_args = rcvr_args.rebase_onto(tcx, trait_id, impl_args);
+    let translated_args =
+        translate_args(&infcx, param_env, impl_def_id, translated_args, leaf_def.defining_node);
+    let expected_instance =
+        Instance::new_raw(leaf_def.item.def_id, tcx.erase_and_anonymize_regions(translated_args));
+    if final_instance != expected_instance {
+        return Err(CodegenAssociatedItemProofError::IncompleteObservation);
+    }
+
+    let defining_node = codegen_specialization_node(leaf_def.defining_node);
+    let finalizing_node = leaf_def.finalizing_node.map(codegen_specialization_node);
+    let mut reached_defining_node = false;
+    let mut ancestor_path = Vec::new();
+    for node in ancestors {
+        let node = codegen_specialization_node(node);
+        ancestor_path.push(node);
+        if node == defining_node {
+            reached_defining_node = true;
+        }
+    }
+    if !reached_defining_node
+        || ancestor_path.first() != Some(&CodegenSpecializationNode::Impl(impl_def_id))
+        || ancestor_path.last() != Some(&CodegenSpecializationNode::Trait(trait_id))
+        || finalizing_node.is_some_and(|node| !ancestor_path.contains(&node))
+    {
+        return Err(CodegenAssociatedItemProofError::IncompleteObservation);
+    }
+
+    let proof = CodegenAssociatedItemProof {
+        selection_key,
+        source,
+        final_instance,
+        leaf_item: leaf_def.item.def_id,
+        defining_node,
+        finalizing_node,
+        ancestor_path,
+    };
+    Ok(tcx.arena.alloc(proof))
+}
+
+fn codegen_specialization_node(
+    node: traits::specialization_graph::Node,
+) -> CodegenSpecializationNode {
+    match node {
+        traits::specialization_graph::Node::Impl(def_id) => CodegenSpecializationNode::Impl(def_id),
+        traits::specialization_graph::Node::Trait(def_id) => {
+            CodegenSpecializationNode::Trait(def_id)
+        }
+    }
+}
+
 fn resolve_associated_item<'tcx>(
     tcx: TyCtxt<'tcx>,
     trait_item_id: DefId,
@@ -435,5 +529,5 @@ fn resolve_associated_item<'tcx>(
 }
 
