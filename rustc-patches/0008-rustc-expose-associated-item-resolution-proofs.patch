+
+/// A specialization-graph node used to explain an associated-item resolution.
+#[derive(Copy, Clone, Debug, PartialEq, Eq, Hash, StableHash)]
+#[derive(TypeFoldable, TypeVisitable)]
+pub enum CodegenSpecializationNode {
+    Impl(DefId),
+    Trait(DefId),
+}
+
+/// The user-defined leaf selected for a concrete associated-item instance.
+#[derive(Clone, Debug, PartialEq, Eq, StableHash)]
+#[derive(TypeFoldable, TypeVisitable)]
+pub struct CodegenAssociatedItemProof<'tcx> {
+    pub selection_key: ty::PseudoCanonicalInput<'tcx, ty::TraitRef<'tcx>>,
+    pub source: ImplSource<'tcx, ()>,
+    pub final_instance: ty::Instance<'tcx>,
+    pub leaf_item: DefId,
+    pub defining_node: CodegenSpecializationNode,
+    pub finalizing_node: Option<CodegenSpecializationNode>,
+    /// The specialization ancestors from the selected impl through the trait root, inclusive.
+    pub ancestor_path: Vec<CodegenSpecializationNode>,
+}
+
+/// Fail-closed outcomes for the associated-item proof observer.
+#[derive(Copy, Clone, Debug, StableHash)]
+pub enum CodegenAssociatedItemProofError {
+    Resolution(ErrorGuaranteed),
+    Selection(CodegenObligationError),
+    NotAssociated,
+    UnsupportedItemKind,
+    Unresolved,
+    UnsupportedSource,
+    IncompleteObservation,
+}
