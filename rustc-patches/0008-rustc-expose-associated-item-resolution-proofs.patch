diff --git a/tests/ui-fulldeps/associated-item-proof.rs b/tests/ui-fulldeps/associated-item-proof.rs
new file mode 100644
index 00000000..e6c70cef
--- /dev/null
+++ b/tests/ui-fulldeps/associated-item-proof.rs
@@ -0,0 +1,196 @@
+//@ run-pass
+//@ run-flags: --sysroot {{sysroot-base}} --edition=2021
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_span;
+
+use std::process::ExitCode;
+
+use rustc_driver::Compilation;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::DefId;
+use rustc_interface::interface::Compiler;
+use rustc_middle::traits::{CodegenSpecializationNode, ImplSource};
+use rustc_middle::ty::{self, Instance, Ty, TyCtxt};
+use rustc_span::Symbol;
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        std::fs::write(
+            "associated_item_proof_input.rs",
+            r#"
+                trait Pick {
+                    fn pick<U>(&self) -> u8 {
+                        let _ = std::mem::size_of::<U>();
+                        1
+                    }
+                }
+
+                struct Defaulted<T>(T);
+                impl<T> Pick for Defaulted<T> {}
+
+                struct Overridden<T>(T);
+                impl<T> Pick for Overridden<T> {
+                    fn pick<U>(&self) -> u8 {
+                        let _ = std::mem::size_of::<U>();
+                        2
+                    }
+                }
+
+                fn main() {
+                    assert_eq!(Defaulted(0u8).pick::<u16>(), 1);
+                    assert_eq!(Overridden(0u8).pick::<u16>(), 2);
+                }
+            "#,
+        )
+        .unwrap();
+
+        let mut args: Vec<_> = std::env::args().collect();
+        args.push("--crate-name=associated_item_proof_input".to_owned());
+        args.push("associated_item_proof_input.rs".to_owned());
+        rustc_driver::run_compiler(&args, &mut CompilerCalls);
+    })
+}
+
+struct CompilerCalls;
+
+impl rustc_driver::Callbacks for CompilerCalls {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+
+        let pick = named_def(tcx, "Pick", DefKind::Trait);
+        let pick_method = associated_item(tcx, pick, "pick");
+        let defaulted = named_def(tcx, "Defaulted", DefKind::Struct);
+        let overridden = named_def(tcx, "Overridden", DefKind::Struct);
+        let defaulted_impl = impl_for_adt(tcx, pick, defaulted);
+        let overridden_impl = impl_for_adt(tcx, pick, overridden);
+        let overridden_method = tcx.impl_item_implementor_ids(overridden_impl)[&pick_method];
+
+        let defaulted_ty = adt_with_u8(tcx, defaulted);
+        let overridden_ty = adt_with_u8(tcx, overridden);
+        assert_user_defined_proof(
+            tcx,
+            pick,
+            pick_method,
+            defaulted_ty,
+            defaulted_impl,
+            pick_method,
+            CodegenSpecializationNode::Trait(pick),
+            vec![
+                CodegenSpecializationNode::Impl(defaulted_impl),
+                CodegenSpecializationNode::Trait(pick),
+            ],
+            tcx.mk_args(&[defaulted_ty.into(), tcx.types.u16.into()]),
+            false,
+        );
+        assert_user_defined_proof(
+            tcx,
+            pick,
+            pick_method,
+            overridden_ty,
+            overridden_impl,
+            overridden_method,
+            CodegenSpecializationNode::Impl(overridden_impl),
+            vec![
+                CodegenSpecializationNode::Impl(overridden_impl),
+                CodegenSpecializationNode::Trait(pick),
+            ],
+            tcx.mk_args(&[tcx.types.u8.into(), tcx.types.u16.into()]),
+            true,
+        );
+
+        Compilation::Stop
+    }
+}
+
+fn assert_user_defined_proof<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    trait_id: DefId,
+    trait_item: DefId,
+    self_ty: Ty<'tcx>,
+    expected_impl: DefId,
+    expected_leaf: DefId,
+    expected_defining_node: CodegenSpecializationNode,
+    expected_ancestor_path: Vec<CodegenSpecializationNode>,
+    expected_final_args: ty::GenericArgsRef<'tcx>,
+    prewarm_stock_queries: bool,
+) {
+    let typing_env = ty::TypingEnv::fully_monomorphized();
+    let call_args = tcx.mk_args(&[self_ty.into(), tcx.types.u16.into()]);
+    let key = tcx.erase_and_anonymize_regions(typing_env.as_query_input((trait_item, call_args)));
+    let expected_selection_key =
+        typing_env.as_query_input(ty::TraitRef::new(tcx, trait_id, [self_ty]));
+    if prewarm_stock_queries {
+        let _ = tcx.resolve_instance_raw(key).unwrap().unwrap();
+        let _ = tcx.codegen_select_candidate(expected_selection_key).unwrap();
+    }
+    let proof = tcx.codegen_associated_item_proof(key).unwrap();
+    let warm_proof = tcx.codegen_associated_item_proof(key).unwrap();
+    assert!(std::ptr::eq(proof, warm_proof));
+
+    let stock_instance = tcx.resolve_instance_raw(key).unwrap().unwrap();
+    assert_eq!(proof.final_instance, stock_instance);
+    assert_eq!(proof.final_instance, Instance::new_raw(expected_leaf, expected_final_args));
+
+    assert_eq!(proof.selection_key, expected_selection_key);
+    assert_eq!(proof.source, *tcx.codegen_select_candidate(expected_selection_key).unwrap());
+    assert_eq!(
+        proof.source,
+        tcx.codegen_selection_proof(proof.selection_key).unwrap().top_source
+    );
+    assert!(matches!(
+        &proof.source,
+        ImplSource::UserDefined(data)
+            if data.impl_def_id == expected_impl
+                && data.args == tcx.mk_args(&[tcx.types.u8.into()])
+    ));
+    assert_eq!(proof.leaf_item, expected_leaf);
+    assert_eq!(proof.defining_node, expected_defining_node);
+    assert_eq!(proof.finalizing_node, Some(CodegenSpecializationNode::Impl(expected_impl)));
+    assert_eq!(proof.ancestor_path, expected_ancestor_path);
+}
+
+fn adt_with_u8<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Ty<'tcx> {
+    Ty::new_adt(tcx, tcx.adt_def(def_id), tcx.mk_args(&[tcx.types.u8.into()]))
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    let name = Symbol::intern(name);
+    tcx.iter_local_def_id()
+        .map(|def_id| def_id.to_def_id())
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id) == name)
+        .unwrap()
+}
+
+fn associated_item(tcx: TyCtxt<'_>, owner: DefId, name: &str) -> DefId {
+    let name = Symbol::intern(name);
+    tcx.associated_items(owner)
+        .in_definition_order()
+        .find(|item| item.opt_name() == Some(name))
+        .unwrap()
+        .def_id
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(|def_id| def_id.to_def_id())
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&def_id| {
+            tcx.impl_trait_id(def_id) == trait_id
+                && tcx
+                    .impl_trait_ref(def_id)
+                    .skip_binder()
+                    .self_ty()
+                    .ty_adt_def()
+                    .is_some_and(|adt| adt.did() == adt_id)
+        })
+        .unwrap()
+}
