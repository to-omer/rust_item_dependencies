+    requested_args: GenericArgsRef<'tcx>,
+) -> Result<Option<AssociatedSelectionKeys<'tcx>>, NormalizationErrorInMono> {
+    let Some(_) = tcx.trait_of_assoc(requested_item) else { return Ok(None) };
+    if requested_args.has_non_region_param() || requested_args.has_non_region_infer() {
+        return Err(NormalizationErrorInMono);
+    }
+
+    let typing_env = ty::TypingEnv::fully_monomorphized();
+    let request = tcx
+        .erase_and_anonymize_regions(typing_env.as_query_input((requested_item, requested_args)));
+    associated_selection_from_request(tcx, request).map(Some)
+}
+
+fn associated_selection_from_request<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    request: ty::PseudoCanonicalInput<'tcx, (DefId, GenericArgsRef<'tcx>)>,
+) -> Result<AssociatedSelectionKeys<'tcx>, NormalizationErrorInMono> {
+    let (requested_item, requested_args) = request.value;
+    if request.typing_env != ty::TypingEnv::fully_monomorphized()
+        || tcx.def_kind(requested_item) != DefKind::AssocFn
+        || requested_args.has_non_region_param()
+        || requested_args.has_non_region_infer()
+    {
+        return Err(NormalizationErrorInMono);
+    }
+    let trait_id = tcx.trait_of_assoc(requested_item).ok_or(NormalizationErrorInMono)?;
+    let typing_env = request.typing_env;
+    let raw_instance = tcx
+        .resolve_instance_raw(request)
+        .map_err(|_| NormalizationErrorInMono)?
+        .ok_or(NormalizationErrorInMono)?;
+    let receiver_args = tcx
+        .try_normalize_erasing_regions(typing_env, Unnormalized::new_wip(requested_args))
+        .map_err(|_| NormalizationErrorInMono)?;
+    let trait_ref = ty::TraitRef::from_assoc(tcx, trait_id, receiver_args);
+    let selection_key = normalized_selection_key(tcx, trait_ref)?;
+    Ok(AssociatedSelectionKeys { request, selection_key, raw_instance })
+}
+
+fn record_trait_selection_proof<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    trait_ref: ty::TraitRef<'tcx>,
+    from: TraceFrom<'tcx>,
+    cause: MonoUseCause,
+    site: MonoTraceSite,
+    output: &mut MonoItems<'tcx>,
+) {
+    if !output.traces_observations() {
+        return;
+    }
+    let Ok(proof_key) = normalized_selection_key(tcx, trait_ref) else {
+        output.fail_observation();
+        return;
+    };
+    output.record_proof_use(from, MonoProof::TraitSelection { proof_key }, cause, site);
+}
+
+fn record_dyn_predicate_proofs<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    predicates: &'tcx ty::List<ty::PolyExistentialPredicate<'tcx>>,
+    concrete_ty: Ty<'tcx>,
+    from: TraceFrom<'tcx>,
+    cause: MonoUseCause,
+    site: MonoTraceSite,
+    output: &mut MonoItems<'tcx>,
+) {
+    if !output.traces_observations() {
+        return;
+    }
+
+    for predicate in predicates {
+        match predicate.skip_binder() {
+            ty::ExistentialPredicate::Trait(_) => {
+                let trait_ref = predicate.map_bound(|predicate| match predicate {
+                    ty::ExistentialPredicate::Trait(trait_ref) => trait_ref,
+                    _ => unreachable!(),
+                });
+                let trait_ref = tcx.instantiate_bound_regions_with_erased(
+                    trait_ref.with_self_ty(tcx, concrete_ty),
+                );
+                record_trait_selection_proof(tcx, trait_ref, from, cause, site, output);
+            }
+            ty::ExistentialPredicate::Projection(_) => {
+                let projection = predicate.map_bound(|predicate| match predicate {
+                    ty::ExistentialPredicate::Projection(projection) => projection,
+                    _ => unreachable!(),
+                });
+                let projection = tcx.instantiate_bound_regions_with_erased(
+                    projection.with_self_ty(tcx, concrete_ty),
+                );
+                if !matches!(
+                    projection.projection_term.kind,
+                    ty::AliasTermKind::ProjectionTy { .. }
+                ) || projection.projection_term.args.type_at(0) != concrete_ty
+                    || projection.projection_term.args.has_non_region_param()
+                    || projection.projection_term.args.has_non_region_infer()
+                    || projection.term.has_non_region_param()
+                    || projection.term.has_non_region_infer()
+                {
+                    output.fail_observation();
+                    continue;
+                }
+                let typing_env = ty::TypingEnv::fully_monomorphized();
+                let proof_key = tcx.erase_and_anonymize_regions(
+                    typing_env.as_query_input(projection.projection_term),
+                );
+                let expected = tcx.erase_and_anonymize_regions(projection.term);
+                output.record_proof_use(
+                    from,
+                    MonoProof::Projection { proof_key, expected },
+                    cause,
+                    site,
+                );
+            }
+            ty::ExistentialPredicate::AutoTrait(def_id) => {
+                let trait_ref = ty::TraitRef::new(tcx, def_id, [concrete_ty]);
+                record_trait_selection_proof(tcx, trait_ref, from, cause, site, output);
+            }
+        }
+    }
 }
 
