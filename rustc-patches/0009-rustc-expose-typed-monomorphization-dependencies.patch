+/// A mono item whose successors can be collected independently of the crate root set.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub enum MonoTraceRoot<'tcx> {
+    Fn(Instance<'tcx>),
+    Static { def_id: DefId, trigger_span: Span },
+}
+
+/// A node retained by the typed monomorphization observer.
+///
+/// `Allocation` is session-local here. Consumers must convert it to an owned, content-based
+/// identity before leaving the compiler session.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub enum MonoTraceNode<'tcx> {
+    Item(MonoItem<'tcx>),
+    Allocation(AllocId),
+    VTable { concrete_ty: Ty<'tcx>, trait_ref: Option<TraitRef<'tcx>> },
+}
+
+/// Why one trace node requires another. This is deliberately independent of the target's
+/// [`InstanceKind`]: a direct call may, for example, resolve to a function-pointer shim.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub enum MonoUseCause {
+    DirectCall,
+    FunctionPointer,
+    ClosureFunctionPointer,
+    InlineAsmSymbol,
+    StaticReference,
+    ThreadLocalReference,
+    DropGlue,
+    VTableConstruction,
+    VTableMethod,
+    VTableDrop,
+    SupertraitVTable,
+    ConstAllocation,
+    AllocationReference,
+    ThreadLocalShim,
+    CompilerRequirement,
+}
+
+/// Which stock collection bucket discovered an edge.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub enum MonoTraceCollection {
+    Used,
+    Mentioned,
+}
+
+/// Location evidence for an observed edge.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub enum MonoTraceSite {
+    Source(Span),
+    AllocationOffset(u64),
+    VTableSlot(u64),
+    CompilerGenerated,
+}
+
+/// One typed edge, recorded before stock target deduplication.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub struct MonoUseFact<'tcx> {
+    pub from: MonoTraceNode<'tcx>,
+    pub to: MonoTraceNode<'tcx>,
+    pub cause: MonoUseCause,
+    pub collection: MonoTraceCollection,
+    pub site: MonoTraceSite,
+}
+
+/// A required trait-associated constant retained by a concrete mono owner.
+///
+/// The proof query key is kept instead of copying the associated-item proof into this value.
+/// Consumers can use it to obtain the selected impl, final associated-const instance, and the
+/// trait-selection proof key from `codegen_associated_item_proof`.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub struct MonoAssociatedConstUse<'tcx> {
+    pub owner: MonoTraceNode<'tcx>,
+    pub proof_key: ty::PseudoCanonicalInput<'tcx, (DefId, ty::GenericArgsRef<'tcx>)>,
+    pub site: MonoTraceSite,
+}
+
+/// A compiler proof referenced by a monomorphization use.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub struct MonoProofUse<'tcx> {
+    pub from: MonoTraceNode<'tcx>,
+    pub proof: MonoProof<'tcx>,
+    pub cause: MonoUseCause,
+    pub collection: MonoTraceCollection,
+    pub site: MonoTraceSite,
+}
+
+/// The proof query input and exact result needed to validate a monomorphization use.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Hash, StableHash)]
+pub enum MonoProof<'tcx> {
+    TraitSelection {
+        proof_key: ty::PseudoCanonicalInput<'tcx, TraitRef<'tcx>>,
+    },
+    AssociatedItem {
+        selection_key: ty::PseudoCanonicalInput<'tcx, TraitRef<'tcx>>,
+        request: ty::PseudoCanonicalInput<'tcx, (DefId, ty::GenericArgsRef<'tcx>)>,
+        raw_instance: Instance<'tcx>,
+        codegen_instance: Instance<'tcx>,
+    },
+    Projection {
+        proof_key: ty::PseudoCanonicalInput<'tcx, ty::AliasTerm<'tcx>>,
+        expected: ty::Term<'tcx>,
+    },
+}
+
+/// Query-owned successors and their lossless typed provenance.
+#[derive(Clone, Debug, PartialEq, StableHash)]
+pub struct MonoSuccessors<'tcx> {
+    /// These two vectors are the exact stock transitions after target deduplication.
+    pub used: &'tcx [rustc_span::Spanned<MonoItem<'tcx>>],
+    pub mentioned: &'tcx [rustc_span::Spanned<MonoItem<'tcx>>],
+    /// Unlike `used` and `mentioned`, this vector retains repeated source sites.
+    pub facts: &'tcx [MonoUseFact<'tcx>],
+    /// Required associated constants from the owner body, independent of endpoint collection mode,
+    /// including uses removed from optimized MIR. Identical owner/key/site repetitions are
+    /// represented once; different source sites remain distinct.
+    pub associated_consts: &'tcx [MonoAssociatedConstUse<'tcx>],
+    /// Compiler proofs from used-item collection followed by mentioned-item collection. Within
+    /// each collection, semantic encounter, predicate, and vtable slot order is retained.
+    pub proof_uses: &'tcx [MonoProofUse<'tcx>],
+}
