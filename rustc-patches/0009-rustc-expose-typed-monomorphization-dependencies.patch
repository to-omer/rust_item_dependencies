+fn proof_inventory<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    successors: &MonoSuccessors<'tcx>,
+    collection: MonoTraceCollection,
+) -> Vec<String> {
+    successors
+        .proof_uses
+        .iter()
+        .filter(|use_| use_.collection == collection)
+        .map(|use_| {
+            let proof = match use_.proof {
+                MonoProof::TraitSelection { proof_key } => {
+                    format!("trait:{}", tcx.item_name(proof_key.value.def_id))
+                }
+                MonoProof::AssociatedItem { request, .. } => {
+                    format!("associated:{}", tcx.item_name(request.value.0))
+                }
+                MonoProof::Projection { proof_key, .. } => {
+                    let rustc_middle::ty::AliasTermKind::ProjectionTy { def_id } =
+                        proof_key.value.kind
+                    else {
+                        unreachable!()
+                    };
+                    format!("projection:{}", tcx.item_name(def_id))
+                }
+            };
+            let from = match use_.from {
+                MonoTraceNode::Item(MonoItem::Fn(instance)) => {
+                    format!("fn:{}", tcx.item_name(instance.def_id()))
+                }
+                MonoTraceNode::Item(MonoItem::Static(def_id)) => {
+                    format!("static:{}", tcx.item_name(def_id))
+                }
+                MonoTraceNode::Item(MonoItem::GlobalAsm(item_id)) => {
+                    format!("global_asm:{item_id:?}")
+                }
+                MonoTraceNode::Allocation(_) => "allocation".to_owned(),
+                MonoTraceNode::VTable { trait_ref: Some(trait_ref), .. } => {
+                    format!("vtable:{}", tcx.item_name(trait_ref.def_id))
+                }
+                MonoTraceNode::VTable { trait_ref: None, .. } => "vtable:none".to_owned(),
+            };
+            let site = match use_.site {
+                MonoTraceSite::Source(span) => {
+                    let lo = tcx.sess.source_map().lookup_char_pos(span.lo());
+                    format!("source:{}:{}", lo.line, lo.col.0)
+                }
+                MonoTraceSite::AllocationOffset(offset) => format!("allocation:{offset}"),
+                MonoTraceSite::VTableSlot(slot) => format!("slot:{slot}"),
+                MonoTraceSite::CompilerGenerated => "compiler".to_owned(),
+            };
+            format!("{proof}|{from}|{:?}|{:?}|{site}", use_.cause, use_.collection)
+        })
+        .collect()
+}
+
+fn assert_proof_contract<'tcx>(tcx: TyCtxt<'tcx>, successors: &MonoSuccessors<'tcx>) {
+    for use_ in successors.proof_uses {
+        assert!(!matches!(use_.site, MonoTraceSite::Source(span) if span.is_dummy()));
+        match use_.proof {
+            MonoProof::TraitSelection { proof_key } => {
+                assert!(matches!(
+                    use_.cause,
+                    MonoUseCause::VTableConstruction | MonoUseCause::SupertraitVTable
+                ));
+                if use_.cause == MonoUseCause::SupertraitVTable {
+                    assert!(matches!(use_.from, MonoTraceNode::VTable { .. }));
+                    assert!(matches!(use_.site, MonoTraceSite::VTableSlot(_)));
+                }
+                tcx.codegen_selection_proof(proof_key).unwrap();
+            }
+            MonoProof::AssociatedItem {
+                selection_key,
+                request,
+                raw_instance,
+                codegen_instance,
+            } => {
+                assert_eq!(tcx.def_kind(request.value.0), DefKind::AssocFn);
+                let trait_id = tcx.trait_of_assoc(request.value.0).unwrap();
+                let receiver_args = tcx.normalize_erasing_regions(
+                    request.typing_env,
+                    rustc_middle::ty::Unnormalized::new_wip(request.value.1),
+                );
+                assert_eq!(
+                    selection_key,
+                    request.typing_env.as_query_input(rustc_middle::ty::TraitRef::from_assoc(
+                        tcx,
+                        trait_id,
+                        receiver_args,
+                    ))
+                );
+                assert_eq!(
+                    tcx.resolve_instance_raw(request).unwrap().unwrap(),
+                    raw_instance
+                );
+                let selection = tcx.codegen_selection_proof(selection_key).unwrap();
+                match &selection.top_source {
+                    ImplSource::UserDefined(_) => {
+                        let proof = tcx.codegen_associated_item_proof(request).unwrap();
+                        assert_eq!(proof.selection_key, selection_key);
+                        assert_eq!(proof.source, selection.top_source);
+                        assert_eq!(proof.final_instance, raw_instance);
+                    }
+                    ImplSource::Builtin(..) | ImplSource::Param(_) => {
+                        assert!(tcx.codegen_associated_item_proof(request).is_err());
+                    }
+                }
+
+                match use_.cause {
+                    MonoUseCause::DirectCall => assert_eq!(codegen_instance, raw_instance),
+                    MonoUseCause::FunctionPointer | MonoUseCause::InlineAsmSymbol => {
+                        let expected = if use_.collection == MonoTraceCollection::Used {
+                            Instance::resolve_for_fn_ptr(
+                                tcx,
+                                request.typing_env,
+                                request.value.0,
+                                request.value.1,
+                            )
+                            .unwrap()
+                        } else {
+                            raw_instance
+                        };
+                        assert_eq!(codegen_instance, expected);
+                    }
+                    MonoUseCause::VTableMethod => {
+                        let MonoTraceNode::VTable { trait_ref: Some(trait_ref), .. } = use_.from
+                        else {
+                            panic!("vtable method proof lacked its vtable owner")
+                        };
+                        let MonoTraceSite::VTableSlot(slot) = use_.site else {
+                            panic!("vtable method proof lacked its slot")
+                        };
+                        let witness = tcx
+                            .codegen_vtable_method_witnesses(trait_ref)
+                            .unwrap()
+                            .iter()
+                            .find(|witness| witness.slot == slot)
+                            .unwrap();
+                        assert_eq!(witness.request, request);
+                        assert_eq!(witness.codegen_instance, codegen_instance);
+                    }
+                    _ => panic!("associated item proof had an unrelated cause"),
+                }
+            }
+            MonoProof::Projection { proof_key, expected } => {
+                assert_eq!(use_.cause, MonoUseCause::VTableConstruction);
+                assert!(matches!(
+                    proof_key.value.kind,
+                    rustc_middle::ty::AliasTermKind::ProjectionTy { .. }
+                ));
+                assert!(!proof_key.value.args.type_at(0).has_non_region_param());
+                let proof = tcx.codegen_projection_proof(proof_key).unwrap();
+                assert_eq!(proof.normalized_term, expected);
+            }
+        }
+    }
+}
+
+fn check_associated_const_uses<'tcx>(tcx: TyCtxt<'tcx>) {
+    let pick = named_def(tcx, "Pick", DefKind::Trait);
+    let pick_const = associated_item(tcx, pick, "N");
+    let source = named_def(tcx, "Source", DefKind::Struct);
+    let defaulted = named_def(tcx, "Defaulted", DefKind::Struct);
+    let overridden = named_def(tcx, "Overridden", DefKind::Struct);
+    let defaulted_impl = impl_for_adt(tcx, pick, defaulted);
+    let overridden_impl = impl_for_adt(tcx, pick, overridden);
+    let overridden_const = tcx.impl_item_implementor_ids(overridden_impl)[&pick_const];
+    let routed_trait = named_def(tcx, "Routed", DefKind::Trait);
+    let routed_const = associated_item(tcx, routed_trait, "N");
+    let routed_default = named_def(tcx, "RoutedDefault", DefKind::Struct);
+    let routed_override = named_def(tcx, "RoutedOverride", DefKind::Struct);
+    let routed_default_impl = impl_for_adt(tcx, routed_trait, routed_default);
+    let routed_override_impl = impl_for_adt(tcx, routed_trait, routed_override);
+    let routed_override_const =
+        tcx.impl_item_implementor_ids(routed_override_impl)[&routed_const];
+
+    let source_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(source),
+        rustc_middle::ty::GenericArgs::empty(),
+    );
+    let defaulted_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(defaulted),
+        tcx.mk_args(&[source_ty.into()]),
+    );
+    let overridden_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(overridden),
+        tcx.mk_args(&[source_ty.into()]),
+    );
+    let routed_default_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(routed_default),
+        tcx.mk_args(&[source_ty.into()]),
+    );
+    let routed_override_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(routed_override),
+        tcx.mk_args(&[source_ty.into()]),
+    );
+
+    let entry = Instance::mono(tcx, tcx.entry_fn(()).unwrap().0);
+    let entry_successors = query(
+        tcx,
+        Spanned { node: MonoItem::Fn(entry), span: tcx.def_span(entry.def_id()) },
+    );
+    let generic_default = exactly_one_instance(
+        tcx,
+        entry_successors.used,
+        "generic",
+        Some(defaulted_ty),
+    );
+    let generic_override = exactly_one_instance(
+        tcx,
+        entry_successors.used,
+        "generic",
+        Some(overridden_ty),
+    );
+    let direct = exactly_one_instance(tcx, entry_successors.used, "direct", None);
+    let repeated = exactly_one_instance(tcx, entry_successors.used, "repeated", None);
+    let routed = exactly_one_instance(tcx, entry_successors.used, "routed", None);
+
+    assert_associated_const_use(
+        tcx,
+        query(
+            tcx,
+            Spanned {
+                node: MonoItem::Fn(generic_default),
+                span: tcx.def_span(generic_default.def_id()),
+            },
+        ),
+        MonoTraceNode::Item(MonoItem::Fn(generic_default)),
+        "<T as Pick>::N",
+        pick,
+        pick_const,
+        tcx.mk_args(&[defaulted_ty.into()]),
+        defaulted_impl,
+        Instance::new_raw(pick_const, tcx.mk_args(&[defaulted_ty.into()])),
+    );
+    assert_associated_const_use(
+        tcx,
+        query(
+            tcx,
+            Spanned {
+                node: MonoItem::Fn(generic_override),
+                span: tcx.def_span(generic_override.def_id()),
+            },
+        ),
+        MonoTraceNode::Item(MonoItem::Fn(generic_override)),
+        "<T as Pick>::N",
+        pick,
+        pick_const,
+        tcx.mk_args(&[overridden_ty.into()]),
+        overridden_impl,
+        Instance::new_raw(overridden_const, tcx.mk_args(&[source_ty.into()])),
+    );
+
+    let direct_successors = query(
+        tcx,
+        Spanned { node: MonoItem::Fn(direct), span: tcx.def_span(direct.def_id()) },
+    );
+    assert!(direct_successors.used.is_empty());
+    assert!(direct_successors.mentioned.is_empty());
+    assert!(direct_successors.facts.is_empty());
+    assert_associated_const_use(
+        tcx,
+        direct_successors,
+        MonoTraceNode::Item(MonoItem::Fn(direct)),
+        "<Defaulted<Source> as Pick>::N",
+        pick,
+        pick_const,
+        tcx.mk_args(&[defaulted_ty.into()]),
+        defaulted_impl,
+        Instance::new_raw(pick_const, tcx.mk_args(&[defaulted_ty.into()])),
+    );
+    assert!(tcx.instance_mir(direct.def).basic_blocks.iter().any(|block| {
+        block.statements.iter().any(|statement| match &statement.kind {
+            mir::StatementKind::Assign(assign) => matches!(
+                &assign.1,
+                mir::Rvalue::Use(mir::Operand::Constant(constant), _)
+                    if matches!(constant.const_, mir::Const::Val(..))
+            ),
+            _ => false,
+        })
+    }));
+
+    let repeated_used = tcx
+        .mono_successors((MonoTraceRoot::Fn(repeated), CollectionMode::UsedItems))
+        .unwrap();
+    let repeated_mentioned = tcx
+        .mono_successors((MonoTraceRoot::Fn(repeated), CollectionMode::MentionedItems))
+        .unwrap();
+    assert_no_dummy_source(repeated_used);
+    assert_no_dummy_source(repeated_mentioned);
+    assert!(repeated_used.used.is_empty());
+    assert!(repeated_used.mentioned.is_empty());
+    assert!(repeated_used.facts.is_empty());
+    assert!(repeated_mentioned.used.is_empty());
+    assert!(repeated_mentioned.mentioned.is_empty());
+    assert!(repeated_mentioned.facts.is_empty());
+    assert_eq!(repeated_used.associated_consts, repeated_mentioned.associated_consts);
+    let [first, second]: &[MonoAssociatedConstUse<'tcx>] = repeated_used.associated_consts else {
+        panic!(
+            "expected two associated-const uses, got {:?}",
+            repeated_used.associated_consts
+        )
+    };
+    let expected_key = rustc_middle::ty::TypingEnv::fully_monomorphized()
+        .as_query_input((pick_const, tcx.mk_args(&[defaulted_ty.into()])));
+    for use_fact in [first, second] {
+        assert_eq!(use_fact.owner, MonoTraceNode::Item(MonoItem::Fn(repeated)));
+        assert_eq!(use_fact.proof_key, expected_key);
+    }
+    let [MonoTraceSite::Source(first_span), MonoTraceSite::Source(second_span)] =
+        [first.site, second.site]
+    else {
+        panic!("repeated associated-const uses lacked source sites")
+    };
+    assert!(first_span.lo() < second_span.lo());
+    for span in [first_span, second_span] {
+        assert_eq!(
+            tcx.sess.source_map().span_to_snippet(span).unwrap(),
+            "<Defaulted<Source> as Pick>::N"
+        );
+    }
+
+    let promoted_value = local_static(tcx, "PROMOTED_VALUE");
+    let promoted_instance = Instance::mono(tcx, promoted_value);
+    let promoted_body = tcx.instance_mir(promoted_instance.def);
+    let [promoted_outer, promoted_wrapper] = promoted_body.required_consts() else {
+        panic!(
+            "expected the original const and its promoted wrapper, got {:?}",
+            promoted_body.required_consts()
+        )
+    };
+    let mir::Const::Unevaluated(promoted_outer_const, _) = promoted_outer.const_ else {
+        panic!("associated const retained by the outer body was already evaluated")
+    };
+    assert_eq!(promoted_outer_const.def, pick_const);
+    assert!(promoted_outer_const.promoted.is_none());
+    let mir::Const::Unevaluated(promoted_wrapper, _) = promoted_wrapper.const_ else {
+        panic!("promoted wrapper was already evaluated")
+    };
+    assert_eq!(promoted_wrapper.def, promoted_value);
+    let promoted_index = promoted_wrapper.promoted.expect("expected a promoted index");
+    let promoted_mir = &tcx.promoted_mir(promoted_wrapper.def)[promoted_index];
+    let [promoted_inner] = promoted_mir.required_consts() else {
+        panic!(
+            "expected one required const inside the promoted body, got {:?}",
+            promoted_mir.required_consts()
+        )
+    };
+    let mir::Const::Unevaluated(promoted_inner_const, _) = promoted_inner.const_ else {
+        panic!("associated const inside the promoted body was already evaluated")
+    };
+    assert_eq!(promoted_inner_const.def, pick_const);
+    assert!(promoted_inner_const.promoted.is_none());
+    assert_eq!(promoted_outer_const, promoted_inner_const);
+    assert_eq!(promoted_outer.span, promoted_inner.span);
+    assert_associated_const_use(
+        tcx,
+        tcx.mono_successors((
+            MonoTraceRoot::Static {
+                def_id: promoted_value,
+                trigger_span: tcx.def_span(promoted_value),
+            },
+            CollectionMode::UsedItems,
+        ))
+        .unwrap(),
+        MonoTraceNode::Item(MonoItem::Static(promoted_value)),
+        "<Defaulted<Source> as Pick>::N",
+        pick,
+        pick_const,
+        tcx.mk_args(&[defaulted_ty.into()]),
+        defaulted_impl,
+        Instance::new_raw(pick_const, tcx.mk_args(&[defaulted_ty.into()])),
+    );
+
+    let routed_successors = query(
+        tcx,
+        Spanned { node: MonoItem::Fn(routed), span: tcx.def_span(routed.def_id()) },
+    );
+    assert!(routed_successors.used.is_empty());
+    assert!(routed_successors.mentioned.is_empty());
+    assert!(routed_successors.facts.is_empty());
+    let [routed_default_fact, routed_override_fact]: &[MonoAssociatedConstUse<'tcx>] =
+        routed_successors.associated_consts
+    else {
+        panic!(
+            "expected two routed associated-const uses, got {:?}",
+            routed_successors.associated_consts
+        )
+    };
+    let three = rustc_middle::ty::Const::from_target_usize(tcx, 3);
+    let five = rustc_middle::ty::Const::from_target_usize(tcx, 5);
+    let routed_default_args =
+        tcx.mk_args(&[routed_default_ty.into(), tcx.types.u16.into(), three.into()]);
+    assert_associated_const_fact(
+        tcx,
+        routed_default_fact,
+        MonoTraceNode::Item(MonoItem::Fn(routed)),
+        "<RoutedDefault<Source> as Routed<u16, 3>>::N",
+        routed_trait,
+        routed_const,
+        routed_default_args,
+        routed_default_impl,
+        Instance::new_raw(routed_const, routed_default_args),
+    );
+    let routed_override_args =
+        tcx.mk_args(&[routed_override_ty.into(), tcx.types.u32.into(), five.into()]);
+    let routed_override_final_args =
+        tcx.mk_args(&[source_ty.into(), tcx.types.u32.into(), five.into()]);
+    assert_associated_const_fact(
+        tcx,
+        routed_override_fact,
+        MonoTraceNode::Item(MonoItem::Fn(routed)),
+        "<RoutedOverride<Source> as Routed<u32, 5>>::N",
+        routed_trait,
+        routed_const,
+        routed_override_args,
+        routed_override_impl,
+        Instance::new_raw(routed_override_const, routed_override_final_args),
+    );
+
+    let value = local_static(tcx, "VALUE");
+    let value_successors = tcx
+        .mono_successors((
+            MonoTraceRoot::Static { def_id: value, trigger_span: tcx.def_span(value) },
+            CollectionMode::UsedItems,
+        ))
+        .unwrap();
+    let value_mentioned_successors = tcx
+        .mono_successors((
+            MonoTraceRoot::Static { def_id: value, trigger_span: tcx.def_span(value) },
+            CollectionMode::MentionedItems,
+        ))
+        .unwrap();
+    assert_no_dummy_source(value_mentioned_successors);
+    assert!(value_successors.used.is_empty());
+    assert!(value_successors.mentioned.is_empty());
+    assert!(value_successors.facts.is_empty());
+    assert!(value_mentioned_successors.used.is_empty());
+    assert!(value_mentioned_successors.mentioned.is_empty());
+    assert!(value_mentioned_successors.facts.is_empty());
+    assert_eq!(
+        value_successors.associated_consts,
+        value_mentioned_successors.associated_consts
+    );
+    assert_associated_const_use(
+        tcx,
+        value_successors,
+        MonoTraceNode::Item(MonoItem::Static(value)),
+        "<Overridden<Source> as Pick>::N",
+        pick,
+        pick_const,
+        tcx.mk_args(&[overridden_ty.into()]),
+        overridden_impl,
+        Instance::new_raw(overridden_const, tcx.mk_args(&[source_ty.into()])),
+    );
+}
