@@ -0,0 +1,1757 @@
+//@ edition: 2021
+//@ run-pass
+//@ run-flags: {{sysroot-base}}
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_session;
+extern crate rustc_span;
+
+use std::path::PathBuf;
+
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::DefId;
+use rustc_interface::interface;
+use rustc_middle::mir;
+use rustc_middle::mono::{
+    CollectionMode, MonoAssociatedConstUse, MonoItem, MonoProof, MonoSuccessors,
+    MonoTraceCollection, MonoTraceNode, MonoTraceRoot, MonoTraceSite, MonoUseCause,
+};
+use rustc_middle::traits::ImplSource;
+use rustc_middle::ty::{Instance, InstanceKind, ShimKind, TyCtxt, TypeVisitableExt};
+use rustc_session::config::{Input, OptLevel, Options, Sysroot};
+use rustc_span::{DUMMY_SP, FileName, Span, Spanned, sym};
+
+const INPUT: &str = r#"
+#![allow(dead_code)]
+
+#[inline(never)]
+fn direct<T>() {
+    std::hint::black_box(std::mem::size_of::<T>());
+}
+
+fn from_const() {}
+fn dead_call() {}
+fn dead_reified() {}
+
+const TABLE: [fn(); 1] = [from_const];
+
+fn static_a() {}
+fn static_b() {}
+fn static_dead() {}
+
+#[used]
+static KEEP: [fn(); 2] = [static_a, static_b];
+static DEAD_STATIC: [fn(); 1] = [static_dead];
+
+trait Tr {
+    fn a(&self);
+    fn b(&self);
+}
+
+struct D;
+
+impl Drop for D {
+    fn drop(&mut self) {}
+}
+
+impl Tr for D {
+    #[inline(never)]
+    fn a(&self) {}
+
+    #[inline(never)]
+    fn b(&self) {}
+}
+
+static CONST_D: D = D;
+const CONST_DYN: &dyn Tr = &CONST_D;
+
+#[inline(never)]
+fn inline_asm_reference() {
+    unsafe {
+        std::arch::asm!(
+            "/* {function_symbol} {static_symbol} */",
+            function_symbol = sym static_a,
+            static_symbol = sym CONST_D,
+        );
+    }
+}
+
+#[inline(never)]
+fn make_vtable_and_drops() {
+    {
+        let first = D;
+        let object: &dyn Tr = &first;
+        object.a();
+    }
+    {
+        let _second = D;
+    }
+}
+
+fn main() {
+    direct::<u8>();
+    direct::<u8>();
+    direct::<u16>();
+    std::hint::black_box(TABLE);
+    std::hint::black_box(CONST_DYN);
+    inline_asm_reference();
+    make_vtable_and_drops();
+    if false {
+        dead_call();
+        let pointer: fn() = dead_reified;
+        std::hint::black_box(pointer);
+    }
+}
+"#;
+
+const INLINE_INPUT: &str = r#"
+#![allow(dead_code)]
+
+#[inline(always)]
+fn target() {}
+
+fn main() {
+    let pointer: fn() = target;
+    std::hint::black_box(pointer);
+    target();
+}
+"#;
+
+const ASSOCIATED_CONST_INPUT: &str = r#"
+#![allow(dead_code)]
+
+trait Header {
+    type Key;
+}
+
+struct Source;
+
+impl Header for Source {
+    type Key = u8;
+}
+
+trait Pick {
+    const N: usize = 11;
+}
+
+trait Routed<A, const K: usize> {
+    const N: usize = K;
+}
+
+struct Defaulted<T>(T);
+
+impl<T: Header<Key = u8>> Pick for Defaulted<T> {}
+
+struct Overridden<T>(T);
+
+impl<T: Header<Key = u8>> Pick for Overridden<T> {
+    const N: usize = nested::<5>();
+}
+
+struct RoutedDefault<T>(T);
+
+impl<T: Header<Key = u8>, A, const K: usize> Routed<A, K> for RoutedDefault<T> {}
+
+struct RoutedOverride<T>(T);
+
+impl<T: Header<Key = u8>, A, const K: usize> Routed<A, K> for RoutedOverride<T> {
+    const N: usize = K + 1;
+}
+
+const fn nested<const X: usize>() -> usize {
+    X + 2
+}
+
+const fn identity(value: usize) -> usize {
+    value
+}
+
+#[inline(never)]
+fn generic<T: Pick>() -> usize {
+    <T as Pick>::N
+}
+
+#[inline(never)]
+fn direct() -> usize {
+    <Defaulted<Source> as Pick>::N
+}
+
+#[inline(never)]
+fn repeated() -> usize {
+    let first = <Defaulted<Source> as Pick>::N;
+    let second = <Defaulted<Source> as Pick>::N;
+    first + second
+}
+
+#[inline(never)]
+fn routed() -> usize {
+    <RoutedDefault<Source> as Routed<u16, 3>>::N
+        + <RoutedOverride<Source> as Routed<u32, 5>>::N
+}
+
+static VALUE: usize = <Overridden<Source> as Pick>::N;
+static PROMOTED_VALUE: &usize = &identity(<Defaulted<Source> as Pick>::N);
+
+fn main() {
+    std::hint::black_box(generic::<Defaulted<Source>>());
+    std::hint::black_box(generic::<Overridden<Source>>());
+    std::hint::black_box(direct());
+    std::hint::black_box(repeated());
+    std::hint::black_box(routed());
+    std::hint::black_box(VALUE);
+    std::hint::black_box(PROMOTED_VALUE);
+}
+"#;
+
+const PROOF_INPUT: &str = r#"
+#![allow(dead_code)]
+
+trait Missing {}
+
+trait Super {
+    fn defaulted(&self) -> u8 { 1 }
+}
+
+trait Other {
+    fn other(&self) -> u8 { 2 }
+}
+
+trait Marker {}
+
+trait ObjectTrait: Super + Other + Marker {
+    type Assoc;
+
+    fn overridden(&self) -> u8 { 3 }
+
+    fn tracked(&self) -> u8 { 5 }
+
+    fn vacant(&self) where Self::Assoc: Missing {}
+}
+
+struct Concrete;
+
+impl Super for Concrete {}
+impl Other for Concrete {}
+impl Marker for Concrete {}
+impl ObjectTrait for Concrete {
+    type Assoc = u8;
+
+    fn overridden(&self) -> u8 { 4 }
+
+    #[track_caller]
+    fn tracked(&self) -> u8 { 6 }
+}
+
+trait Dispatch<A> {
+    #[track_caller]
+    fn invoke<const K: usize>(&self) -> usize {
+        std::mem::size_of::<A>() + K
+    }
+}
+
+struct DefaultDispatch;
+impl Dispatch<u16> for DefaultDispatch {}
+
+struct OverrideDispatch;
+impl Dispatch<u32> for OverrideDispatch {
+    #[track_caller]
+    fn invoke<const K: usize>(&self) -> usize {
+        std::mem::size_of::<u32>() + K + 1
+    }
+}
+
+struct NeedsDrop;
+impl Drop for NeedsDrop {
+    fn drop(&mut self) {}
+}
+
+#[inline(never)]
+fn proof_entry() {
+    let default = DefaultDispatch;
+    std::hint::black_box(Dispatch::<u16>::invoke::<3>(&default));
+    std::hint::black_box(Dispatch::<u16>::invoke::<3>(&default));
+
+    let override_ = OverrideDispatch;
+    std::hint::black_box(Dispatch::<u32>::invoke::<5>(&override_));
+
+    let pointer: fn(&DefaultDispatch) -> usize =
+        <DefaultDispatch as Dispatch<u16>>::invoke::<3>;
+    std::hint::black_box(pointer);
+
+    let tuple = (1u8,);
+    std::hint::black_box(Clone::clone(&tuple));
+
+    let concrete = Concrete;
+    let object: &(dyn ObjectTrait<Assoc = u8> + Send) = &concrete;
+    std::hint::black_box(object.overridden());
+    std::hint::black_box(object.tracked());
+    std::hint::black_box(object.defaulted());
+}
+
+#[inline(never)]
+fn only_drop() {
+    let _value = NeedsDrop;
+}
+
+fn main() {
+    proof_entry();
+    only_drop();
+}
+"#;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    assert!(args.len() >= 2, "expected the stage sysroot");
+
+    let sysroot = PathBuf::from(&args[1]);
+    run_input(INPUT, sysroot.clone(), false, false, check_observer);
+    run_input(INLINE_INPUT, sysroot.clone(), true, false, check_inline_reason);
+    run_input(
+        ASSOCIATED_CONST_INPUT,
+        sysroot.clone(),
+        false,
+        true,
+        check_associated_const_uses,
+    );
+    run_input(PROOF_INPUT, sysroot, false, false, check_proof_uses);
+}
+
+fn run_input<F>(
+    input_text: &str,
+    sysroot: PathBuf,
+    inline_mir: bool,
+    optimize: bool,
+    check: F,
+)
+where
+    F: for<'tcx> FnOnce(TyCtxt<'tcx>) + Send,
+{
+    let mut opts = Options::default();
+    opts.sysroot = Sysroot::new(Some(sysroot));
+    opts.unstable_opts.inline_mir = Some(inline_mir);
+    if optimize {
+        opts.optimize = OptLevel::Aggressive;
+    }
+
+    let input = Input::Str {
+        name: FileName::anon_source_code(input_text),
+        input: input_text.to_owned(),
+    };
+    let config = interface::Config {
+        opts,
+        crate_cfg: Default::default(),
+        crate_check_cfg: Default::default(),
+        input,
+        output_file: None,
+        output_dir: None,
+        ice_file: None,
+        file_loader: None,
+        lint_caps: Default::default(),
+        psess_created: None,
+        track_state: None,
+        register_lints: None,
+        override_queries: None,
+        extra_symbols: Vec::new(),
+        make_codegen_backend: None,
+        using_internal_features: &rustc_driver::USING_INTERNAL_FEATURES,
+        external_resource_guard: None,
+    };
+
+    interface::run_compiler(config, |compiler| {
+        let krate = rustc_interface::passes::parse(&compiler.sess);
+        rustc_interface::create_and_enter_global_ctxt(&compiler, krate, |tcx| {
+            let _ = tcx.analysis(());
+            tcx.sess.dcx().abort_if_errors();
+            check(tcx);
+        });
+    });
+}
+
+fn check_observer<'tcx>(tcx: TyCtxt<'tcx>) {
+    let entry = Instance::mono(tcx, tcx.entry_fn(()).unwrap().0);
+    let entry_item = MonoItem::Fn(entry);
+    let entry_span = tcx.def_span(entry.def_id());
+    let successors = query(tcx, Spanned { node: entry_item, span: entry_span });
+
+    // Query memory-cache hits must return the complete value, not rely on a side recorder.
+    let again = query(tcx, Spanned { node: entry_item, span: entry_span });
+    assert_eq!(successors, again);
+
+    // The legacy query is exactly the endpoint projection of the new query.
+    let (stock_used, stock_mentioned) =
+        tcx.items_of_instance((entry, CollectionMode::UsedItems)).unwrap();
+    assert_eq!(successors.used, stock_used);
+    assert_eq!(successors.mentioned, stock_mentioned);
+
+    let direct_u8 = exactly_one_instance(tcx, successors.used, "direct", Some(tcx.types.u8));
+    let direct_u16 = exactly_one_instance(tcx, successors.used, "direct", Some(tcx.types.u16));
+    assert_ne!(direct_u8, direct_u16);
+    assert_eq!(count_named(tcx, successors.used, "direct"), 2);
+    assert_eq!(count_named(tcx, successors.mentioned, "direct"), 0);
+
+    // The stock endpoint set deduplicates direct::<u8>, while facts retain both source calls.
+    let direct_u8_used_sites = source_sites_to_instance(
+        successors,
+        MonoTraceCollection::Used,
+        MonoUseCause::DirectCall,
+        direct_u8,
+    );
+    assert_eq!(direct_u8_used_sites.len(), 2);
+    assert_ne!(direct_u8_used_sites[0], direct_u8_used_sites[1]);
+    assert!(successors.facts.iter().filter(|fact| {
+        fact.collection == MonoTraceCollection::Used
+            && fact.cause == MonoUseCause::DirectCall
+            && fact.to == MonoTraceNode::Item(MonoItem::Fn(direct_u8))
+    }).all(|fact| fact.from == MonoTraceNode::Item(entry_item)));
+    assert_eq!(
+        source_sites_to_instance(
+            successors,
+            MonoTraceCollection::Used,
+            MonoUseCause::DirectCall,
+            direct_u16,
+        )
+        .len(),
+        1
+    );
+
+    // Used dominance suppresses both the redundant Mentioned endpoint and its trace fact.
+    assert_eq!(
+        source_sites_to_instance(
+            successors,
+            MonoTraceCollection::Mentioned,
+            MonoUseCause::DirectCall,
+            direct_u8,
+        )
+        .len(),
+        0
+    );
+    assert_eq!(count_named(tcx, successors.used, "dead_call"), 0);
+    assert_eq!(count_named(tcx, successors.mentioned, "dead_call"), 1);
+    let dead_reified = exactly_one_instance(tcx, successors.mentioned, "dead_reified", None);
+    assert!(successors.facts.iter().any(|fact| {
+        fact.collection == MonoTraceCollection::Mentioned
+            && fact.cause == MonoUseCause::FunctionPointer
+            && fact.from == MonoTraceNode::Item(entry_item)
+            && fact.to == MonoTraceNode::Item(MonoItem::Fn(dead_reified))
+            && matches!(fact.site, MonoTraceSite::Source(_))
+    }));
+
+    // The const allocation is reached through both Used and required-const/Mentioned collection.
+    let from_const = exactly_one_instance(tcx, successors.used, "from_const", None);
+    assert_eq!(count_named(tcx, successors.mentioned, "from_const"), 1);
+    for collection in [MonoTraceCollection::Used, MonoTraceCollection::Mentioned] {
+        assert!(successors.facts.iter().any(|fact| {
+            fact.collection == collection
+                && fact.cause == MonoUseCause::FunctionPointer
+                && matches!(fact.from, MonoTraceNode::Allocation(_))
+                && fact.to == MonoTraceNode::Item(MonoItem::Fn(from_const))
+                && fact.site == MonoTraceSite::CompilerGenerated
+        }));
+    }
+    assert_eq!(
+        proof_inventory(tcx, successors, MonoTraceCollection::Used),
+        [
+            "trait:Tr|allocation|VTableConstruction|Used|compiler",
+            "associated:a|vtable:Tr|VTableMethod|Used|slot:3",
+            "associated:b|vtable:Tr|VTableMethod|Used|slot:4",
+        ]
+    );
+    assert_eq!(
+        proof_inventory(tcx, successors, MonoTraceCollection::Mentioned),
+        [
+            "trait:Tr|allocation|VTableConstruction|Mentioned|compiler",
+            "associated:a|vtable:Tr|VTableMethod|Mentioned|slot:3",
+            "associated:b|vtable:Tr|VTableMethod|Mentioned|slot:4",
+        ]
+    );
+
+    // A trait object materialized by CTFE has no MIR unsize site. Its allocation still exposes
+    // typed vtable slots instead of only generic function-pointer allocation edges.
+    assert!(successors.facts.iter().any(|fact| {
+        fact.collection == MonoTraceCollection::Used
+            && fact.cause == MonoUseCause::VTableConstruction
+            && matches!(fact.from, MonoTraceNode::Allocation(_))
+            && matches!(fact.to, MonoTraceNode::VTable { .. })
+            && fact.site == MonoTraceSite::CompilerGenerated
