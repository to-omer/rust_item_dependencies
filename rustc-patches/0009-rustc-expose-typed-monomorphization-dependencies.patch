+
+fn normalized_selection_key<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    trait_ref: ty::TraitRef<'tcx>,
+) -> Result<ty::PseudoCanonicalInput<'tcx, ty::TraitRef<'tcx>>, NormalizationErrorInMono> {
+    let typing_env = ty::TypingEnv::fully_monomorphized();
+    let trait_ref = tcx
+        .try_normalize_erasing_regions(typing_env, Unnormalized::new_wip(trait_ref))
+        .map_err(|_| NormalizationErrorInMono)?;
+    if trait_ref.has_non_region_param() || trait_ref.has_non_region_infer() {
+        return Err(NormalizationErrorInMono);
+    }
+    Ok(typing_env.as_query_input(trait_ref))
+}
