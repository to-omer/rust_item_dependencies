+            }
+            let MonoTraceNode::VTable { .. } = fact.from else { return None };
+            let MonoTraceNode::Item(MonoItem::Fn(instance)) = fact.to else { return None };
+            let MonoTraceSite::VTableSlot(slot) = fact.site else { return None };
+            if named_instance(tcx, instance, "a") {
+                Some(("a", slot))
+            } else if named_instance(tcx, instance, "b") {
+                Some(("b", slot))
+            } else {
+                None
+            }
+        })
+        .collect();
+    const_vtable_slots.sort_unstable();
+    const_vtable_slots.dedup();
+    assert_eq!(const_vtable_slots, [("a", 3), ("b", 4)]);
+
+    let inline_asm = exactly_one_instance(tcx, successors.used, "inline_asm_reference", None);
+    let inline_asm_successors = query(
+        tcx,
+        Spanned { node: MonoItem::Fn(inline_asm), span: tcx.def_span(inline_asm.def_id()) },
+    );
+    assert!(inline_asm_successors.facts.iter().any(|fact| {
+        fact.collection == MonoTraceCollection::Used
+            && fact.cause == MonoUseCause::InlineAsmSymbol
+            && fact.from == MonoTraceNode::Item(MonoItem::Fn(inline_asm))
+            && matches!(fact.to, MonoTraceNode::Item(MonoItem::Fn(instance)) if named_instance(tcx, instance, "static_a"))
+            && matches!(fact.site, MonoTraceSite::Source(_))
+    }));
+
+    let const_d = local_static(tcx, "CONST_D");
+    assert!(inline_asm_successors.facts.iter().any(|fact| {
+        fact.collection == MonoTraceCollection::Used
+            && fact.cause == MonoUseCause::InlineAsmSymbol
+            && fact.from == MonoTraceNode::Item(MonoItem::Fn(inline_asm))
+            && fact.to == MonoTraceNode::Item(MonoItem::Static(const_d))
+            && matches!(fact.site, MonoTraceSite::Source(_))
+    }));
+
+    // The incoming static span is part of the query identity. The same static reached from two
+    // sites must retain the corresponding endpoint/fact span instead of aliasing in memory cache.
+    let const_d_span = tcx.def_span(const_d);
+    assert_ne!(const_d_span, entry_span);
+    let const_d_from_definition = tcx
+        .mono_successors((
+            MonoTraceRoot::Static { def_id: const_d, trigger_span: const_d_span },
+            CollectionMode::UsedItems,
+        ))
+        .unwrap();
+    let const_d_from_entry = tcx
+        .mono_successors((
+            MonoTraceRoot::Static { def_id: const_d, trigger_span: entry_span },
+            CollectionMode::UsedItems,
+        ))
+        .unwrap();
+    for (successors, expected_span) in
+        [(const_d_from_definition, const_d_span), (const_d_from_entry, entry_span)]
+    {
+        assert_no_dummy_source(successors);
+        let drop_items: Vec<_> = successors
+            .used
+            .iter()
+            .filter(|item| is_drop_glue(MonoTraceNode::Item(item.node)))
+            .collect();
+        assert_eq!(drop_items.len(), 1);
+        assert_eq!(drop_items[0].span, expected_span);
+        assert!(successors.facts.iter().any(|fact| {
+            fact.from == MonoTraceNode::Item(MonoItem::Static(const_d))
+                && fact.to == MonoTraceNode::Item(drop_items[0].node)
+                && fact.cause == MonoUseCause::DropGlue
+                && fact.site == MonoTraceSite::Source(expected_span)
+        }));
+    }
+    let const_d_from_generated = tcx
+        .mono_successors((
+            MonoTraceRoot::Static { def_id: const_d, trigger_span: DUMMY_SP },
+            CollectionMode::UsedItems,
+        ))
+        .unwrap();
+    assert_no_dummy_source(const_d_from_generated);
+    let generated_drop_items: Vec<_> = const_d_from_generated
+        .used
+        .iter()
+        .filter(|item| is_drop_glue(MonoTraceNode::Item(item.node)))
+        .collect();
+    assert_eq!(generated_drop_items.len(), 1);
+    assert_eq!(generated_drop_items[0].span, DUMMY_SP);
+    assert!(const_d_from_generated.facts.iter().any(|fact| {
+        fact.from == MonoTraceNode::Item(MonoItem::Static(const_d))
+            && fact.to == MonoTraceNode::Item(generated_drop_items[0].node)
+            && fact.cause == MonoUseCause::DropGlue
+            && fact.site == MonoTraceSite::CompilerGenerated
+    }));
+
+    let keep = local_static(tcx, "KEEP");
+    let keep_span = tcx.def_span(keep);
+    let keep_successors = tcx
+        .mono_successors((
+            MonoTraceRoot::Static { def_id: keep, trigger_span: keep_span },
+            CollectionMode::UsedItems,
+        ))
+        .unwrap();
+    assert_no_dummy_source(keep_successors);
+    exactly_one_instance(tcx, keep_successors.used, "static_a", None);
+    exactly_one_instance(tcx, keep_successors.used, "static_b", None);
+    let mut keep_offsets: Vec<u64> = keep_successors
+        .facts
+        .iter()
+        .filter_map(|fact| {
+            if fact.from == MonoTraceNode::Item(MonoItem::Static(keep))
+                && fact.collection == MonoTraceCollection::Used
+                && fact.cause == MonoUseCause::AllocationReference
+            {
+                Some(match fact.site {
+                    MonoTraceSite::AllocationOffset(offset) => offset,
+                    _ => panic!("static allocation edge lacked its actual offset"),
+                })
+            } else {
+                None
+            }
+        })
+        .collect();
+    keep_offsets.sort_unstable();
+    assert_eq!(keep_offsets, [0, tcx.data_layout.pointer_size().bytes()]);
+
+    let make = exactly_one_instance(tcx, successors.used, "make_vtable_and_drops", None);
+    let make_successors = query(
+        tcx,
+        Spanned { node: MonoItem::Fn(make), span: tcx.def_span(make.def_id()) },
+    );
+    let mut method_slots: Vec<(&str, u64)> = make_successors
+        .facts
+        .iter()
+        .filter_map(|fact| {
+            if fact.collection != MonoTraceCollection::Used
+                || fact.cause != MonoUseCause::VTableMethod
+            {
+                return None;
+            }
+            let MonoTraceNode::VTable { .. } = fact.from else { panic!("missing vtable owner") };
+            let MonoTraceNode::Item(MonoItem::Fn(instance)) = fact.to else {
+                panic!("vtable method did not target an instance")
+            };
+            let MonoTraceSite::VTableSlot(slot) = fact.site else {
+                panic!("vtable method did not retain its slot")
+            };
+            Some((if named_instance(tcx, instance, "a") { "a" } else if named_instance(tcx, instance, "b") { "b" } else { panic!("unexpected vtable method") }, slot))
+        })
+        .collect();
+    method_slots.sort_unstable();
+    assert_eq!(method_slots, [("a", 3), ("b", 4)]);
+
+    let vtable_drop = make_successors
+        .facts
+        .iter()
+        .filter(|fact| {
+            fact.collection == MonoTraceCollection::Used
+                && fact.cause == MonoUseCause::VTableDrop
+                && fact.site == MonoTraceSite::VTableSlot(0)
+                && is_drop_glue(fact.to)
+        })
+        .count();
+    assert_eq!(vtable_drop, 1);
+    let mut direct_drop_sites: Vec<Span> = make_successors
+        .facts
+        .iter()
+        .filter_map(|fact| {
+            if fact.collection == MonoTraceCollection::Used
+                && fact.from == MonoTraceNode::Item(MonoItem::Fn(make))
+                && fact.cause == MonoUseCause::DropGlue
+                && is_drop_glue(fact.to)
+            {
+                Some(match fact.site {
+                    MonoTraceSite::Source(span) => span,
+                    _ => panic!("MIR drop edge lacked a source span"),
+                })
+            } else {
+                None
+            }
+        })
+        .collect();
+    direct_drop_sites.sort_by_key(|span| (span.lo(), span.hi()));
+    direct_drop_sites.dedup();
+    assert_eq!(direct_drop_sites.len(), 2);
+
+    // A minimal main policy walks both Fn and Static through the same query. KEEP is a compiler
+    // root; the ordinary unreferenced static is intentionally not seeded.
+    let classes = walk(
+        tcx,
+        [
+            Spanned { node: entry_item, span: entry_span },
+            Spanned { node: MonoItem::Static(keep), span: keep_span },
+        ],
+    );
+    assert!(contains_instance(classes.used.as_slice(), direct_u8));
+    assert!(contains_instance(classes.used.as_slice(), direct_u16));
+    assert!(contains_named(tcx, classes.used.as_slice(), "static_a"));
+    assert!(contains_named(tcx, classes.used.as_slice(), "static_b"));
+    assert!(!contains_named(tcx, classes.used.as_slice(), "static_dead"));
+    assert!(contains_named(tcx, classes.used.as_slice(), "from_const"));
+    assert!(!contains_named(tcx, classes.mentioned.as_slice(), "from_const"));
+    assert!(contains_named(tcx, classes.mentioned.as_slice(), "dead_call"));
+}
+
+fn check_inline_reason<'tcx>(tcx: TyCtxt<'tcx>) {
+    let owner = Instance::mono(tcx, tcx.entry_fn(()).unwrap().0);
+    let target = local_function_instance(tcx, "target");
+    let successors = tcx
+        .mono_successors((MonoTraceRoot::Fn(owner), CollectionMode::MentionedItems))
+        .unwrap();
+    assert_no_dummy_source(successors);
+
+    // Stock inlining removes the first same-Ty mentioned entry. The prior reify mention is first,
+    // so the surviving pre-optimization reason is DirectCall even though that call was inlined.
+    assert_eq!(count_named(tcx, successors.mentioned, "target"), 1);
+    assert!(successors.facts.iter().any(|fact| {
+        fact.collection == MonoTraceCollection::Mentioned
+            && fact.from == MonoTraceNode::Item(MonoItem::Fn(owner))
+            && fact.to == MonoTraceNode::Item(MonoItem::Fn(target))
+            && fact.cause == MonoUseCause::DirectCall
+    }));
+    assert!(!successors.facts.iter().any(|fact| {
+        fact.to == MonoTraceNode::Item(MonoItem::Fn(target))
+            && fact.cause == MonoUseCause::FunctionPointer
+    }));
+}
+
+fn check_proof_uses<'tcx>(tcx: TyCtxt<'tcx>) {
+    let object_trait = named_def(tcx, "ObjectTrait", DefKind::Trait);
+    let concrete = named_def(tcx, "Concrete", DefKind::Struct);
+    let concrete_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(concrete),
+        rustc_middle::ty::GenericArgs::empty(),
+    );
+    let object_ref = rustc_middle::ty::TraitRef::new(tcx, object_trait, [concrete_ty]);
+    let cold_witnesses = tcx.codegen_vtable_method_witnesses(object_ref).unwrap();
+    let warm_witnesses = tcx.codegen_vtable_method_witnesses(object_ref).unwrap();
+    assert!(std::ptr::eq(cold_witnesses, warm_witnesses));
+
+    let owner = local_function_instance(tcx, "proof_entry");
+    let cold = tcx
+        .mono_successors((MonoTraceRoot::Fn(owner), CollectionMode::UsedItems))
+        .unwrap();
+    let warm = tcx
+        .mono_successors((MonoTraceRoot::Fn(owner), CollectionMode::UsedItems))
+        .unwrap();
+    assert!(std::ptr::eq(cold, warm));
+    let mentioned = tcx
+        .mono_successors((MonoTraceRoot::Fn(owner), CollectionMode::MentionedItems))
+        .unwrap();
+    assert_no_dummy_source(cold);
+    assert_no_dummy_source(mentioned);
+    assert_proof_contract(tcx, cold);
+    assert_proof_contract(tcx, mentioned);
+    assert_eq!(
+        proof_inventory(tcx, cold, MonoTraceCollection::Used),
+        [
+            "associated:invoke|fn:proof_entry|DirectCall|Used|source:66:25",
+            "associated:invoke|fn:proof_entry|DirectCall|Used|source:67:25",
+            "associated:invoke|fn:proof_entry|DirectCall|Used|source:70:25",
+            "associated:invoke|fn:proof_entry|FunctionPointer|Used|source:73:8",
+            "trait:ObjectTrait|fn:proof_entry|VTableConstruction|Used|source:80:56",
+            "projection:Assoc|fn:proof_entry|VTableConstruction|Used|source:80:56",
+            "trait:Send|fn:proof_entry|VTableConstruction|Used|source:80:56",
+            "associated:defaulted|vtable:ObjectTrait|VTableMethod|Used|slot:3",
+            "associated:other|vtable:ObjectTrait|VTableMethod|Used|slot:4",
+            "trait:Other|vtable:ObjectTrait|SupertraitVTable|Used|slot:5",
+            "associated:overridden|vtable:ObjectTrait|VTableMethod|Used|slot:6",
+            "associated:tracked|vtable:ObjectTrait|VTableMethod|Used|slot:7",
+            "associated:overridden|fn:proof_entry|DirectCall|Used|source:81:25",
+            "associated:tracked|fn:proof_entry|DirectCall|Used|source:82:25",
+            "associated:defaulted|fn:proof_entry|DirectCall|Used|source:83:25",
+        ]
+    );
+    assert_eq!(
+        proof_inventory(tcx, cold, MonoTraceCollection::Mentioned),
+        ["associated:clone|fn:proof_entry|DirectCall|Mentioned|source:77:25"]
+    );
+    assert!(proof_inventory(tcx, mentioned, MonoTraceCollection::Used).is_empty());
+    assert_eq!(
+        proof_inventory(tcx, mentioned, MonoTraceCollection::Mentioned),
+        [
+            "associated:invoke|fn:proof_entry|DirectCall|Mentioned|source:66:25",
+            "associated:invoke|fn:proof_entry|DirectCall|Mentioned|source:67:25",
+            "associated:invoke|fn:proof_entry|DirectCall|Mentioned|source:70:25",
+            "associated:invoke|fn:proof_entry|FunctionPointer|Mentioned|source:73:8",
+            "associated:clone|fn:proof_entry|DirectCall|Mentioned|source:77:25",
+            "trait:ObjectTrait|fn:proof_entry|VTableConstruction|Mentioned|source:80:56",
+            "projection:Assoc|fn:proof_entry|VTableConstruction|Mentioned|source:80:56",
+            "trait:Send|fn:proof_entry|VTableConstruction|Mentioned|source:80:56",
+            "associated:defaulted|vtable:ObjectTrait|VTableMethod|Mentioned|slot:3",
+            "associated:other|vtable:ObjectTrait|VTableMethod|Mentioned|slot:4",
+            "trait:Other|vtable:ObjectTrait|SupertraitVTable|Mentioned|slot:5",
+            "associated:overridden|vtable:ObjectTrait|VTableMethod|Mentioned|slot:6",
+            "associated:tracked|vtable:ObjectTrait|VTableMethod|Mentioned|slot:7",
+            "associated:overridden|fn:proof_entry|DirectCall|Mentioned|source:81:25",
+            "associated:tracked|fn:proof_entry|DirectCall|Mentioned|source:82:25",
+            "associated:defaulted|fn:proof_entry|DirectCall|Mentioned|source:83:25",
+        ]
+    );
+
+    let dispatch = named_def(tcx, "Dispatch", DefKind::Trait);
+    let invoke = associated_item(tcx, dispatch, "invoke");
+    let default_dispatch = named_def(tcx, "DefaultDispatch", DefKind::Struct);
+    let override_dispatch = named_def(tcx, "OverrideDispatch", DefKind::Struct);
+    let default_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(default_dispatch),
+        rustc_middle::ty::GenericArgs::empty(),
+    );
+    let override_ty = rustc_middle::ty::Ty::new_adt(
+        tcx,
+        tcx.adt_def(override_dispatch),
+        rustc_middle::ty::GenericArgs::empty(),
+    );
+    let three = rustc_middle::ty::Const::from_target_usize(tcx, 3);
+    let five = rustc_middle::ty::Const::from_target_usize(tcx, 5);
+    let typing_env = rustc_middle::ty::TypingEnv::fully_monomorphized();
+    let default_request = typing_env.as_query_input((
+        invoke,
+        tcx.mk_args(&[default_ty.into(), tcx.types.u16.into(), three.into()]),
+    ));
+    let override_request = typing_env.as_query_input((
+        invoke,
+        tcx.mk_args(&[override_ty.into(), tcx.types.u32.into(), five.into()]),
+    ));
+
+    let default_direct: Vec<_> = cold
+        .proof_uses
+        .iter()
+        .filter(|use_| {
+            matches!(
+                use_.proof,
+                MonoProof::AssociatedItem { request, .. }
+                    if request == default_request
+                        && use_.cause == MonoUseCause::DirectCall
+                        && use_.collection == MonoTraceCollection::Used
+            )
+        })
+        .collect();
+    assert_eq!(default_direct.len(), 2);
+    let mut default_sites: Vec<_> = default_direct
+        .iter()
+        .map(|use_| match use_.site {
+            MonoTraceSite::Source(span) => span,
+            _ => panic!("direct associated item lacked a source site"),
+        })
+        .collect();
+    default_sites.sort_by_key(|span| (span.lo(), span.hi()));
+    default_sites.dedup();
+    assert_eq!(default_sites.len(), 2);
+    assert_eq!(
+        cold.proof_uses
+            .iter()
+            .filter(|use_| matches!(
+                use_.proof,
+                MonoProof::AssociatedItem { request, .. }
+                    if request == override_request
+                        && use_.cause == MonoUseCause::DirectCall
+                        && use_.collection == MonoTraceCollection::Used
+            ))
+            .count(),
+        1
+    );
+
+    let used_reify = cold
+        .proof_uses
+        .iter()
+        .find_map(|use_| match use_.proof {
+            MonoProof::AssociatedItem {
+                request,
+                raw_instance,
+                codegen_instance,
+                ..
+            } if request == default_request
+                && use_.cause == MonoUseCause::FunctionPointer
+                && use_.collection == MonoTraceCollection::Used =>
+            {
+                Some((raw_instance, codegen_instance))
+            }
+            _ => None,
+        })
+        .unwrap();
+    assert_ne!(used_reify.0, used_reify.1);
+    assert!(matches!(used_reify.1.def, InstanceKind::Shim(ShimKind::Reify(..))));
+    let mentioned_reify = mentioned
+        .proof_uses
+        .iter()
+        .find_map(|use_| match use_.proof {
+            MonoProof::AssociatedItem {
+                request,
+                raw_instance,
+                codegen_instance,
+                ..
+            } if request == default_request
+                && use_.cause == MonoUseCause::FunctionPointer
+                && use_.collection == MonoTraceCollection::Mentioned =>
+            {
+                Some((raw_instance, codegen_instance))
+            }
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(mentioned_reify.0, mentioned_reify.1);
+    assert_eq!(mentioned_reify.0, used_reify.0);
+
+    let clone_trait = tcx.lang_items().clone_trait().unwrap();
+    let clone = associated_item(tcx, clone_trait, "clone");
+    let clone_use = cold
+        .proof_uses
+        .iter()
+        .find(|use_| matches!(
+            use_.proof,
+            MonoProof::AssociatedItem { request, .. } if request.value.0 == clone
+        ))
+        .unwrap();
+    let MonoProof::AssociatedItem { selection_key, .. } = clone_use.proof else { unreachable!() };
+    assert!(matches!(
+        &tcx.codegen_selection_proof(selection_key).unwrap().top_source,
+        ImplSource::Builtin(..)
+    ));
+
+    let marker = named_def(tcx, "Marker", DefKind::Trait);
+    // A zero-method supertrait has no stock vtable entry; its impl dependency comes from the
+    // selected impl's supertrait constraints, so the mono observer must not invent a proof.
+    assert!(!cold.proof_uses.iter().any(|use_| matches!(
+        use_.proof,
+        MonoProof::TraitSelection { proof_key } if proof_key.value.def_id == marker
+    )));
+    let object_method = associated_item(tcx, object_trait, "overridden");
+    let virtual_use = cold
+        .proof_uses
+        .iter()
+        .find_map(|use_| match use_.proof {
+            MonoProof::AssociatedItem {
+                request,
+                raw_instance,
+                codegen_instance,
+                ..
+            } if request.value.0 == object_method
+                && use_.cause == MonoUseCause::DirectCall
+                && matches!(raw_instance.def, InstanceKind::Virtual(..)) =>
+            {
+                Some((raw_instance, codegen_instance))
+            }
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(virtual_use.0, virtual_use.1);
+    assert!(!cold.facts.iter().any(|fact| {
+        fact.to == MonoTraceNode::Item(MonoItem::Fn(virtual_use.1))
+    }));
+
+    let witnesses = tcx.codegen_vtable_method_witnesses(object_ref).unwrap();
+    let entries = tcx.vtable_entries(object_ref);
+    assert!(entries.iter().any(|entry| matches!(entry, rustc_middle::ty::VtblEntry::Vacant)));
+    let vacant = associated_item(tcx, object_trait, "vacant");
+    let tracked = associated_item(tcx, object_trait, "tracked");
+    assert!(!witnesses.iter().any(|witness| witness.request.value.0 == vacant));
+    for witness in witnesses {
+        let use_ = cold
+            .proof_uses
+            .iter()
+            .find(|use_| {
+                use_.cause == MonoUseCause::VTableMethod
+                    && use_.site == MonoTraceSite::VTableSlot(witness.slot)
+                    && matches!(
+                        use_.proof,
+                        MonoProof::AssociatedItem {
+                            request,
+                            codegen_instance,
+                            ..
+                        } if request == witness.request
+                            && codegen_instance == witness.codegen_instance
+                    )
+            })
+            .unwrap();
+        let MonoProof::AssociatedItem { raw_instance, codegen_instance, .. } = use_.proof else {
+            unreachable!()
+        };
+        if witness.request.value.0 == tracked {
+            assert_ne!(raw_instance, codegen_instance);
+            assert_eq!(raw_instance.args, codegen_instance.args);
+            assert!(matches!(
+                codegen_instance.def,
+                InstanceKind::Shim(ShimKind::Reify(def_id, None))
+                    if def_id == raw_instance.def_id()
+            ));
+        } else {
+            assert_eq!(raw_instance, codegen_instance);
+        }
+    }
+    assert!(cold.proof_uses.iter().any(|use_| {
+        use_.cause == MonoUseCause::SupertraitVTable
+            && matches!(use_.proof, MonoProof::TraitSelection { .. })
+            && matches!(use_.site, MonoTraceSite::VTableSlot(_))
+    }));
+    let send = tcx.get_diagnostic_item(sym::Send).unwrap();
+    assert!(cold.proof_uses.iter().any(|use_| matches!(
+        use_.proof,
+        MonoProof::TraitSelection { proof_key }
+            if proof_key.value.def_id == send
+                && use_.cause == MonoUseCause::VTableConstruction
+    )));
+    let assoc = associated_item(tcx, object_trait, "Assoc");
+    assert!(cold.proof_uses.iter().any(|use_| matches!(
+        use_.proof,
+        MonoProof::Projection {
+            proof_key:
+                rustc_middle::ty::PseudoCanonicalInput {
+                    value: rustc_middle::ty::AliasTerm {
+                        kind: rustc_middle::ty::AliasTermKind::ProjectionTy { def_id },
+                        ..
+                    },
+                    ..
+                },
+            expected,
+        } if def_id == assoc && expected == tcx.types.u8.into()
+    )));
+
+    let only_drop = local_function_instance(tcx, "only_drop");
+    for mode in [CollectionMode::UsedItems, CollectionMode::MentionedItems] {
+        let successors = tcx.mono_successors((MonoTraceRoot::Fn(only_drop), mode)).unwrap();
+        assert!(successors.proof_uses.is_empty());
+    }
+}
