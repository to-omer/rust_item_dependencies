+#[allow(clippy::too_many_arguments)]
+fn assert_associated_const_use<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    successors: &MonoSuccessors<'tcx>,
+    expected_owner: MonoTraceNode<'tcx>,
+    expected_snippet: &str,
+    trait_id: DefId,
+    trait_item: DefId,
+    call_args: rustc_middle::ty::GenericArgsRef<'tcx>,
+    expected_impl: DefId,
+    expected_instance: Instance<'tcx>,
+) {
+    let [use_fact]: &[MonoAssociatedConstUse<'tcx>] = successors.associated_consts else {
+        panic!("expected one associated-const use, got {:?}", successors.associated_consts)
+    };
+    assert_associated_const_fact(
+        tcx,
+        use_fact,
+        expected_owner,
+        expected_snippet,
+        trait_id,
+        trait_item,
+        call_args,
+        expected_impl,
+        expected_instance,
+    );
+}
+
+#[allow(clippy::too_many_arguments)]
+fn assert_associated_const_fact<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    use_fact: &MonoAssociatedConstUse<'tcx>,
+    expected_owner: MonoTraceNode<'tcx>,
+    expected_snippet: &str,
+    trait_id: DefId,
+    trait_item: DefId,
+    call_args: rustc_middle::ty::GenericArgsRef<'tcx>,
+    expected_impl: DefId,
+    expected_instance: Instance<'tcx>,
+) {
+    assert_eq!(use_fact.owner, expected_owner);
+    let typing_env = rustc_middle::ty::TypingEnv::fully_monomorphized();
+    assert_eq!(use_fact.proof_key, typing_env.as_query_input((trait_item, call_args)));
+    let MonoTraceSite::Source(span) = use_fact.site else {
+        panic!("associated-const use lacked a source site: {use_fact:?}")
+    };
+    assert_eq!(tcx.sess.source_map().span_to_snippet(span).unwrap(), expected_snippet);
+
+    let proof = tcx.codegen_associated_item_proof(use_fact.proof_key).unwrap();
+    let again = tcx.codegen_associated_item_proof(use_fact.proof_key).unwrap();
+    assert!(std::ptr::eq(proof, again));
+    assert_eq!(proof.final_instance, expected_instance);
+    assert_eq!(proof.leaf_item, expected_instance.def_id());
+    assert_eq!(
+        proof.selection_key,
+        typing_env.as_query_input(rustc_middle::ty::TraitRef::from_assoc(tcx, trait_id, call_args))
+    );
+    assert!(matches!(
+        &proof.source,
+        ImplSource::UserDefined(data) if data.impl_def_id == expected_impl
+    ));
+}
+
+fn query<'tcx>(tcx: TyCtxt<'tcx>, item: Spanned<MonoItem<'tcx>>) -> &'tcx MonoSuccessors<'tcx> {
+    let root = match item.node {
+        MonoItem::Fn(instance) => MonoTraceRoot::Fn(instance),
+        MonoItem::Static(def_id) => MonoTraceRoot::Static {
+            def_id,
+            trigger_span: item.span,
+        },
+        MonoItem::GlobalAsm(_) => panic!("global asm is outside this observer contract"),
+    };
+    let successors = tcx.mono_successors((root, CollectionMode::UsedItems)).unwrap();
+    assert_no_dummy_source(successors);
+    successors
+}
+
+fn assert_no_dummy_source(successors: &MonoSuccessors<'_>) {
+    assert!(!successors
+        .facts
+        .iter()
+        .any(|fact| matches!(fact.site, MonoTraceSite::Source(span) if span.is_dummy())));
+    assert!(!successors
+        .associated_consts
+        .iter()
+        .any(|fact| matches!(fact.site, MonoTraceSite::Source(span) if span.is_dummy())));
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    let name = rustc_span::Symbol::intern(name);
+    tcx.iter_local_def_id()
+        .map(|def_id| def_id.to_def_id())
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id) == name)
+        .unwrap()
+}
+
+fn associated_item(tcx: TyCtxt<'_>, owner: DefId, name: &str) -> DefId {
+    let name = rustc_span::Symbol::intern(name);
+    tcx.associated_items(owner)
+        .in_definition_order()
+        .find(|item| item.opt_name() == Some(name))
+        .unwrap()
+        .def_id
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(|def_id| def_id.to_def_id())
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&impl_id| {
+            tcx.impl_trait_id(impl_id) == trait_id
+                && tcx
+                    .type_of(impl_id)
+                    .instantiate_identity()
+                    .skip_norm_wip()
+                    .ty_adt_def()
+                    .is_some_and(|def| def.did() == adt_id)
+        })
+        .unwrap()
+}
+
+fn local_static(tcx: TyCtxt<'_>, name: &str) -> rustc_hir::def_id::DefId {
+    let def_id = tcx
+        .hir_crate_items(())
+        .definitions()
+        .map(|id| id.to_def_id())
+        .find(|&def_id| {
+            matches!(tcx.def_kind(def_id), DefKind::Static { .. })
+                && tcx.item_name(def_id).as_str() == name
+        })
+        .unwrap();
+    assert!(matches!(tcx.def_kind(def_id), DefKind::Static { .. }));
+    def_id
+}
+
+fn named_instance(tcx: TyCtxt<'_>, instance: Instance<'_>, name: &str) -> bool {
+    tcx.opt_item_name(instance.def_id()).is_some_and(|symbol| symbol.as_str() == name)
+}
+
+fn local_function_instance<'tcx>(tcx: TyCtxt<'tcx>, name: &str) -> Instance<'tcx> {
+    let def_id = tcx
+        .hir_crate_items(())
+        .definitions()
+        .map(|id| id.to_def_id())
+        .find(|&def_id| {
+            tcx.def_kind(def_id) == DefKind::Fn
+                && tcx.opt_item_name(def_id).is_some_and(|symbol| symbol.as_str() == name)
+        })
+        .unwrap();
+    Instance::mono(tcx, def_id)
+}
+
+fn exactly_one_instance<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    items: &[Spanned<MonoItem<'tcx>>],
+    name: &str,
+    type_arg: Option<rustc_middle::ty::Ty<'tcx>>,
+) -> Instance<'tcx> {
+    let matches: Vec<_> = items
+        .iter()
+        .filter_map(|item| match item.node {
+            MonoItem::Fn(instance)
+                if named_instance(tcx, instance, name)
+                    && type_arg.is_none_or(|ty| instance.args.type_at(0) == ty) =>
+            {
+                Some(instance)
+            }
+            _ => None,
+        })
+        .collect();
+    assert_eq!(matches.len(), 1, "expected one instance of {name}, got {matches:?}");
+    matches[0]
+}
+
+fn count_named(tcx: TyCtxt<'_>, items: &[Spanned<MonoItem<'_>>], name: &str) -> usize {
+    items
+        .iter()
+        .filter(|item| matches!(item.node, MonoItem::Fn(instance) if named_instance(tcx, instance, name)))
+        .count()
+}
+
+fn contains_named(tcx: TyCtxt<'_>, items: &[MonoItem<'_>], name: &str) -> bool {
+    items
+        .iter()
+        .any(|item| matches!(*item, MonoItem::Fn(instance) if named_instance(tcx, instance, name)))
+}
+
+fn contains_instance<'tcx>(items: &[MonoItem<'tcx>], wanted: Instance<'tcx>) -> bool {
+    items.iter().any(|item| *item == MonoItem::Fn(wanted))
+}
+
+fn source_sites_to_instance<'tcx>(
+    successors: &MonoSuccessors<'tcx>,
+    collection: MonoTraceCollection,
+    cause: MonoUseCause,
+    target: Instance<'tcx>,
+) -> Vec<Span> {
+    successors
+        .facts
+        .iter()
+        .filter_map(|fact| {
+            if fact.collection == collection
+                && fact.cause == cause
+                && fact.to == MonoTraceNode::Item(MonoItem::Fn(target))
+            {
+                Some(match fact.site {
+                    MonoTraceSite::Source(span) => span,
+                    _ => panic!("source edge did not retain a source span"),
+                })
+            } else {
+                None
+            }
+        })
+        .collect()
+}
+
+fn is_drop_glue(node: MonoTraceNode<'_>) -> bool {
+    matches!(
+        node,
+        MonoTraceNode::Item(MonoItem::Fn(Instance {
+            def: InstanceKind::Shim(ShimKind::DropGlue(..)),
+            ..
+        }))
+    )
+}
+
+struct Classes<'tcx> {
+    used: Vec<MonoItem<'tcx>>,
+    mentioned: Vec<MonoItem<'tcx>>,
+}
+
+fn walk<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    seeds: impl IntoIterator<Item = Spanned<MonoItem<'tcx>>>,
+) -> Classes<'tcx> {
+    let mut used_queue: Vec<_> = seeds.into_iter().collect();
+    let mut mentioned_queue = Vec::new();
+    let mut used = Vec::new();
+    let mut mentioned = Vec::new();
+
+    loop {
+        while let Some(item) = used_queue.pop() {
+            if used.contains(&item.node) {
+                continue;
+            }
+            used.push(item.node);
+            let successors = query(tcx, item);
+            used_queue.extend(successors.used.iter().copied());
+            mentioned_queue.extend(successors.mentioned.iter().copied());
+        }
+
+        let Some(item) = mentioned_queue.pop() else { break };
+        if used.contains(&item.node) || mentioned.contains(&item.node) {
+            continue;
+        }
+        mentioned.push(item.node);
+        let root = match item.node {
+            MonoItem::Fn(instance) => MonoTraceRoot::Fn(instance),
+            MonoItem::Static(def_id) => MonoTraceRoot::Static {
+                def_id,
+                trigger_span: item.span,
+            },
+            MonoItem::GlobalAsm(_) => panic!("global asm is outside this observer contract"),
+        };
+        let successors = tcx
+            .mono_successors((root, CollectionMode::MentionedItems))
+            .unwrap();
+        assert_no_dummy_source(successors);
+        used_queue.extend(successors.used.iter().copied());
+        mentioned_queue.extend(successors.mentioned.iter().copied());
+    }
+
+    mentioned.retain(|item| !used.contains(item));
+    Classes { used, mentioned }
+}
