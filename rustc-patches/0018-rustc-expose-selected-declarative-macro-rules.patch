 impl<'ra, 'tcx> Resolver<'ra, 'tcx> {
+    pub(crate) fn record_macro_rules_definition(
+        &mut self,
+        node_id: NodeId,
+        definition: LocalDefId,
+        extension: &SyntaxExtension,
+    ) {
+        let SyntaxExtensionKind::MacroRules(rules) = &extension.kind else { return };
+        if !rules.is_macro_rules() {
+            return;
+        }
+        let definitions = rules
+            .rule_span_endpoints()
+            .map(|(start_span, end_span)| MacroRuleDefinition { start_span, end_span })
+            .collect::<Vec<_>>();
+        if definitions.is_empty() {
+            self.dcx().bug("a declarative macro rule inventory cannot be empty");
+        }
+        if self.macro_rules_definition_ids.insert(node_id, definition).is_some() {
+            self.dcx().bug("a local declarative macro node cannot have two definitions");
+        }
+        if self.macro_rules_definitions.insert(definition, definitions).is_some() {
+            self.dcx().bug("a local declarative macro definition cannot have two rule inventories");
+        }
+    }
+
     /// Resolve macro path with error reporting and recovery.
     /// Uses dummy syntax extensions for unresolved macros or macros with unexpected resolutions
     /// for better error recovery.
diff --git a/tests/ui-fulldeps/auxiliary/macro-rule-observer-input.rs b/tests/ui-fulldeps/auxiliary/macro-rule-observer-input.rs
new file mode 100644
index 00000000..9dd1d45f
--- /dev/null
+++ b/tests/ui-fulldeps/auxiliary/macro-rule-observer-input.rs
@@ -0,0 +1,40 @@
+#![allow(unused_macros)]
+#![feature(decl_macro)]
+
+#[macro_export]
+macro_rules! _dispatch {
+    (@base) => { 2usize };
+    (@recur) => { crate::_dispatch!(@base) };
+    ($value:expr) => { $value + crate::_dispatch!(@recur) };
+    (@never) => { compile_error!("this rule must stay unexpanded") }
+}
+
+#[macro_export]
+macro_rules! _unused_export {
+    (first) => { 0usize };
+    (second) => { 1usize };
+}
+
+macro_rules! make_generated {
+    () => {{
+        macro_rules! generated {
+            (hit) => { 5usize };
+            (miss) => { 6usize };
+        }
+        generated!(hit)
+    }};
+}
+
+macro modern {
+    (hit) => { 7usize },
+    (miss) => { 8usize },
+}
+
+fn main() {
+    let direct = crate::_dispatch!(3usize);
+    let generated = make_generated!();
+    let modern = modern!(hit);
+    assert_eq!(direct, 5);
+    assert_eq!(generated, 5);
+    assert_eq!(modern, 7);
+}
diff --git a/tests/ui-fulldeps/macro-rule-observer.rs b/tests/ui-fulldeps/macro-rule-observer.rs
new file mode 100644
index 00000000..7e14ee8e
--- /dev/null
+++ b/tests/ui-fulldeps/macro-rule-observer.rs
@@ -0,0 +1,132 @@
+//@ edition: 2024
+//@ run-pass
+//@ run-flags: --sysroot {{sysroot-base}} --edition=2024 {{src-base}}/auxiliary/macro-rule-observer-input.rs
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_span;
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::process::ExitCode;
+
+use rustc_driver::Compilation;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::LocalDefId;
+use rustc_interface::interface::Compiler;
+use rustc_middle::ty::{MacroImplementationKind, MacroRuleDefinition, TyCtxt};
+use rustc_span::hygiene::{ExpnKind, MacroKind};
+use rustc_span::Symbol;
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        let args: Vec<_> = std::env::args().collect();
+        rustc_driver::run_compiler(&args, &mut Callbacks);
+    })
+}
+
+struct Callbacks;
+
+impl rustc_driver::Callbacks for Callbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+        let resolutions = tcx.resolutions(());
+
+        let dispatch = named_macro(tcx, "_dispatch");
+        let unused_export = named_macro(tcx, "_unused_export");
+        let make_generated = named_macro(tcx, "make_generated");
+        let generated = named_macro(tcx, "generated");
+        let modern = named_macro(tcx, "modern");
+
+        assert_eq!(resolutions.macro_rules_definitions.len(), 4);
+        assert!(!resolutions.macro_rules_definitions.contains_key(&modern));
+        assert_rule_snippets(
+            tcx,
+            &resolutions.macro_rules_definitions[&dispatch],
+            &[
+                "(@base) => { 2usize };",
+                "(@recur) => { crate::_dispatch!(@base) };",
+                "($value:expr) => { $value + crate::_dispatch!(@recur) };",
+                "(@never) => { compile_error!(\"this rule must stay unexpanded\") }",
+            ],
+        );
+        assert_rule_snippets(
+            tcx,
+            &resolutions.macro_rules_definitions[&unused_export],
+            &["(first) => { 0usize };", "(second) => { 1usize };"],
+        );
+        assert_rule_snippets(
+            tcx,
+            &resolutions.macro_rules_definitions[&make_generated],
+            &["() => {{\n        macro_rules! generated {\n            (hit) => { 5usize };\n            (miss) => { 6usize };\n        }\n        generated!(hit)\n    }};"],
+        );
+        assert_eq!(resolutions.macro_rules_definitions[&generated].len(), 2);
+
+        let selections = RefCell::new(HashMap::new());
+        assert!(resolutions
+            .macro_invocation_origins
+            .items()
+            .all(|(&expn_id, origin)| {
+            let macro_def_id = expn_id.expn_data().macro_def_id;
+            let observed_definition = macro_def_id
+                .and_then(|def_id| def_id.as_local())
+                .filter(|def_id| resolutions.macro_rules_definitions.contains_key(def_id));
+            if let Some(expected_definition) = observed_definition {
+                assert_eq!(origin.implementation_kind, MacroImplementationKind::Declarative);
+                assert!(matches!(expn_id.expn_data().kind, ExpnKind::Macro(MacroKind::Bang, _)));
+                let selection = origin
+                    .selected_macro_rule
+                    .expect("every successful local declarative invocation must select a rule");
+                assert_eq!(selection.definition, expected_definition);
+                assert!(selection.rule_index < resolutions.macro_rules_definitions[&selection.definition].len());
+                *selections
+                    .borrow_mut()
+                    .entry((selection.definition, selection.rule_index))
+                    .or_insert(0) += 1;
+            } else {
+                assert_eq!(origin.selected_macro_rule, None);
+            }
+            true
+        }));
+        let selections = selections.into_inner();
+
+        assert_eq!(
+            selections,
+            HashMap::from([
+                ((dispatch, 0), 1),
+                ((dispatch, 1), 1),
+                ((dispatch, 2), 1),
+                ((make_generated, 0), 1),
+                ((generated, 0), 1),
+            ])
+        );
+        Compilation::Stop
+    }
+}
+
+fn assert_rule_snippets(tcx: TyCtxt<'_>, definitions: &[MacroRuleDefinition], expected: &[&str]) {
+    assert_eq!(definitions.len(), expected.len());
+    let source_map = tcx.sess.source_map();
+    for (definition, expected) in definitions.iter().zip(expected) {
+        assert!(!definition.start_span.from_expansion());
+        assert!(!definition.end_span.from_expansion());
+        let range = definition.start_span.with_hi(definition.end_span.hi());
+        assert_eq!(source_map.span_to_snippet(range).unwrap(), *expected);
+    }
+}
+
+fn named_macro(tcx: TyCtxt<'_>, name: &str) -> LocalDefId {
+    let name = Symbol::intern(name);
+    tcx.iter_local_def_id()
+        .find(|&def_id| {
+            matches!(tcx.def_kind(def_id), DefKind::Macro(_)) && tcx.item_name(def_id) == name
+        })
+        .unwrap()
+}
