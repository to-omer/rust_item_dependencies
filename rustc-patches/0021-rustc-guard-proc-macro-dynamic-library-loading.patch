diff --git a/tests/ui-fulldeps/proc-macro-load-guard.rs b/tests/ui-fulldeps/proc-macro-load-guard.rs
new file mode 100644
index 00000000..0534512e
--- /dev/null
+++ b/tests/ui-fulldeps/proc-macro-load-guard.rs
@@ -0,0 +1,289 @@
+//@ edition: 2024
+//@ run-pass
+//@ run-flags: {{sysroot-base}} {{target-linker}}
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_interface;
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, ExitCode};
+use std::sync::{Arc, Mutex};
+
+use rustc_driver::{Callbacks, ProcMacroLoadGuard};
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(|| {
+        let args: Vec<_> = std::env::args().collect();
+        if args.get(1).is_some_and(|arg| arg == "--deny-child") {
+            run_denied(&args[2..]);
+        } else {
+            run_test(&args[1..]);
+        }
+    })
+}
+
+fn run_test(args: &[String]) {
+    let (sysroot, linker) = compiler_paths(args);
+    let tmp = std::env::current_dir().unwrap().join("proc-macro-load-guard");
+    std::fs::create_dir_all(&tmp).unwrap();
+
+    let macros_source = tmp.join("guard_macros.rs");
+    std::fs::write(
+        &macros_source,
+        r#"
+            extern crate proc_macro;
+
+            use proc_macro::TokenStream;
+
+            #[proc_macro]
+            pub fn make_function(_: TokenStream) -> TokenStream {
+                "fn generated() -> usize { 1 }".parse().unwrap()
+            }
+
+            #[proc_macro_attribute]
+            pub fn passthrough(_: TokenStream, item: TokenStream) -> TokenStream {
+                item
+            }
+
+            #[proc_macro_derive(Marker)]
+            pub fn marker(_: TokenStream) -> TokenStream {
+                "impl Marker for Derived {}".parse().unwrap()
+            }
+        "#,
+    )
+    .unwrap();
+
+    let macro_out = tmp.join("macro-out");
+    std::fs::create_dir_all(&macro_out).unwrap();
+    compile(
+        rustc_args(
+            &sysroot,
+            linker,
+            &macros_source,
+            &macro_out,
+            "guard_macros",
+            &["--crate-type=proc-macro".to_string()],
+        ),
+        &mut DefaultCallbacks,
+    );
+    let macro_dylib = proc_macro_dylib(&macro_out, "guard_macros");
+    let macro_dylib = std::fs::canonicalize(macro_dylib).unwrap();
+
+    let client_source = tmp.join("client.rs");
+    std::fs::write(
+        &client_source,
+        r#"
+            trait Marker {}
+
+            #[derive(guard_macros::Marker)]
+            struct Derived;
+
+            #[guard_macros::passthrough]
+            fn attributed() -> usize { 2 }
+
+            guard_macros::make_function!();
+
+            fn main() {
+                let _: &dyn Marker = &Derived;
+                let _ = generated() + attributed();
+            }
+        "#,
+    )
+    .unwrap();
+
+    let deny = Command::new(std::env::current_exe().unwrap())
+        .arg("--deny-child")
+        .args(args)
+        .env("PROC_MACRO_GUARD_DYLIB", &macro_dylib)
+        .env("PROC_MACRO_GUARD_CLIENT", &client_source)
+        .env("PROC_MACRO_GUARD_TMP", &tmp)
+        .output()
+        .unwrap();
+    assert!(!deny.status.success());
+    let stderr = String::from_utf8(deny.stderr).unwrap();
+    assert!(
+        stderr.contains("loading proc-macro library is not permitted by the compiler driver"),
+        "unexpected denial diagnostic: {stderr}"
+    );
+    let denied_path = std::fs::read_to_string(tmp.join("denied-path")).unwrap();
+    assert_eq!(Path::new(&denied_path), macro_dylib);
+
+    let direct_extern = format!("--extern=guard_macros={}", macro_dylib.display());
+    compile_client(
+        &sysroot,
+        linker,
+        &client_source,
+        &tmp.join("no-guard-out"),
+        "no_guard",
+        &[direct_extern.clone()],
+        &mut DefaultCallbacks,
+    );
+
+    let observed = Arc::new(Mutex::new(Vec::new()));
+    compile_client(
+        &sysroot,
+        linker,
+        &client_source,
+        &tmp.join("allow-out"),
+        "allowed",
+        &[direct_extern],
+        &mut GuardCallbacks::allow(macro_dylib.clone(), observed.clone()),
+    );
+    assert_eq!(*observed.lock().unwrap(), [macro_dylib.clone()]);
+
+    let facade_source = tmp.join("guard_facade.rs");
+    std::fs::write(
+        &facade_source,
+        "pub use guard_macros::{Marker, make_function, passthrough};",
+    )
+    .unwrap();
+    compile(
+        rustc_args(
+            &sysroot,
+            linker,
+            &facade_source,
+            &macro_out,
+            "guard_facade",
+            &[
+                "--crate-type=rlib".to_string(),
+                format!("--extern=guard_macros={}", macro_dylib.display()),
+            ],
+        ),
+        &mut DefaultCallbacks,
+    );
+    let facade = std::fs::canonicalize(macro_out.join("libguard_facade.rlib")).unwrap();
+    let transitive_source = tmp.join("transitive.rs");
+    let source = std::fs::read_to_string(&client_source)
+        .unwrap()
+        .replace("guard_macros", "guard_facade");
+    std::fs::write(&transitive_source, source).unwrap();
+    let observed = Arc::new(Mutex::new(Vec::new()));
+    compile_client(
+        &sysroot,
+        linker,
+        &transitive_source,
+        &tmp.join("transitive-out"),
+        "transitive",
+        &[
+            format!("--extern=guard_facade={}", facade.display()),
+            format!("-Ldependency={}", macro_out.display()),
+        ],
+        &mut GuardCallbacks::allow(macro_dylib.clone(), observed.clone()),
+    );
+    assert_eq!(*observed.lock().unwrap(), [macro_dylib]);
+}
+
+fn run_denied(args: &[String]) {
+    let (sysroot, linker) = compiler_paths(args);
+    let macro_dylib = PathBuf::from(std::env::var_os("PROC_MACRO_GUARD_DYLIB").unwrap());
+    let client = PathBuf::from(std::env::var_os("PROC_MACRO_GUARD_CLIENT").unwrap());
+    let tmp = PathBuf::from(std::env::var_os("PROC_MACRO_GUARD_TMP").unwrap());
+    let observed = tmp.join("denied-path");
+    let expected = macro_dylib.clone();
+    let guard = ProcMacroLoadGuard::new(move |path| {
+        std::fs::write(&observed, path.to_string_lossy().as_bytes()).unwrap();
+        assert_eq!(path, expected);
+        false
+    });
+    compile_client(
+        &sysroot,
+        linker,
+        &client,
+        &tmp.join("deny-out"),
+        "denied",
+        &[format!("--extern=guard_macros={}", macro_dylib.display())],
+        &mut GuardCallbacks { guard: Some(guard) },
+    );
+}
+
+fn compiler_paths(args: &[String]) -> (PathBuf, Option<&Path>) {
+    let sysroot = args.first().expect("expected sysroot").as_str().into();
+    let linker = args.get(1).map(|arg| Path::new(arg));
+    (sysroot, linker)
+}
+
+fn compile_client(
+    sysroot: &Path,
+    linker: Option<&Path>,
+    input: &Path,
+    output: &Path,
+    crate_name: &str,
+    extra: &[String],
+    callbacks: &mut (dyn Callbacks + Send),
+) {
+    std::fs::create_dir_all(output).unwrap();
+    let mut extra = extra.to_vec();
+    extra.push("--emit=metadata".to_string());
+    compile(rustc_args(sysroot, linker, input, output, crate_name, &extra), callbacks);
+}
+
+fn rustc_args(
+    sysroot: &Path,
+    linker: Option<&Path>,
+    input: &Path,
+    output: &Path,
+    crate_name: &str,
+    extra: &[String],
+) -> Vec<String> {
+    let mut args = vec![
+        "rustc".to_string(),
+        format!("--sysroot={}", sysroot.display()),
+        "--edition=2024".to_string(),
+        format!("--crate-name={crate_name}"),
+        format!("--out-dir={}", output.display()),
+        input.display().to_string(),
+    ];
+    if let Some(linker) = linker {
+        args.push(format!("-Clinker={}", linker.display()));
+    }
+    args.extend_from_slice(extra);
+    args
+}
+
+fn compile(args: Vec<String>, callbacks: &mut (dyn Callbacks + Send)) {
+    rustc_driver::run_compiler(&args, callbacks);
+}
+
+fn proc_macro_dylib(output: &Path, crate_name: &str) -> PathBuf {
+    let prefix = if cfg!(target_os = "windows") { "" } else { "lib" };
+    let extension = if cfg!(target_os = "macos") {
+        "dylib"
+    } else if cfg!(target_os = "windows") {
+        "dll"
+    } else if cfg!(target_os = "aix") {
+        "a"
+    } else {
+        "so"
+    };
+    output.join(format!("{prefix}{crate_name}.{extension}"))
+}
+
+struct DefaultCallbacks;
