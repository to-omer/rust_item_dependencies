+        &mut self,
+        obligation: &mut Self::Obligation,
+    ) -> ProcessResult<Self::Obligation, Self::Error> {
+        let proof_obligation = CodegenProofObligation {
+            param_env: obligation.obligation.param_env,
+            predicate: self
+                .inner
+                .selcx
+                .infcx
+                .resolve_vars_if_possible(obligation.obligation.predicate),
+        };
+        let previous_owner = {
+            let mut recorder = self.recorder.borrow_mut();
+            let node = recorder.node_for(proof_obligation);
+            recorder.set_current_owner(Some(node))
+        };
+
+        let result = self.inner.process_obligation(obligation);
+        let mut recorder = self.recorder.borrow_mut();
+        match &result {
+            ProcessResult::Changed(nested) => recorder.record_fulfillment(
+                proof_obligation,
+                nested.iter().map(|pending| CodegenProofObligation {
+                    param_env: pending.obligation.param_env,
+                    predicate: pending.obligation.predicate,
+                }),
+            ),
+            ProcessResult::Unchanged | ProcessResult::Error(_) => {}
+        }
+        recorder.set_current_owner(previous_owner);
+        result
+    }
+
+    fn process_backedge<'c, I>(
+        &mut self,
+        cycle: I,
+        marker: PhantomData<&'c Self::Obligation>,
+    ) -> Result<(), Self::Error>
+    where
+        I: Clone + Iterator<Item = &'c Self::Obligation>,
+    {
+        let proof_cycle: Vec<_> = cycle
+            .clone()
+            .map(|pending| CodegenProofObligation {
+                param_env: pending.obligation.param_env,
+                predicate: pending.obligation.predicate,
+            })
+            .collect();
+        let result = self.inner.process_backedge(cycle, marker);
+        self.recorder.borrow_mut().record_cycle(proof_cycle, result.is_ok());
+        result
+    }
+}
