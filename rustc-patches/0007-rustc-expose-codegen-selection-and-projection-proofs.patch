+}
+
+#[derive(Clone, Debug, PartialEq, Eq, StableHash)]
+#[derive(TypeVisitable, TypeFoldable)]
+pub struct CodegenProjectionTrace<'tcx> {
+    /// Every obligation whose committed proof used this projection.
+    ///
+    /// A projection cache entry may be reused by more than one obligation, so a
+    /// single owner would lose dependency edges on cache hits.
+    pub owners: Vec<CodegenProofNodeId>,
+    pub param_env: ty::ParamEnv<'tcx>,
+    pub projection: ty::AliasTerm<'tcx>,
+    pub source: CodegenProjectionSource<'tcx>,
+    /// The committed trait selection observed for an impl-backed projection.
+    pub selected_trait_node: Option<CodegenProofNodeId>,
+    /// The exact impl or trait associated item selected by specialization.
+    pub selected_projection_item: Option<DefId>,
+    pub result: CodegenProjectionTraceResult<'tcx>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, StableHash)]
+#[derive(TypeVisitable, TypeFoldable)]
+pub enum CodegenProjectionSource<'tcx> {
+    ParamEnv(ty::PolyProjectionPredicate<'tcx>),
+    TraitDef(ty::PolyProjectionPredicate<'tcx>),
+    Object(ty::PolyProjectionPredicate<'tcx>),
+    Selected(ImplSource<'tcx, ()>),
