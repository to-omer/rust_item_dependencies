+    projection_builtin: CanonicalProjectionReport,
+    send: CanonicalSelectionReport,
+}
+
+#[derive(Debug, Eq, PartialEq)]
+struct CanonicalSelectionReport {
+    top_source: Fingerprint,
+    trace: CanonicalTraceReport,
+}
+
+#[derive(Debug, Eq, PartialEq)]
+struct CanonicalProjectionReport {
+    normalized_term: Fingerprint,
+    trace: CanonicalTraceReport,
+}
+
+#[derive(Debug, Eq, PartialEq)]
+struct CanonicalTraceReport {
+    root_obligation: Fingerprint,
+    obligations: Vec<Fingerprint>,
+    trait_selections: Vec<Fingerprint>,
+    projections: Vec<Fingerprint>,
+    fulfillments: Vec<Fingerprint>,
+    cycles: Vec<Fingerprint>,
+}
+
+fn projection_proof_with_parity<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    typing_env: ty::TypingEnv<'tcx>,
+    goal: ty::AliasTerm<'tcx>,
+) -> &'tcx CodegenProjectionProof<'tcx> {
+    let key = typing_env.as_query_input(goal);
+    let stock_before = stock_normalize(tcx, typing_env, goal);
+    let proof = tcx.codegen_projection_proof(key).unwrap();
+    let owned = proof.clone();
+    let warm = tcx.codegen_projection_proof(key).unwrap();
+    assert!(std::ptr::eq(proof, warm));
+    assert_eq!(owned, *warm);
+    let stock_after = stock_normalize(tcx, typing_env, goal);
+    assert_eq!(stock_before, stock_after);
+    assert_eq!(proof.normalized_term, stock_after);
+    proof
+}
+
+fn stock_normalize<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    typing_env: ty::TypingEnv<'tcx>,
+    goal: ty::AliasTerm<'tcx>,
+) -> ty::Term<'tcx> {
+    let arg = tcx
+        .try_normalize_generic_arg_after_erasing_regions(
+            typing_env.as_query_input(goal.to_term(tcx, ty::IsRigid::No).into_arg()),
+        )
+        .unwrap();
+    match arg.kind() {
+        ty::GenericArgKind::Type(ty) => ty.into(),
+        ty::GenericArgKind::Const(ct) => ct.into(),
+        ty::GenericArgKind::Lifetime(_) => unreachable!(),
+    }
+}
+
+fn assert_projection_root<'tcx>(
+    proof: &CodegenProjectionProof<'tcx>,
+    goal: ty::AliasTerm<'tcx>,
+) {
+    let root = proof.trace.root;
+    let root_clause = proof.trace.obligations[root.0 as usize]
+        .predicate
+        .as_projection_clause()
+        .unwrap()
+        .skip_binder();
+    assert_eq!(root_clause.projection_term, goal);
+    assert_eq!(root_clause.term, proof.normalized_term);
+    assert_eq!(
+        proof
+            .trace
+            .projections
+            .iter()
+            .filter(|projection| {
+                projection.projection == goal && projection.owners.contains(&root)
+            })
+            .count(),
+        1,
+        "{:#?}",
+        proof.trace
+    );
+    assert_eq!(
+        proof
+            .trace
+            .fulfillments
+            .iter()
+            .filter(|fulfillment| fulfillment.node == root)
+            .count(),
+        1,
+        "{:#?}",
+        proof.trace
+    );
+    for (index, obligation) in proof.trace.obligations.iter().enumerate() {
+        assert!(
+            !proof.trace.obligations[index + 1..].contains(obligation),
+            "{:#?}",
+            proof.trace
+        );
+    }
+}
+
+fn canonical_report<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    proof: &CodegenSelectionProof<'tcx>,
+) -> CanonicalSelectionReport {
+    CanonicalSelectionReport {
+        top_source: stable_fingerprint(tcx, &proof.top_source),
+        trace: canonical_trace_report(tcx, &proof.trace),
+    }
+}
+
+fn canonical_projection_report<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    proof: &CodegenProjectionProof<'tcx>,
+) -> CanonicalProjectionReport {
+    CanonicalProjectionReport {
+        normalized_term: stable_fingerprint(tcx, &proof.normalized_term),
+        trace: canonical_trace_report(tcx, &proof.trace),
+    }
+}
+
+fn canonical_trace_report<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    trace: &CodegenSolverTrace<'tcx>,
+) -> CanonicalTraceReport {
+    let root_obligation = &trace.obligations[trace.root.0 as usize];
+    CanonicalTraceReport {
+        root_obligation: stable_fingerprint(tcx, root_obligation),
+        obligations: sorted_fingerprints(tcx, &trace.obligations),
+        trait_selections: sorted_fingerprints(tcx, &trace.trait_selections),
+        projections: sorted_fingerprints(tcx, &trace.projections),
+        fulfillments: sorted_fingerprints(tcx, &trace.fulfillments),
+        cycles: sorted_fingerprints(tcx, &trace.cycles),
+    }
+}
+
+fn sorted_fingerprints<T: StableHash>(tcx: TyCtxt<'_>, values: &[T]) -> Vec<Fingerprint> {
+    let mut fingerprints: Vec<_> =
+        values.iter().map(|value| stable_fingerprint(tcx, value)).collect();
+    fingerprints.sort();
+    fingerprints
+}
+
+fn stable_fingerprint<T: StableHash>(tcx: TyCtxt<'_>, value: &T) -> Fingerprint {
+    tcx.with_stable_hashing_context(|mut hcx| {
+        let mut hasher = StableHasher::new();
+        value.stable_hash(&mut hcx, &mut hasher);
+        hasher.finish()
+    })
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    let name = Symbol::intern(name);
+    tcx.iter_local_def_id()
+        .map(|def_id| def_id.to_def_id())
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id) == name)
+        .unwrap()
+}
+
+fn associated_item(tcx: TyCtxt<'_>, owner: DefId, name: &str) -> DefId {
+    let name = Symbol::intern(name);
+    tcx.associated_items(owner)
+        .in_definition_order()
+        .find(|item| item.opt_name() == Some(name))
+        .unwrap()
+        .def_id
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(|def_id| def_id.to_def_id())
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&def_id| {
+            tcx.impl_trait_id(def_id) == trait_id
+                && tcx
+                    .impl_trait_ref(def_id)
+                    .skip_binder()
+                    .self_ty()
+                    .ty_adt_def()
+                    .is_some_and(|adt| adt.did() == adt_id)
+        })
+        .unwrap()
+}
