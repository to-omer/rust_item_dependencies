diff --git a/compiler/rustc_trait_selection/src/traits/codegen_proof.rs b/compiler/rustc_trait_selection/src/traits/codegen_proof.rs
new file mode 100644
index 00000000..0c332374
--- /dev/null
+++ b/compiler/rustc_trait_selection/src/traits/codegen_proof.rs
@@ -0,0 +1,656 @@
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use rustc_data_structures::fingerprint::Fingerprint;
+use rustc_data_structures::fx::FxHashMap;
+use rustc_data_structures::stable_hash::{StableHash, StableHasher};
+use rustc_infer::infer::InferCtxt;
+use rustc_middle::traits::{
+    CodegenCycleTrace, CodegenFulfillmentTrace, CodegenProjectionSource, CodegenProjectionTrace,
+    CodegenProjectionTraceResult, CodegenProofNodeId, CodegenProofObligation,
+    CodegenSelectionProofError, CodegenSolverTrace, CodegenTraitSelectionTrace, ImplSource,
+};
+use rustc_middle::ty::{self, TyCtxt, TypeVisitableExt, Upcast};
+use rustc_span::def_id::DefId;
+
+pub type SharedCodegenProofRecorder<'tcx> = Rc<RefCell<CodegenProofRecorder<'tcx>>>;
+
+#[derive(Copy, Clone)]
+struct ProjectionId(u32);
+
+#[derive(Clone)]
+struct PendingProjection<'tcx> {
+    owners: Vec<CodegenProofNodeId>,
+    param_env: ty::ParamEnv<'tcx>,
+    projection: ty::AliasTerm<'tcx>,
+    source: Option<CodegenProjectionSource<'tcx>>,
+    selected_trait_node: Option<CodegenProofNodeId>,
+    selected_projection_item: Option<DefId>,
+    result: Option<CodegenProjectionTraceResult<'tcx>>,
+}
+
+#[derive(Clone)]
+pub struct CodegenProofRecorder<'tcx> {
+    root: CodegenProofNodeId,
+    node_ids: FxHashMap<(ty::ParamEnv<'tcx>, ty::Predicate<'tcx>), CodegenProofNodeId>,
+    obligations: Vec<CodegenProofObligation<'tcx>>,
+    projection_ids: FxHashMap<(ty::ParamEnv<'tcx>, ty::AliasTerm<'tcx>), ProjectionId>,
+    projections: Vec<PendingProjection<'tcx>>,
+    trait_selections: Vec<CodegenTraitSelectionTrace<'tcx>>,
+    fulfillments: Vec<CodegenFulfillmentTrace>,
+    cycles: Vec<CodegenCycleTrace>,
+    current_owner: Option<CodegenProofNodeId>,
+    incomplete: bool,
+    muted: usize,
+}
+
+impl<'tcx> CodegenProofRecorder<'tcx> {
+    pub fn shared(
+        param_env: ty::ParamEnv<'tcx>,
+        predicate: ty::Predicate<'tcx>,
+    ) -> SharedCodegenProofRecorder<'tcx> {
+        let root = CodegenProofNodeId(0);
+        Rc::new(RefCell::new(Self {
+            root,
+            node_ids: FxHashMap::from_iter([((param_env, predicate), root)]),
+            obligations: vec![CodegenProofObligation { param_env, predicate }],
+            projection_ids: FxHashMap::default(),
+            projections: Vec::new(),
+            trait_selections: Vec::new(),
+            fulfillments: Vec::new(),
+            cycles: Vec::new(),
+            current_owner: Some(root),
+            incomplete: false,
+            muted: 0,
+        }))
+    }
+
+    pub(crate) fn is_recording(&self) -> bool {
+        self.muted == 0
+    }
+
+    pub(crate) fn mute(&mut self) {
+        self.muted += 1;
+    }
+
+    pub(crate) fn unmute(&mut self) {
+        self.muted = self.muted.checked_sub(1).expect("unbalanced codegen proof mute");
+    }
+
+    pub(crate) fn mark_incomplete(&mut self) {
+        if self.is_recording() {
+            self.incomplete = true;
+        }
+    }
+
+    pub(crate) fn set_current_owner(
+        &mut self,
+        owner: Option<CodegenProofNodeId>,
+    ) -> Option<CodegenProofNodeId> {
+        std::mem::replace(&mut self.current_owner, owner)
+    }
+
+    pub(crate) fn node_for(
+        &mut self,
+        obligation: CodegenProofObligation<'tcx>,
+    ) -> CodegenProofNodeId {
+        let key = (obligation.param_env, obligation.predicate);
+        if let Some(&id) = self.node_ids.get(&key) {
+            return id;
+        }
+        let id = CodegenProofNodeId(self.obligations.len().try_into().unwrap());
+        self.node_ids.insert(key, id);
+        self.obligations.push(obligation);
+        id
+    }
+
+    pub(crate) fn record_selection(
+        &mut self,
+        obligation: CodegenProofObligation<'tcx>,
+        source: ImplSource<'tcx, CodegenProofObligation<'tcx>>,
+    ) {
+        if !self.is_recording() {
+            return;
+        }
+        let Some(&node) = self.node_ids.get(&(obligation.param_env, obligation.predicate)) else {
+            self.incomplete = true;
+            return;
+        };
+        let nested = source
+            .borrow_nested_obligations()
+            .iter()
+            .copied()
+            .map(|obligation| self.node_for(obligation))
+            .collect();
+        let selection = CodegenTraitSelectionTrace { node, source: source.map(|_| ()), nested };
+        match self.trait_selections.iter().find(|existing| existing.node == node) {
+            Some(existing) if existing == &selection => {}
+            Some(_) => {
+                self.incomplete = true;
+            }
+            None => self.trait_selections.push(selection),
+        }
+    }
+
+    pub(crate) fn observe_projection(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+    ) {
+        self.projection_for(param_env, projection);
+    }
+
+    pub(crate) fn projection_has_result(
+        &self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+    ) -> bool {
+        self.projection_ids
+            .get(&(param_env, projection))
+            .is_some_and(|id| self.projections[id.0 as usize].result.is_some())
+    }
+
+    fn projection_for(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+    ) -> Option<ProjectionId> {
+        if !self.is_recording() {
+            return None;
+        }
+        let Some(owner) = self.current_owner else {
+            self.incomplete = true;
+            return None;
+        };
+        let key = (param_env, projection);
+        if let Some(&id) = self.projection_ids.get(&key) {
+            let owners = &mut self.projections[id.0 as usize].owners;
+            if !owners.contains(&owner) {
+                owners.push(owner);
+            }
+            return Some(id);
+        }
+        let id = ProjectionId(self.projections.len().try_into().unwrap());
+        self.projection_ids.insert(key, id);
+        self.projections.push(PendingProjection {
+            owners: vec![owner],
+            param_env,
+            projection,
+            source: None,
+            selected_trait_node: None,
+            selected_projection_item: None,
+            result: None,
+        });
+        Some(id)
+    }
+
+    pub(crate) fn record_projection_selected_trait(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+        obligation: CodegenProofObligation<'tcx>,
+    ) {
+        if !self.is_recording() {
+            return;
+        }
+        let node = self.node_for(obligation);
+        let Some(id) = self.projection_for(param_env, projection) else { return };
+        let entry = &mut self.projections[id.0 as usize];
+        match entry.selected_trait_node {
+            None => entry.selected_trait_node = Some(node),
+            Some(existing) if existing == node => {}
+            Some(_) => self.incomplete = true,
+        }
+    }
+
+    pub(crate) fn record_projection_leaf(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+        selected_projection_item: DefId,
+    ) {
+        if !self.is_recording() {
+            return;
+        }
+        let Some(id) = self.projection_for(param_env, projection) else { return };
+        let entry = &mut self.projections[id.0 as usize];
+        match entry.selected_projection_item {
+            None => entry.selected_projection_item = Some(selected_projection_item),
+            Some(existing) if existing == selected_projection_item => {}
+            Some(_) => {
+                self.incomplete = true;
+            }
+        }
+    }
+
+    pub(crate) fn record_projection_progress(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+        source: CodegenProjectionSource<'tcx>,
+        raw_term: ty::Term<'tcx>,
+        nested: impl IntoIterator<Item = CodegenProofObligation<'tcx>>,
+    ) {
+        if !self.is_recording() {
+            return;
+        }
+        let Some(id) = self.projection_for(param_env, projection) else { return };
+        let nested = nested.into_iter().map(|obligation| self.node_for(obligation)).collect();
+        let result = CodegenProjectionTraceResult::Progress { raw_term, nested };
+        let entry = &mut self.projections[id.0 as usize];
+        match (&entry.source, &entry.result) {
+            (None, None) => {
+                entry.source = Some(source);
+                entry.result = Some(result);
+            }
+            (Some(old_source), Some(old_result))
+                if old_source == &source && old_result == &result => {}
+            _ => {
+                self.incomplete = true;
+            }
+        }
+    }
+
+    pub(crate) fn record_projection_no_progress(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+        source: CodegenProjectionSource<'tcx>,
+        term: ty::Term<'tcx>,
+    ) {
+        if !self.is_recording() {
+            return;
+        }
+        let Some(id) = self.projection_for(param_env, projection) else { return };
+        let result = CodegenProjectionTraceResult::NoProgress(term);
+        let entry = &mut self.projections[id.0 as usize];
+        match (&entry.source, &entry.result) {
+            (None, None) => {
+                entry.source = Some(source);
+                entry.result = Some(result);
+            }
+            (Some(old_source), Some(old_result))
+                if old_source == &source && old_result == &result => {}
+            _ => {
+                self.incomplete = true;
+            }
+        }
+    }
+
+    pub(crate) fn record_fulfillment(
+        &mut self,
+        obligation: CodegenProofObligation<'tcx>,
+        nested: impl IntoIterator<Item = CodegenProofObligation<'tcx>>,
+    ) {
+        if !self.is_recording() {
+            return;
+        }
+        let node = self.node_for(obligation);
+        let nested = nested.into_iter().map(|obligation| self.node_for(obligation)).collect();
+        self.fulfillments.push(CodegenFulfillmentTrace { node, nested });
+    }
+
+    pub(crate) fn record_cycle(
+        &mut self,
+        cycle: impl IntoIterator<Item = CodegenProofObligation<'tcx>>,
+        coinductive: bool,
+    ) {
+        if !self.is_recording() {
+            return;
+        }
+        let nodes = cycle
+            .into_iter()
+            .map(|obligation| {
+                let key = (obligation.param_env, obligation.predicate);
+                match self.node_ids.get(&key) {
+                    Some(&node) => node,
+                    None => {
+                        self.incomplete = true;
+                        self.node_for(obligation)
+                    }
+                }
+            })
+            .collect();
+        self.cycles.push(CodegenCycleTrace { nodes, coinductive });
+    }
+
+    pub fn finish(
+        &self,
+        tcx: TyCtxt<'tcx>,
+        infcx: &InferCtxt<'tcx>,
+    ) -> Result<CodegenSolverTrace<'tcx>, CodegenSelectionProofError> {
+        if self.incomplete || self.muted != 0 {
+            return Err(CodegenSelectionProofError::IncompleteObservation);
+        }
+        let projections = self
+            .projections
+            .iter()
+            .map(|projection| {
+                Some(CodegenProjectionTrace {
+                    owners: projection.owners.clone(),
+                    param_env: projection.param_env,
+                    projection: projection.projection,
+                    source: projection.source.clone()?,
+                    selected_trait_node: projection.selected_trait_node,
+                    selected_projection_item: projection.selected_projection_item,
+                    result: projection.result.clone()?,
+                })
+            })
+            .collect::<Option<Vec<_>>>()
+            .ok_or(CodegenSelectionProofError::IncompleteObservation)?;
+        let trace = CodegenSolverTrace {
+            root: self.root,
+            obligations: self.obligations.clone(),
+            trait_selections: self.trait_selections.clone(),
+            projections,
+            fulfillments: self.fulfillments.clone(),
+            cycles: self.cycles.clone(),
+        };
+        let trace = tcx.erase_and_anonymize_regions(infcx.resolve_vars_if_possible(trace));
+        if trace.has_non_region_infer() {
+            return Err(CodegenSelectionProofError::IncompleteObservation);
+        }
+        canonicalize_trace(tcx, trace)
+    }
+}
+
+fn canonicalize_trace<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    mut trace: CodegenSolverTrace<'tcx>,
+) -> Result<CodegenSolverTrace<'tcx>, CodegenSelectionProofError> {
+    let mut obligation_ids = FxHashMap::default();
+    let mut obligations = Vec::new();
+    let mut remap = Vec::with_capacity(trace.obligations.len());
+    for obligation in std::mem::take(&mut trace.obligations) {
+        let node = if let Some(&node) = obligation_ids.get(&obligation) {
+            node
+        } else {
+            let node = CodegenProofNodeId(
+                obligations
+                    .len()
+                    .try_into()
+                    .map_err(|_| CodegenSelectionProofError::IncompleteObservation)?,
+            );
+            obligation_ids.insert(obligation, node);
+            obligations.push(obligation);
+            node
+        };
+        remap.push(node);
+    }
+    let hashes: Vec<Fingerprint> = tcx.with_stable_hashing_context(|mut hcx| {
+        obligations
+            .iter()
+            .map(|obligation| {
+                let mut hasher = StableHasher::new();
+                obligation.stable_hash(&mut hcx, &mut hasher);
+                hasher.finish()
+            })
+            .collect()
+    });
+    let mut order: Vec<_> = (0..obligations.len()).collect();
+    order.sort_by_key(|&index| hashes[index]);
+    if order.windows(2).any(|pair| {
+        hashes[pair[0]] == hashes[pair[1]] && obligations[pair[0]] != obligations[pair[1]]
+    }) {
+        return Err(CodegenSelectionProofError::IncompleteObservation);
+    }
+    let mut stable_ids = vec![CodegenProofNodeId(0); obligations.len()];
+    for (stable_index, &old_index) in order.iter().enumerate() {
+        stable_ids[old_index] = CodegenProofNodeId(
+            stable_index
+                .try_into()
+                .map_err(|_| CodegenSelectionProofError::IncompleteObservation)?,
+        );
+    }
+    for node in &mut remap {
+        *node = remap_node(&stable_ids, *node)?;
+    }
+    obligations = order.into_iter().map(|index| obligations[index]).collect();
+    trace.root = remap_node(&remap, trace.root)?;
+    trace.obligations = obligations;
+
+    for selection in &mut trace.trait_selections {
+        selection.node = remap_node(&remap, selection.node)?;
+        remap_nodes(&remap, &mut selection.nested)?;
+    }
+    let mut trait_selections: Vec<CodegenTraitSelectionTrace<'tcx>> = Vec::new();
+    for selection in std::mem::take(&mut trace.trait_selections) {
+        if let Some(existing) =
+            trait_selections.iter().find(|existing| existing.node == selection.node)
+        {
+            if existing != &selection {
+                return Err(CodegenSelectionProofError::IncompleteObservation);
+            }
+        } else {
+            trait_selections.push(selection);
+        }
+    }
+    trace.trait_selections = trait_selections;
+
+    for projection in &mut trace.projections {
+        remap_nodes(&remap, &mut projection.owners)?;
+        if let Some(node) = &mut projection.selected_trait_node {
+            *node = remap_node(&remap, *node)?;
+        }
+        projection.owners.sort_by_key(|node| node.0);
+        projection.owners.dedup();
+        if let CodegenProjectionTraceResult::Progress { nested, .. } = &mut projection.result {
+            remap_nodes(&remap, nested)?;
+        }
+    }
+    let mut projections: Vec<CodegenProjectionTrace<'tcx>> = Vec::new();
+    for mut projection in std::mem::take(&mut trace.projections) {
+        if let Some(existing) = projections.iter_mut().find(|existing| {
+            existing.param_env == projection.param_env
+                && existing.projection == projection.projection
+        }) {
+            if existing.source != projection.source
+                || existing.selected_trait_node != projection.selected_trait_node
+                || existing.selected_projection_item != projection.selected_projection_item
+                || existing.result != projection.result
+            {
+                return Err(CodegenSelectionProofError::IncompleteObservation);
+            }
+            existing.owners.append(&mut projection.owners);
+            existing.owners.sort_by_key(|node| node.0);
+            existing.owners.dedup();
+        } else {
+            projections.push(projection);
+        }
+    }
+    trace.projections = projections;
+
+    for fulfillment in &mut trace.fulfillments {
+        fulfillment.node = remap_node(&remap, fulfillment.node)?;
+        remap_nodes(&remap, &mut fulfillment.nested)?;
+    }
+    let mut fulfillments: Vec<CodegenFulfillmentTrace> = Vec::new();
+    for mut fulfillment in std::mem::take(&mut trace.fulfillments) {
+        if let Some(existing) =
+            fulfillments.iter_mut().find(|existing| existing.node == fulfillment.node)
+        {
+            existing.nested.append(&mut fulfillment.nested);
+            existing.nested.sort_by_key(|node| node.0);
+            existing.nested.dedup();
+        } else {
+            fulfillments.push(fulfillment);
+        }
+    }
+    trace.fulfillments = fulfillments;
+
+    for cycle in &mut trace.cycles {
+        remap_nodes(&remap, &mut cycle.nodes)?;
+    }
+    dedup_preserving_order(&mut trace.cycles);
+
+    validate_reachability(tcx, &trace)?;
+    Ok(trace)
+}
+
+fn remap_node(
+    remap: &[CodegenProofNodeId],
+    node: CodegenProofNodeId,
+) -> Result<CodegenProofNodeId, CodegenSelectionProofError> {
+    remap.get(node.0 as usize).copied().ok_or(CodegenSelectionProofError::IncompleteObservation)
+}
+
+fn remap_nodes(
+    remap: &[CodegenProofNodeId],
+    nodes: &mut Vec<CodegenProofNodeId>,
+) -> Result<(), CodegenSelectionProofError> {
+    for node in &mut *nodes {
+        *node = remap_node(remap, *node)?;
+    }
+    let mut deduped = Vec::with_capacity(nodes.len());
+    for node in std::mem::take(nodes) {
+        if !deduped.contains(&node) {
+            deduped.push(node);
+        }
+    }
+    *nodes = deduped;
+    Ok(())
+}
+
+fn dedup_preserving_order<T: PartialEq>(values: &mut Vec<T>) {
+    let mut deduped = Vec::with_capacity(values.len());
+    for value in std::mem::take(values) {
+        if !deduped.contains(&value) {
+            deduped.push(value);
+        }
+    }
+    *values = deduped;
+}
+
+fn validate_reachability<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    trace: &CodegenSolverTrace<'tcx>,
+) -> Result<(), CodegenSelectionProofError> {
+    if trace.projections.iter().any(|projection| {
+        matches!(projection.source, CodegenProjectionSource::Selected(ImplSource::UserDefined(_)))
+            != projection.selected_projection_item.is_some()
+    }) {
+        return Err(CodegenSelectionProofError::IncompleteObservation);
+    }
+    if trace.cycles.iter().any(|cycle| !cycle.coinductive) {
+        return Err(CodegenSelectionProofError::IncompleteObservation);
+    }
+    for projection in &trace.projections {
+        if matches!(projection.source, CodegenProjectionSource::NoApplicableCandidate)
+            && (!matches!(
+                projection.result,
+                CodegenProjectionTraceResult::NoProgress(term)
+                    if term == projection.projection.to_term(tcx, ty::IsRigid::No)
+            ))
+        {
+            return Err(CodegenSelectionProofError::IncompleteObservation);
+        }
+        match (&projection.source, projection.selected_trait_node) {
+            (CodegenProjectionSource::Selected(source), Some(node)) => {
+                let expected = CodegenProofObligation {
+                    param_env: projection.param_env,
+                    predicate: ty::Binder::dummy(projection.projection.trait_ref(tcx)).upcast(tcx),
+                };
+                if trace.obligations.get(node.0 as usize) != Some(&expected)
+                    || trace
+                        .trait_selections
+                        .iter()
+                        .find(|selection| selection.node == node)
+                        .map(|selection| &selection.source)
+                        != Some(source)
+                {
+                    return Err(CodegenSelectionProofError::IncompleteObservation);
+                }
+            }
+            (CodegenProjectionSource::Selected(_), None)
+            | (CodegenProjectionSource::ParamEnv(_), Some(_))
+            | (CodegenProjectionSource::TraitDef(_), Some(_))
+            | (CodegenProjectionSource::Object(_), Some(_))
+            | (CodegenProjectionSource::NoApplicableCandidate, Some(_)) => {
+                return Err(CodegenSelectionProofError::IncompleteObservation);
+            }
+            (CodegenProjectionSource::ParamEnv(_), None)
+            | (CodegenProjectionSource::TraitDef(_), None)
+            | (CodegenProjectionSource::Object(_), None)
+            | (CodegenProjectionSource::NoApplicableCandidate, None) => {}
+        }
+    }
+
+    let mut reached = vec![false; trace.obligations.len()];
+    let root = reached
+        .get_mut(trace.root.0 as usize)
+        .ok_or(CodegenSelectionProofError::IncompleteObservation)?;
+    *root = true;
+
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for selection in &trace.trait_selections {
+            if is_reached(&reached, selection.node)? {
+                changed |= mark_reached(&mut reached, &selection.nested)?;
+            }
+        }
+        for projection in &trace.projections {
+            let used = projection.owners.iter().try_fold(false, |used, &owner| {
+                Ok::<_, CodegenSelectionProofError>(used || is_reached(&reached, owner)?)
+            })?;
+            if used
+                && let CodegenProjectionTraceResult::Progress { nested, .. } = &projection.result
+            {
+                changed |= mark_reached(&mut reached, nested)?;
+            }
+            if used && let Some(node) = projection.selected_trait_node {
+                changed |= mark_reached(&mut reached, &[node])?;
+            }
+        }
+        for fulfillment in &trace.fulfillments {
+            if is_reached(&reached, fulfillment.node)? {
+                changed |= mark_reached(&mut reached, &fulfillment.nested)?;
+            }
+        }
+        for cycle in &trace.cycles {
+            let connected = cycle.nodes.iter().try_fold(false, |seen, &node| {
+                Ok::<_, CodegenSelectionProofError>(seen || is_reached(&reached, node)?)
+            })?;
+            if connected {
+                changed |= mark_reached(&mut reached, &cycle.nodes)?;
+            }
+        }
+    }
+
+    if !reached.into_iter().all(|reached| reached) {
+        return Err(CodegenSelectionProofError::IncompleteObservation);
+    }
+
+    for index in 0..trace.obligations.len() {
+        let node = CodegenProofNodeId(index.try_into().unwrap());
+        let has_transition = trace.trait_selections.iter().any(|fact| fact.node == node)
+            || trace.fulfillments.iter().any(|fact| fact.node == node)
+            || trace.cycles.iter().any(|cycle| cycle.nodes.contains(&node));
+        if !has_transition {
+            return Err(CodegenSelectionProofError::IncompleteObservation);
+        }
+    }
+    Ok(())
+}
+
+fn is_reached(
+    reached: &[bool],
+    node: CodegenProofNodeId,
+) -> Result<bool, CodegenSelectionProofError> {
+    reached.get(node.0 as usize).copied().ok_or(CodegenSelectionProofError::IncompleteObservation)
+}
+
+fn mark_reached(
+    reached: &mut [bool],
+    nodes: &[CodegenProofNodeId],
+) -> Result<bool, CodegenSelectionProofError> {
+    let mut changed = false;
+    for &node in nodes {
+        let slot = reached
+            .get_mut(node.0 as usize)
+            .ok_or(CodegenSelectionProofError::IncompleteObservation)?;
+        changed |= !*slot;
+        *slot = true;
+    }
+    Ok(changed)
+}
