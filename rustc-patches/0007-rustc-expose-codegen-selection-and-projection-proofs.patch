+++ b/tests/ui-fulldeps/auxiliary/selection-proof-trace-input.rs
@@ -0,0 +1,168 @@
+#![allow(dead_code)]
+
+trait Atom {}
+
+struct Value;
+impl Atom for Value {}
+
+struct Decoy;
+impl Atom for Decoy {}
+
+trait Other {
+    type X;
+}
+
+trait Supply {
+    type Item;
+}
+
+struct Source;
+
+type Callback = fn() -> Value;
+
+impl Other for Source {
+    type X = Value;
+}
+
+impl Supply for Source {
+    type Item = <Source as Other>::X;
+}
+
+trait Header {
+    type Key;
+}
+
+trait HeaderOnly<K> {
+    type Out;
+}
+
+trait Required {}
+
+impl Header for Source {
+    type Key = Value;
+}
+
+impl Required for Value {}
+
+impl HeaderOnly<<Source as Header>::Key> for Source
+where
+    Value: Required,
+{
+    type Out = Value;
+}
+
+trait Numbers {
+    const N: usize;
+}
+
+impl Numbers for Source {
+    const N: usize = 7;
+}
+
+trait HeaderRoot {}
+
+impl HeaderRoot for Source where <Source as HeaderOnly<Value>>::Out: Atom {}
+
+trait Shared {
+    type Out;
+}
+
+impl Shared for Source {
+    type Out = Value;
+}
+
+trait First {}
+trait Second {}
+
+impl First for Source where <Source as Shared>::Out: Atom {}
+impl Second for Source where <Source as Shared>::Out: Atom {}
+
+trait CacheRoot {}
+
+impl CacheRoot for Source where Source: First + Second {}
+
+trait BuiltinRoot {}
+
+impl<T> BuiltinRoot for Wrapper<T> where T: Sized {}
+
+trait ForAll<'a> {}
+
+impl<'a> ForAll<'a> for Source {}
+
+trait HrtbRoot {}
+
+impl<T> HrtbRoot for Wrapper<T> where for<'a> T: ForAll<'a> {}
+
+trait ObjectTrait {
+    type Item;
+}
+
+fn take_object(_: &dyn ObjectTrait<Item = Value>) {}
+
+trait ObjectRoot<T: ?Sized> {}
+
+impl<T: ?Sized> ObjectRoot<T> for Source
+where
+    T: ObjectTrait,
+    T::Item: Atom,
+{
+}
+
+trait ParamBound {}
+
+fn param_owner<T: ParamBound>() {}
+
+trait ParamEnvAssoc {
+    type Out;
+}
+
+trait ParamEnvRoot {}
+
+impl<T: ParamEnvAssoc> ParamEnvRoot for Wrapper<T> where T::Out: Atom {}
+
+fn param_env_owner<T: ParamEnvAssoc<Out = Value>>() {}
+
+trait TraitDefInner {
+    type Out;
+}
+
+trait TraitDefCarrier {
+    type Nested: TraitDefInner<Out = Value>;
+}
+
+trait TraitDefRoot {}
+
+impl<T: TraitDefCarrier> TraitDefRoot for Wrapper<T> where
+    <<T as TraitDefCarrier>::Nested as TraitDefInner>::Out: Atom
+{
+}
+
+fn trait_def_owner<T: TraitDefCarrier>() {}
+
+trait Execute {
+    fn execute(&self) -> usize {
+        1
+    }
+}
+
+struct Wrapper<T>(T);
+
+impl<T> Execute for Wrapper<T>
+where
+    T: Supply,
+    T::Item: Atom,
+{
+}
+
+struct Node(Option<Box<Node>>);
+
+fn assert_send<T: Send>() {}
+
+fn dispatch<T: Execute>(value: &T) -> usize {
+    value.execute()
+}
+
+fn main() {
+    assert_eq!(dispatch(&Wrapper(Source)), 1);
+    assert_send::<Node>();
+}
diff --git a/tests/ui-fulldeps/selection-proof-trace.rs b/tests/ui-fulldeps/selection-proof-trace.rs
new file mode 100644
index 00000000..de531d48
--- /dev/null
+++ b/tests/ui-fulldeps/selection-proof-trace.rs
@@ -0,0 +1,1071 @@
+//@ edition: 2024
+//@ run-pass
+//@ run-flags: --sysroot {{sysroot-base}} --edition=2024 {{src-base}}/auxiliary/selection-proof-trace-input.rs
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_data_structures;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_span;
+
+use std::process::ExitCode;
+use std::sync::{Arc, Mutex};
+
+use rustc_data_structures::fingerprint::Fingerprint;
+use rustc_data_structures::stable_hash::{StableHash, StableHasher};
+use rustc_driver::Compilation;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::DefId;
+use rustc_interface::interface::Compiler;
+use rustc_middle::traits::{
+    BuiltinImplSource, CodegenProjectionProof, CodegenProjectionProofError,
+    CodegenProjectionSource, CodegenProjectionTraceResult, CodegenSelectionProof,
+    CodegenSolverTrace, ImplSource,
+};
+use rustc_middle::ty::inherent::Term as _;
+use rustc_middle::ty::{self, Ty, TyCtxt, TypeVisitableExt};
+use rustc_span::{Symbol, sym};
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        let args: Vec<_> = std::env::args().collect();
+        let reports = Arc::new(Mutex::new(Vec::new()));
+        for prewarm in [false, true] {
+            rustc_driver::run_compiler(
+                &args,
+                &mut SelectionProofCallbacks { prewarm, reports: reports.clone() },
+            );
+        }
+        let reports = reports.lock().unwrap();
+        assert_eq!(reports.len(), 2);
+        assert_eq!(reports[0], reports[1]);
+    })
+}
+
+struct SelectionProofCallbacks {
+    prewarm: bool,
+    reports: Arc<Mutex<Vec<CanonicalRunReport>>>,
+}
+
+impl rustc_driver::Callbacks for SelectionProofCallbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+
+        let atom = named_def(tcx, "Atom", DefKind::Trait);
+        let other = named_def(tcx, "Other", DefKind::Trait);
+        let supply = named_def(tcx, "Supply", DefKind::Trait);
+        let execute = named_def(tcx, "Execute", DefKind::Trait);
+        let value = named_def(tcx, "Value", DefKind::Struct);
+        let decoy = named_def(tcx, "Decoy", DefKind::Struct);
+        let source = named_def(tcx, "Source", DefKind::Struct);
+        let wrapper = named_def(tcx, "Wrapper", DefKind::Struct);
+
+        let atom_value_impl = impl_for_adt(tcx, atom, value);
+        let atom_decoy_impl = impl_for_adt(tcx, atom, decoy);
+        let other_source_impl = impl_for_adt(tcx, other, source);
+        let supply_source_impl = impl_for_adt(tcx, supply, source);
+        let execute_wrapper_impl = impl_for_adt(tcx, execute, wrapper);
+
+        let source_ty = tcx.type_of(source).instantiate_identity().skip_norm_wip();
+        let wrapper_ty = Ty::new_adt(tcx, tcx.adt_def(wrapper), tcx.mk_args(&[source_ty.into()]));
+        let typing_env = ty::TypingEnv::fully_monomorphized();
+        let trait_ref = ty::TraitRef::new(tcx, execute, [wrapper_ty]);
+        let key = typing_env.as_query_input(trait_ref);
+
+        if self.prewarm {
+            let header_root = named_def(tcx, "HeaderRoot", DefKind::Trait);
+            let cache_root = named_def(tcx, "CacheRoot", DefKind::Trait);
+            let param_env_root = named_def(tcx, "ParamEnvRoot", DefKind::Trait);
+            let param_env_owner = named_def(tcx, "param_env_owner", DefKind::Fn);
+            let param_env_ty = ty::GenericArgs::identity_for_item(tcx, param_env_owner).type_at(0);
+            let param_env_wrapper_ty =
+                Ty::new_adt(tcx, tcx.adt_def(wrapper), tcx.mk_args(&[param_env_ty.into()]));
+            let trait_def_root = named_def(tcx, "TraitDefRoot", DefKind::Trait);
+            let trait_def_owner = named_def(tcx, "trait_def_owner", DefKind::Fn);
+            let trait_def_ty =
+                ty::GenericArgs::identity_for_item(tcx, trait_def_owner).type_at(0);
+            let trait_def_wrapper_ty =
+                Ty::new_adt(tcx, tcx.adt_def(wrapper), tcx.mk_args(&[trait_def_ty.into()]));
+            let node = named_def(tcx, "Node", DefKind::Struct);
+            let node_ty = tcx.type_of(node).instantiate_identity().skip_norm_wip();
+            let send = tcx.get_diagnostic_item(sym::Send).unwrap();
+            let value_ty = tcx.type_of(value).instantiate_identity().skip_norm_wip();
+            let supply_item = associated_item(tcx, supply, "Item");
+            let header_only = named_def(tcx, "HeaderOnly", DefKind::Trait);
+            let header_out = associated_item(tcx, header_only, "Out");
+            for goal in [
+                ty::AliasTerm::new_from_def_id(
+                    tcx,
+                    header_out,
+                    tcx.mk_args(&[source_ty.into(), value_ty.into()]),
+                ),
+                ty::AliasTerm::new_from_def_id(tcx, supply_item, tcx.mk_args(&[source_ty.into()])),
+            ] {
+                stock_normalize(tcx, typing_env, goal);
+            }
+            let param_env_assoc = named_def(tcx, "ParamEnvAssoc", DefKind::Trait);
+            let param_env_out = associated_item(tcx, param_env_assoc, "Out");
+            stock_normalize(
+                tcx,
+                ty::TypingEnv::codegen(tcx, param_env_owner),
+                ty::AliasTerm::new_from_def_id(
+                    tcx,
+                    param_env_out,
+                    tcx.mk_args(&[param_env_ty.into()]),
+                ),
+            );
+            let trait_def_carrier = named_def(tcx, "TraitDefCarrier", DefKind::Trait);
+            let trait_def_nested = associated_item(tcx, trait_def_carrier, "Nested");
+            stock_normalize(
+                tcx,
+                ty::TypingEnv::codegen(tcx, trait_def_owner),
+                ty::AliasTerm::new_from_def_id(
+                    tcx,
+                    trait_def_nested,
+                    tcx.mk_args(&[trait_def_ty.into()]),
+                ),
+            );
+            let object_trait = named_def(tcx, "ObjectTrait", DefKind::Trait);
+            let object_item = associated_item(tcx, object_trait, "Item");
+            let take_object = named_def(tcx, "take_object", DefKind::Fn);
+            let object_sig = tcx.fn_sig(take_object).instantiate_identity().skip_norm_wip();
+            let object_ref = tcx.instantiate_bound_regions_with_erased(object_sig).inputs()[0];
+            let ty::Ref(_, object_ty, _) = *object_ref.kind() else { unreachable!() };
+            stock_normalize(
+                tcx,
+                typing_env,
+                ty::AliasTerm::new_from_def_id(
+                    tcx,
+                    object_item,
+                    tcx.mk_args(&[object_ty.into()]),
+                ),
+            );
+            let callback = named_def(tcx, "Callback", DefKind::TyAlias);
+            let callback_ty = tcx.type_of(callback).instantiate_identity().skip_norm_wip();
+            let fn_once_output = tcx.lang_items().fn_once_output().unwrap();
+            stock_normalize(
+                tcx,
+                typing_env,
+                ty::AliasTerm::new_from_def_id(
+                    tcx,
+                    fn_once_output,
+                    tcx.mk_args(&[callback_ty.into(), tcx.types.unit.into()]),
+                ),
+            );
+            for prewarm_key in [
+                ty::TypingEnv::codegen(tcx, trait_def_owner).as_query_input(ty::TraitRef::new(
+                    tcx,
+                    trait_def_root,
+                    [trait_def_wrapper_ty],
+                )),
+                ty::TypingEnv::codegen(tcx, param_env_owner).as_query_input(ty::TraitRef::new(
+                    tcx,
+                    param_env_root,
+                    [param_env_wrapper_ty],
+                )),
+                typing_env.as_query_input(ty::TraitRef::new(tcx, send, [node_ty])),
+                typing_env.as_query_input(ty::TraitRef::new(tcx, cache_root, [source_ty])),
+                typing_env.as_query_input(ty::TraitRef::new(tcx, header_root, [source_ty])),
+                key,
+            ] {
+                tcx.codegen_select_candidate(prewarm_key).unwrap();
+            }
+        }
+
+        let proof = tcx.codegen_selection_proof(key).unwrap();
+        let cold_owned = proof.clone();
+        let warm_proof = tcx.codegen_selection_proof(key).unwrap();
+        assert!(std::ptr::eq(proof, warm_proof));
+        assert_eq!(cold_owned, *warm_proof);
+        assert_eq!(proof.top_source, *tcx.codegen_select_candidate(key).unwrap());
+        assert_eq!(
+            proof
+                .trace
+                .trait_selections
+                .iter()
+                .find(|selection| selection.node == proof.trace.root)
+                .unwrap()
+                .source,
+            proof.top_source
+        );
+
+        let mut selected_impls: Vec<_> = proof
+            .trace
+            .trait_selections
+            .iter()
+            .filter_map(|selection| match &selection.source {
+                ImplSource::UserDefined(data) => Some(data.impl_def_id),
+                ImplSource::Param(_) | ImplSource::Builtin(..) => None,
+            })
+            .collect();
+        selected_impls.sort_by_key(|def_id| (def_id.krate.as_u32(), def_id.index.as_u32()));
+        selected_impls.dedup();
+        let mut expected_impls =
+            vec![atom_value_impl, execute_wrapper_impl, supply_source_impl, other_source_impl];
+        expected_impls.sort_by_key(|def_id| (def_id.krate.as_u32(), def_id.index.as_u32()));
+        assert_eq!(selected_impls, expected_impls);
+        assert!(!selected_impls.contains(&atom_decoy_impl));
+
+        let supply_item = associated_item(tcx, supply, "Item");
+        let other_x = associated_item(tcx, other, "X");
+        let supply_item_impl = tcx.impl_item_implementor_ids(supply_source_impl)[&supply_item];
+        let other_x_impl = tcx.impl_item_implementor_ids(other_source_impl)[&other_x];
+        assert_eq!(proof.trace.projections.len(), 2, "{:#?}", proof.trace.projections);
+        let supply_projection = proof
+            .trace
+            .projections
+            .iter()
+            .find(|projection| projection.projection.expect_projection_def_id() == supply_item)
+            .unwrap();
+        assert!(matches!(
+            &supply_projection.source,
+            CodegenProjectionSource::Selected(ImplSource::UserDefined(data))
+                if data.impl_def_id == supply_source_impl
+        ));
+        assert_eq!(supply_projection.selected_projection_item, Some(supply_item_impl));
+        assert!(matches!(
+            &supply_projection.result,
+            CodegenProjectionTraceResult::Progress { raw_term, .. }
+                if matches!(raw_term.expect_ty().kind(), ty::Alias(_, alias) if alias.kind.try_to_projection() == Some(other_x))
+        ));
+
+        let other_projection = proof
+            .trace
+            .projections
+            .iter()
+            .find(|projection| projection.projection.expect_projection_def_id() == other_x)
+            .unwrap();
+        assert!(matches!(
+            &other_projection.source,
+            CodegenProjectionSource::Selected(ImplSource::UserDefined(data))
+                if data.impl_def_id == other_source_impl
+        ));
+        assert_eq!(other_projection.selected_projection_item, Some(other_x_impl));
+        assert!(matches!(
+            &other_projection.result,
+            CodegenProjectionTraceResult::Progress { raw_term, .. }
+                if raw_term.expect_ty() == tcx.type_of(value).instantiate_identity().skip_norm_wip()
+        ));
+
+        assert_eq!(supply_projection.owners, vec![proof.trace.root], "{:#?}", proof.trace);
+        assert_eq!(other_projection.owners, vec![proof.trace.root], "{:#?}", proof.trace);
+
+        for projection in [supply_projection, other_projection] {
+            let node = projection.selected_trait_node.unwrap();
+            let selection = proof
+                .trace
+                .trait_selections
+                .iter()
+                .find(|selection| selection.node == node)
+                .unwrap();
+            let obligation = &proof.trace.obligations[node.0 as usize];
+            assert_eq!(selection.source, match &projection.source {
+                CodegenProjectionSource::Selected(source) => source.clone(),
+                _ => unreachable!(),
+            });
+            assert_eq!(
+                obligation.predicate.as_trait_clause().unwrap().def_id(),
+                projection.projection.trait_def_id(tcx)
+            );
+        }
+
+        // The selected HeaderOnly impl has a projection in its header. This inner projection must
+        // come from the original committed rematch, not from speculative candidate search.
+        let header = named_def(tcx, "Header", DefKind::Trait);
+        let header_only = named_def(tcx, "HeaderOnly", DefKind::Trait);
+        let header_root = named_def(tcx, "HeaderRoot", DefKind::Trait);
+        let header_impl = impl_for_adt(tcx, header, source);
+        let header_only_impl = impl_for_adt(tcx, header_only, source);
+        let header_key = associated_item(tcx, header, "Key");
+        let header_out = associated_item(tcx, header_only, "Out");
+        let header_key_impl = tcx.impl_item_implementor_ids(header_impl)[&header_key];
+        let header_out_impl = tcx.impl_item_implementor_ids(header_only_impl)[&header_out];
+        let header_proof = tcx
+            .codegen_selection_proof(
+                typing_env.as_query_input(ty::TraitRef::new(tcx, header_root, [source_ty])),
+            )
+            .unwrap();
+        let header_out_projection = header_proof
+            .trace
+            .projections
+            .iter()
+            .find(|projection| projection.projection.expect_projection_def_id() == header_out)
+            .unwrap();
+        let header_key_projection = header_proof
+            .trace
+            .projections
+            .iter()
+            .find(|projection| projection.projection.expect_projection_def_id() == header_key)
+            .unwrap();
+        let mut header_projection_items: Vec<_> = header_proof
+            .trace
+            .projections
+            .iter()
+            .map(|projection| projection.projection.expect_projection_def_id())
+            .collect();
+        header_projection_items
+            .sort_by_key(|def_id| (def_id.krate.as_u32(), def_id.index.as_u32()));
+        let mut expected_header_projection_items = vec![header_out, header_key];
+        expected_header_projection_items
+            .sort_by_key(|def_id| (def_id.krate.as_u32(), def_id.index.as_u32()));
+        assert_eq!(header_projection_items, expected_header_projection_items);
+        assert!(matches!(
+            &header_out_projection.source,
+            CodegenProjectionSource::Selected(ImplSource::UserDefined(data))
+                if data.impl_def_id == header_only_impl
+        ));
+        assert_eq!(header_out_projection.selected_projection_item, Some(header_out_impl));
+        assert!(matches!(
+            &header_key_projection.source,
+            CodegenProjectionSource::Selected(ImplSource::UserDefined(data))
+                if data.impl_def_id == header_impl
+        ));
+        assert_eq!(header_key_projection.selected_projection_item, Some(header_key_impl));
+        assert_eq!(header_out_projection.owners, vec![header_proof.trace.root]);
+        assert_eq!(
+            header_key_projection.owners,
+            vec![header_out_projection.selected_trait_node.unwrap()],
+            "{:#?}",
+            header_proof.trace
+        );
+
+        // The same projection is normalized under two committed selection owners. A terminal
+        // cache hit must add the second owner without duplicating the projection fact.
+        let shared = named_def(tcx, "Shared", DefKind::Trait);
+        let first = named_def(tcx, "First", DefKind::Trait);
+        let second = named_def(tcx, "Second", DefKind::Trait);
+        let cache_root = named_def(tcx, "CacheRoot", DefKind::Trait);
+        let shared_impl = impl_for_adt(tcx, shared, source);
+        let shared_out = associated_item(tcx, shared, "Out");
+        let shared_out_impl = tcx.impl_item_implementor_ids(shared_impl)[&shared_out];
+        let cache_proof = tcx
+            .codegen_selection_proof(
+                typing_env.as_query_input(ty::TraitRef::new(tcx, cache_root, [source_ty])),
+            )
+            .unwrap();
+        let shared_projection = cache_proof
+            .trace
+            .projections
+            .iter()
+            .find(|projection| projection.projection.expect_projection_def_id() == shared_out)
+            .unwrap();
+        assert_eq!(cache_proof.trace.projections.len(), 1);
+        assert_eq!(shared_projection.projection.expect_projection_def_id(), shared_out);
+        let mut expected_owners: Vec<_> = [first, second]
+            .into_iter()
+            .map(|trait_id| {
+                cache_proof
+                    .trace
+                    .obligations
+                    .iter()
+                    .position(|obligation| {
+                        obligation
+                            .predicate
+                            .as_trait_clause()
+                            .is_some_and(|predicate| predicate.def_id() == trait_id)
+                    })
+                    .map(|index| rustc_middle::traits::CodegenProofNodeId(index.try_into().unwrap()))
+                    .unwrap()
+            })
+            .collect();
+        expected_owners.sort_by_key(|node| node.0);
+        assert_eq!(shared_projection.owners, expected_owners, "{:#?}", cache_proof.trace);
+        assert!(matches!(
+            &shared_projection.source,
+            CodegenProjectionSource::Selected(ImplSource::UserDefined(data))
+                if data.impl_def_id == shared_impl
+        ));
+        assert_eq!(shared_projection.selected_projection_item, Some(shared_out_impl));
+
+        let builtin_root = named_def(tcx, "BuiltinRoot", DefKind::Trait);
+        let sized = tcx.lang_items().sized_trait().unwrap();
+        let builtin_proof = tcx
+            .codegen_selection_proof(
+                typing_env.as_query_input(ty::TraitRef::new(tcx, builtin_root, [wrapper_ty])),
+            )
+            .unwrap();
+        let sized_node = builtin_proof
+            .trace
+            .obligations
+            .iter()
+            .position(|obligation| {
+                obligation
+                    .predicate
+                    .as_trait_clause()
+                    .is_some_and(|predicate| predicate.def_id() == sized)
+            })
+            .unwrap();
+        assert!(matches!(
+            builtin_proof
+                .trace
+                .trait_selections
+                .iter()
+                .find(|selection| selection.node.0 as usize == sized_node)
+                .unwrap()
