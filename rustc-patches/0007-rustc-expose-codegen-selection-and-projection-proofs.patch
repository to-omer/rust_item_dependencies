+        .ok_or(CodegenProjectionProofError::IncompleteObservation)?;
+    let root_clause = root_clause.skip_binder();
+    if root_clause.projection_term != tcx.erase_and_anonymize_regions(goal)
+        || root_clause.term != normalized_term
+        || !trace.projections.iter().any(|projection| {
+            projection.projection == tcx.erase_and_anonymize_regions(goal)
+                && projection.owners.contains(&trace.root)
+        })
+    {
+        return Err(CodegenProjectionProofError::IncompleteObservation);
+    }
+
+    Ok(tcx.arena.alloc(CodegenProjectionProof { normalized_term, trace }))
+}
+
 /// If `normalized_term` is a const, returns a `ConstArgHasType` obligation
 /// to verify that the const value's type matches the alias's declared type.
 /// Returns `None` if the term is a type rather than a const.
diff --git a/tests/ui-fulldeps/auxiliary/selection-proof-trace-input.rs b/tests/ui-fulldeps/auxiliary/selection-proof-trace-input.rs
