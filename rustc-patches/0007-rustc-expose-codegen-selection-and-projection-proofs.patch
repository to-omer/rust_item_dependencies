+    pub obligations: Vec<CodegenProofObligation<'tcx>>,
+    pub trait_selections: Vec<CodegenTraitSelectionTrace<'tcx>>,
+    pub projections: Vec<CodegenProjectionTrace<'tcx>>,
+    pub fulfillments: Vec<CodegenFulfillmentTrace>,
+    pub cycles: Vec<CodegenCycleTrace>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, StableHash)]
+#[derive(TypeVisitable, TypeFoldable)]
+pub struct CodegenTraitSelectionTrace<'tcx> {
