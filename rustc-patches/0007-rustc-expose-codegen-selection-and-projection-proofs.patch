+/// Re-runs the old solver in an isolated inference context and records only the committed selected
+/// proof. The compiler-facing, disk-cached selection query above remains unmodified and
+/// authoritative; this observer fails closed if its top-level result differs.
+pub(crate) fn codegen_selection_proof<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    key: PseudoCanonicalInput<'tcx, ty::TraitRef<'tcx>>,
+) -> Result<&'tcx CodegenSelectionProof<'tcx>, CodegenSelectionProofError> {
+    let stock_source =
+        tcx.codegen_select_candidate(key).map_err(CodegenSelectionProofError::Selection)?.clone();
+
+    let PseudoCanonicalInput { typing_env, value: trait_ref } = key;
+    tcx.debug_assert_fully_normalized(typing_env, trait_ref);
+
+    let (infcx, param_env) = tcx.infer_ctxt().ignoring_regions().build_with_typing_env(typing_env);
+    let root_predicate = ty::Binder::dummy(trait_ref).upcast(tcx);
+    let recorder = CodegenProofRecorder::shared(param_env, root_predicate);
+    let mut selcx = SelectionContext::with_codegen_proof_recorder(&infcx, recorder.clone());
+    let obligation = Obligation::new(tcx, ObligationCause::dummy(), param_env, trait_ref);
+    let selection = match selcx.select(&obligation) {
+        Ok(Some(selection)) => selection,
+        Ok(None) | Err(_) => return Err(CodegenSelectionProofError::IncompleteObservation),
+    };
+
+    let ocx = ObligationCtxt::new_with_codegen_proof(&infcx, recorder.clone());
+    let proof_source = selection.map(|obligation| ocx.register_obligation(obligation));
+    if !ocx.evaluate_obligations_error_on_ambiguity().no_errors() {
+        return Err(CodegenSelectionProofError::IncompleteObservation);
+    }
+
+    let proof_source = infcx.resolve_vars_if_possible(proof_source);
+    let proof_source = tcx.erase_and_anonymize_regions(proof_source);
+    if proof_source.has_non_region_infer() || proof_source != stock_source {
+        return Err(CodegenSelectionProofError::IncompleteObservation);
+    }
+
+    let trace = recorder.borrow().finish(tcx, &infcx)?;
+    if trace
+        .trait_selections
+        .iter()
+        .find(|selection| selection.node == trace.root)
+        .map(|selection| &selection.source)
+        != Some(&stock_source)
+    {
+        return Err(CodegenSelectionProofError::IncompleteObservation);
+    }
+
+    Ok(tcx.arena.alloc(CodegenSelectionProof { top_source: stock_source, trace }))
+}
