diff --git a/tests/ui-fulldeps/typeck-impl-dependencies-for-loop.rs b/tests/ui-fulldeps/typeck-impl-dependencies-for-loop.rs
new file mode 100644
index 00000000..fbb2370f
--- /dev/null
+++ b/tests/ui-fulldeps/typeck-impl-dependencies-for-loop.rs
@@ -0,0 +1,81 @@
+//@ edition: 2024
+//@ run-pass
+//@ run-flags: --sysroot {{sysroot-base}} --edition=2024 {{src-base}}/auxiliary/typeck-impl-dependencies-for-loop-input.rs
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+
+use std::process::ExitCode;
+
+use rustc_driver::Compilation;
+use rustc_hir::intravisit::{self, Visitor};
+use rustc_hir::{Expr, ExprKind, HirId, QPath};
+use rustc_interface::interface::Compiler;
+use rustc_middle::ty::{TyCtxt, TypeVisitableExt};
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        let args: Vec<_> = std::env::args().collect();
+        rustc_driver::run_compiler(&args, &mut Callbacks);
+    })
+}
+
+struct Callbacks;
+
+impl rustc_driver::Callbacks for Callbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+
+        let cold = tcx.typeck_impl_dependencies(()).unwrap();
+        let warm = tcx.typeck_impl_dependencies(()).unwrap();
+        assert!(std::ptr::eq(cold, warm));
+        assert!(cold.is_empty(), "external iterator impls must not produce local dependencies");
+
+        let main = tcx.entry_fn(()).unwrap().0.expect_local();
+        let results = tcx.typeck(main);
+        let mut paths = ResolvedAssociatedPaths::default();
+        paths.visit_expr(tcx.hir_body_owned_by(main).value);
+        let mut names = Vec::new();
+        for (item, hir_id) in paths.items {
+            if tcx.trait_of_assoc(item).is_none() {
+                continue;
+            }
+            let args = results
+                .node_args_opt(hir_id)
+                .expect("a desugared associated path must retain its finalized arguments");
+            assert!(!args.has_non_region_infer());
+            assert!(!args.has_escaping_bound_vars());
+            names.push(tcx.def_path_str(item));
+        }
+        names.sort();
+        assert_eq!(
+            names,
+            ["std::iter::IntoIterator::into_iter", "std::iter::Iterator::next"]
+        );
+
+        Compilation::Stop
+    }
+}
+
+#[derive(Default)]
+struct ResolvedAssociatedPaths {
+    items: Vec<(rustc_hir::def_id::DefId, HirId)>,
+}
+
+impl<'tcx> Visitor<'tcx> for ResolvedAssociatedPaths {
+    fn visit_expr(&mut self, expression: &'tcx Expr<'tcx>) {
+        if let ExprKind::Path(QPath::Resolved(_, path)) = expression.kind
+            && let Some(item) = path.res.opt_def_id()
+        {
+            self.items.push((item, expression.hir_id));
+        }
+        intravisit::walk_expr(self, expression);
+    }
+}
