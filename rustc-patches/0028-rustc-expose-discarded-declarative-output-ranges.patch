+        let discarded_outputs = (0..COUNT)
+            .map(|index| range(COUNT + 2 * index, COUNT + 2 * index + 1))
+            .collect::<Vec<_>>();
+        let mut work = 0;
+        assert!(discarded_outputs_fit_products(&discarded_outputs, &products, || work += 1));
+        assert!(work <= 3 * discarded_outputs.len() + 3 * products.len(), "work: {work}");
+
