+#[derive(Default)]
+struct CfgComponentRangeCache {
+    by_scope: FxHashMap<u32, CfgComponentRanges>,
+}
+
+impl CfgComponentRangeCache {
+    fn insert(&mut self, range: &MacroParserRange) {
+        if range.cfg_components.is_empty() {
+            return;
+        }
+        self.by_scope
+            .entry(range.scope)
+            .or_insert_with(|| CfgComponentRanges::new(&range.cfg_components));
+    }
+
+    fn get(
+        &self,
+        range: &MacroParserRange,
+        attr: rustc_span::AttrId,
+    ) -> Option<MacroParserSubrange> {
+        self.by_scope.get(&range.scope)?.get(attr)
+    }
+}
+
+#[derive(Default)]
+struct CfgComponentRanges {
+    by_attr: FxHashMap<rustc_span::AttrId, Option<MacroParserSubrange>>,
+}
+
+impl CfgComponentRanges {
+    fn new<'c>(components: impl IntoIterator<Item = &'c MacroParserCfgRange>) -> Self {
+        let mut ranges = Self::default();
+        for component in components {
+            ranges.insert(component);
+        }
+        ranges
+    }
+
+    fn insert(&mut self, component: &MacroParserCfgRange) {
+        let candidate =
+            MacroParserSubrange { range: component.range.clone(), complete: component.complete };
+        match self.by_attr.entry(component.attr) {
+            std::collections::hash_map::Entry::Vacant(entry) => {
+                entry.insert(Some(candidate));
+            }
+            std::collections::hash_map::Entry::Occupied(mut entry) => {
+                let Some(current) = entry.get_mut() else { return };
+                let current_range = &current.range.0;
+                let candidate_range = &candidate.range.0;
+                if current_range.start == candidate_range.start
+                    && current_range.end == candidate_range.end
+                {
+                    current.complete |= candidate.complete;
+                } else if candidate_range.start <= current_range.start
+                    && current_range.end <= candidate_range.end
+                {
+                    *current = candidate;
+                } else if !(current_range.start <= candidate_range.start
+                    && candidate_range.end <= current_range.end)
+                {
+                    entry.insert(None);
+                }
+            }
+        }
+    }
+
+    fn get_with_work(
+        &self,
+        attr: rustc_span::AttrId,
+        record_lookup: impl FnOnce(),
+    ) -> Option<MacroParserSubrange> {
+        record_lookup();
+        self.by_attr.get(&attr).cloned().flatten().filter(|range| range.complete)
+    }
+
+    fn get(&self, attr: rustc_span::AttrId) -> Option<MacroParserSubrange> {
+        self.get_with_work(attr, || {})
+    }
+}
+
+fn replace_inherited_macro_range(
+    inherited: &mut Option<MacroParserRange>,
+    own: Option<&MacroParserRange>,
+) -> Option<Option<MacroParserRange>> {
+    let own = own?.clone();
+    Some(inherited.replace(own))
+}
