+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+
+    use rustc_ast::tokenstream::ParserRange;
+    use rustc_span::AttrId;
+
+    use super::*;
+
+    fn cfg_component(attr: u32, start: u32, end: u32, complete: bool) -> MacroParserCfgRange {
+        MacroParserCfgRange {
+            attr: AttrId::from_u32(attr),
+            range: ParserRange(start..end),
+            complete,
+        }
+    }
+
+    #[test]
+    fn cfg_component_ranges_preserve_fail_closed_normalization() {
+        let components = [
+            cfg_component(0, 2, 4, true),
+            cfg_component(0, 1, 5, false),
+            cfg_component(0, 1, 5, true),
+            cfg_component(1, 10, 20, true),
+            cfg_component(1, 12, 18, true),
+            cfg_component(2, 20, 30, true),
+            cfg_component(2, 25, 35, true),
+            cfg_component(3, 40, 45, true),
+            cfg_component(3, 50, 55, true),
+            cfg_component(4, 60, 65, false),
+        ];
+
+        let ranges = CfgComponentRanges::new(&components);
+        let outer = ranges.get(AttrId::from_u32(0)).unwrap();
+        assert_eq!(outer.range.0, 1..5);
+        let containing = ranges.get(AttrId::from_u32(1)).unwrap();
+        assert_eq!(containing.range.0, 10..20);
+        assert!(ranges.get(AttrId::from_u32(2)).is_none());
+        assert!(ranges.get(AttrId::from_u32(3)).is_none());
+        assert!(ranges.get(AttrId::from_u32(4)).is_none());
+    }
+
+    #[test]
+    fn cfg_component_range_cache_keeps_each_parser_scope() {
+        let root = MacroParserRange {
+            scope: 1,
+            range: ParserRange(0..20),
+            complete: true,
+            use_trees: Vec::new(),
+            macro_calls: Vec::new(),
+            cfg_components: vec![cfg_component(0, 0, 10, true)].into(),
+        };
+        let item = MacroParserRange {
+            scope: 2,
+            range: ParserRange(20..40),
+            complete: true,
+            use_trees: Vec::new(),
+            macro_calls: Vec::new(),
+            cfg_components: vec![cfg_component(1, 20, 30, true)].into(),
+        };
+        let mut cache = CfgComponentRangeCache::default();
+        cache.insert(&root);
+        cache.insert(&item);
+
+        assert_eq!(cache.get(&root, AttrId::from_u32(0)).unwrap().range.0, 0..10);
+        assert!(cache.get(&root, AttrId::from_u32(1)).is_none());
+        assert_eq!(cache.get(&item, AttrId::from_u32(1)).unwrap().range.0, 20..30);
+        assert!(cache.get(&item, AttrId::from_u32(0)).is_none());
+    }
+
+    #[test]
+    fn empty_cfg_component_scopes_are_not_cached() {
+        let range = MacroParserRange {
+            scope: 1,
+            range: ParserRange(0..10),
+            complete: true,
+            use_trees: Vec::new(),
+            macro_calls: Vec::new(),
+            cfg_components: Default::default(),
+        };
+        let mut cache = CfgComponentRangeCache::default();
+        cache.insert(&range);
+        assert!(cache.by_scope.is_empty());
+    }
+
+    #[test]
+    fn absent_node_ranges_do_not_clone_or_replace_the_inherited_range() {
+        let mut inherited = Some(MacroParserRange {
+            scope: 1,
+            range: ParserRange(0..10),
+            complete: true,
+            use_trees: Vec::new(),
+            macro_calls: Vec::new(),
+            cfg_components: vec![cfg_component(0, 0, 10, true)].into(),
+        });
+        let components = inherited.as_ref().unwrap().cfg_components.as_ptr();
+
+        assert!(replace_inherited_macro_range(&mut inherited, None).is_none());
+        assert_eq!(inherited.as_ref().unwrap().cfg_components.as_ptr(), components);
+    }
+
+    #[test]
+    fn large_cfg_component_lists_use_one_index_lookup_per_attribute() {
+        const COMPONENT_COUNT: u32 = 4_096;
+        let components = (0..COMPONENT_COUNT)
+            .map(|index| cfg_component(index, index * 2, index * 2 + 1, true))
+            .collect::<Vec<_>>();
+        let ranges = CfgComponentRanges::new(&components);
+        let lookup_work = Cell::new(0);
+
+        for index in 0..COMPONENT_COUNT {
+            let range = ranges
+                .get_with_work(AttrId::from_u32(index), || {
+                    lookup_work.set(lookup_work.get() + 1);
+                })
+                .unwrap();
+            assert_eq!(range.range.0, index * 2..index * 2 + 1);
+        }
+        assert_eq!(lookup_work.get(), COMPONENT_COUNT);
+    }
+}
