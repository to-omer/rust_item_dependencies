+#[cfg(test)]
+mod tests {
+    use super::{MacroOutputTokenRange, discarded_outputs_fit_products};
+
+    fn range(start: u32, end: u32) -> MacroOutputTokenRange {
+        MacroOutputTokenRange { start, end }
+    }
+
+    fn products(ranges: &[(u32, u32)]) -> Vec<(MacroOutputTokenRange, bool, bool)> {
+        ranges.iter().map(|&(start, end)| (range(start, end), true, false)).collect()
+    }
+
+    #[test]
+    fn adjacent_discarded_outputs_must_not_cover_a_product() {
+        let product = products(&[(0, 4)]);
+        assert!(!discarded_outputs_fit_products(&[range(0, 2), range(2, 4)], &product, || {}));
+        assert!(discarded_outputs_fit_products(&[range(0, 1), range(2, 4)], &product, || {}));
+        assert!(discarded_outputs_fit_products(&[range(1, 2), range(2, 3)], &product, || {}));
+
+        let separate_products = products(&[(0, 3), (3, 6)]);
+        assert!(discarded_outputs_fit_products(
+            &[range(1, 3), range(3, 5)],
+            &separate_products,
+            || {}
+        ));
+    }
+
+    #[test]
+    fn discarded_output_product_validation_is_linear() {
+        const COUNT: u32 = 1024;
+        let products =
