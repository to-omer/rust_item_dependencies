+/// Checks that every discarded output range is either disjoint from a product or strictly nested
+/// in it. `discarded_outputs` must be sorted and disjoint, and `products` must be sorted by start
+/// and reverse end and form a laminar family.
+///
+/// Adjacent discarded ranges remain separate observations, but their contiguous union must not
+/// cover an entire product. Otherwise the product would be classified as live even though none of
+/// its output survives configuration.
+fn discarded_outputs_fit_products(
+    discarded_outputs: &[MacroOutputTokenRange],
+    products: &[(MacroOutputTokenRange, bool, bool)],
+    mut record_work: impl FnMut(),
+) -> bool {
+    let mut next_product = 0;
+    let mut containing_products = Vec::<MacroOutputTokenRange>::new();
+    for discarded in discarded_outputs {
+        record_work();
+        while let Some((product, _, _)) = products.get(next_product)
+            && product.start <= discarded.start
+        {
+            record_work();
+            while containing_products.last().is_some_and(|parent| parent.end <= product.start) {
+                record_work();
+                containing_products.pop();
+            }
+            containing_products.push(*product);
+            next_product += 1;
+        }
+        while containing_products.last().is_some_and(|product| product.end <= discarded.start) {
+            record_work();
+            containing_products.pop();
+        }
+
+        if containing_products.last().is_some_and(|product| {
+            discarded.end > product.end
+                || (product.start == discarded.start && product.end == discarded.end)
+        }) {
+            return false;
+        }
+        // A product beginning inside the discarded range cannot contain that range. Laminarity
+        // means no later product can make this overlap valid.
+        if products.get(next_product).is_some_and(|(product, _, _)| product.start < discarded.end) {
+            return false;
+        }
+    }
+
+    let mut contiguous_discarded = Vec::<MacroOutputTokenRange>::new();
+    for discarded in discarded_outputs {
+        record_work();
+        if let Some(previous) = contiguous_discarded.last_mut()
+            && previous.end == discarded.start
+        {
+            previous.end = discarded.end;
+        } else {
+            contiguous_discarded.push(*discarded);
+        }
+    }
+
+    let mut next_discarded = 0;
+    for (product, _, _) in products {
+        record_work();
+        while contiguous_discarded
+            .get(next_discarded)
+            .is_some_and(|discarded| discarded.end <= product.start)
+        {
+            record_work();
+            next_discarded += 1;
+        }
+        if contiguous_discarded.get(next_discarded).is_some_and(|discarded| {
+            discarded.start <= product.start && product.end <= discarded.end
+        }) {
+            return false;
+        }
+    }
+
+    true
+}
