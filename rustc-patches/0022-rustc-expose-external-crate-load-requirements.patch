+struct LocalActivationCallbacks;
+
+impl Callbacks for LocalActivationCallbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+        let panic_runtime = tcx
+            .compiler_generated_crate_activations(())
+            .iter()
+            .find(|activation| {
+                tcx.compiler_metadata_providers(activation.load.crate_num)
+                    .contains(&CompilerMetadataProvider::PanicRuntime)
+            })
+            .expect("panic runtime activation must be recorded");
+        assert_eq!(panic_runtime.condition, None);
+        Compilation::Stop
+    }
+}
+
+fn only_path_load(
+    tcx: TyCtxt<'_>,
+    activations: &[rustc_middle::ty::ExternPreludePathActivation],
+    crate_name: &str,
+) -> rustc_middle::ty::ExternalCrateLoad {
+    let crate_num = crate_num(tcx, crate_name);
+    let loads = activations
+        .iter()
+        .filter(|activation| activation.load.crate_num == crate_num)
+        .map(|activation| activation.load)
+        .collect::<BTreeSet<_>>();
+    let mut loads = loads.into_iter();
+    let load = loads
+        .next()
+        .unwrap_or_else(|| panic!("expected a load for `{crate_name}`"));
+    assert!(loads.next().is_none(), "expected one load for `{crate_name}`");
+    load
+}
+
+fn dependency_kind(
+    tcx: TyCtxt<'_>,
+    dependencies: &[rustc_middle::ty::ExternalCrateDependency],
+    crate_name: &str,
+) -> CrateDepKind {
+    dependencies
+        .iter()
+        .find(|dependency| tcx.crate_name(dependency.crate_num).as_str() == crate_name)
+        .unwrap_or_else(|| panic!("dependency `{crate_name}` was not observed"))
+        .kind
+}
+
+fn crate_num(tcx: TyCtxt<'_>, name: &str) -> CrateNum {
+    tcx.crates(())
+        .iter()
+        .copied()
+        .find(|&crate_num| tcx.crate_name(crate_num).as_str() == name)
+        .unwrap_or_else(|| panic!("crate `{name}` was not loaded"))
+}
+
+fn crate_names(tcx: TyCtxt<'_>, crates: impl Iterator<Item = CrateNum>) -> BTreeSet<String> {
+    crates
+        .map(|crate_num| tcx.crate_name(crate_num).to_string())
+        .collect()
+}
+
+fn compile_rlib(
+    sysroot: &Path,
+    linker: Option<&Path>,
+    tmp: &Path,
+    crate_name: &str,
+    source: &str,
+    extra: &[String],
+) -> PathBuf {
+    let input = tmp.join(format!("{crate_name}.rs"));
+    let output = tmp.join(format!("lib{crate_name}.rlib"));
+    std::fs::write(&input, source).unwrap();
+    let mut extra = extra.to_vec();
+    extra.extend(["--crate-type=rlib".to_string(), "--emit=link".to_string()]);
+    compile(
+        rustc_args(sysroot, linker, &input, &output, crate_name, &mut extra),
+        &mut DefaultCallbacks,
+    );
+    output
+}
+
+fn compile_proc_macro(
+    sysroot: &Path,
+    linker: Option<&Path>,
+    tmp: &Path,
+    crate_name: &str,
+    source: &str,
+) -> PathBuf {
+    let input = tmp.join(format!("{crate_name}.rs"));
+    let output = tmp.join(format!(
+        "{prefix}{crate_name}.{extension}",
+        prefix = if cfg!(target_os = "windows") { "" } else { "lib" },
+        extension = if cfg!(target_os = "macos") {
+            "dylib"
+        } else if cfg!(target_os = "windows") {
+            "dll"
+        } else if cfg!(target_os = "aix") {
+            "a"
+        } else {
+            "so"
+        }
+    ));
+    std::fs::write(&input, source).unwrap();
+    let mut extra = vec!["--crate-type=proc-macro".to_string(), "--emit=link".to_string()];
+    compile(
+        rustc_args(sysroot, linker, &input, &output, crate_name, &mut extra),
+        &mut DefaultCallbacks,
+    );
+    output
+}
+
+fn extern_arg(crate_name: &str, path: &Path) -> String {
+    format!("--extern={crate_name}={}", path.display())
+}
+
+fn rustc_args(
+    sysroot: &Path,
+    linker: Option<&Path>,
+    input: &Path,
+    output: &Path,
+    crate_name: &str,
+    extra: &mut Vec<String>,
+) -> Vec<String> {
+    let mut args = vec![
+        "rustc".to_string(),
+        format!("--sysroot={}", sysroot.display()),
+        "--edition=2024".to_string(),
+        format!("--crate-name={crate_name}"),
+        "-Zunstable-options".to_string(),
+        input.display().to_string(),
+        "-o".to_string(),
+        output.display().to_string(),
+    ];
+    if let Some(linker) = linker {
+        args.push(format!("-Clinker={}", linker.display()));
+    }
+    args.append(extra);
+    args
+}
+
+fn compile(args: Vec<String>, callbacks: &mut (dyn Callbacks + Send)) {
+    rustc_driver::run_compiler(&args, callbacks);
+}
