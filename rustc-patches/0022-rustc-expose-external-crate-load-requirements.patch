+    pub(crate) fn crate_dependency_closure(
+        &self,
+        root: ExternalCrateLoad,
+    ) -> Vec<ExternalCrateDependency> {
+        let mut effective = BTreeMap::new();
+        let mut work = vec![(root.crate_num, root.kind)];
+        while let Some((crate_num, kind)) = work.pop() {
+            if effective.get(&crate_num).is_some_and(|existing| *existing >= kind) {
+                continue;
+            }
+            effective.insert(crate_num, kind);
+            let data = self.get_crate_data(crate_num);
+            // Proc-macro dependencies belong to the host dylib and are not mapped into the target
+            // crate's CStore. The proc-macro crate itself is the complete target-side load.
+            if data.is_proc_macro_crate() {
+                continue;
+            }
+            for (dependency, edge_kind) in data.dependencies_with_kinds() {
+                let dependency_kind = if kind == CrateDepKind::MacrosOnly {
+                    CrateDepKind::MacrosOnly
+                } else {
+                    edge_kind
+                };
+                work.push((dependency, dependency_kind));
+            }
+        }
+        effective
+            .into_iter()
+            .map(|(crate_num, kind)| ExternalCrateDependency { crate_num, kind })
+            .collect()
+    }
+
+    pub(crate) fn source_free_crate_activations(
+        &self,
+    ) -> impl Iterator<Item = ExternalCrateLoad> + '_ {
+        self.source_free_crate_activations.iter().copied()
+    }
+
+    pub(crate) fn compiler_generated_crate_activations(
+        &self,
+    ) -> impl Iterator<Item = CompilerGeneratedCrateActivation> + '_ {
+        self.compiler_generated_crate_activations.iter().copied()
+    }
+
+    pub fn direct_activation_kind(
+        &self,
+        crate_num: CrateNum,
+        requested: CrateDepKind,
+    ) -> CrateDepKind {
+        if self.get_crate_data(crate_num).is_proc_macro_crate() {
+            CrateDepKind::MacrosOnly
+        } else {
+            requested
+        }
+    }
+
+    fn record_source_free_activation(&mut self, crate_num: CrateNum, requested: CrateDepKind) {
+        let load = ExternalCrateLoad {
+            crate_num,
+            kind: self.direct_activation_kind(crate_num, requested),
+        };
+        if !self.source_free_crate_activations.contains(&load) {
+            self.source_free_crate_activations.push(load);
+        }
+    }
+
+    fn record_compiler_generated_activation(
+        &mut self,
+        crate_num: CrateNum,
+        requested: CrateDepKind,
+        condition: Option<CrateNum>,
+    ) {
+        let activation = CompilerGeneratedCrateActivation {
+            load: ExternalCrateLoad {
+                crate_num,
+                kind: self.direct_activation_kind(crate_num, requested),
+            },
+            condition,
+        };
+        if !self.compiler_generated_crate_activations.contains(&activation) {
+            self.compiler_generated_crate_activations.push(activation);
+        }
+    }
