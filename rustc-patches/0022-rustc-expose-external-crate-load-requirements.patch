+        "--emit=metadata".to_string(),
+    ];
+    compile(
+        rustc_args(
+            sysroot,
+            linker,
+            &local_client,
+            &tmp.join("local-client.rmeta"),
+            "local_client",
+            &mut local_extra,
+        ),
+        &mut LocalActivationCallbacks,
+    );
+}
+
+struct ObserverCallbacks;
+
+impl Callbacks for ObserverCallbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+
+        let middle = crate_num(tcx, "middle");
+        let activations = &tcx.resolutions(()).extern_prelude_path_activations;
+        let middle_paths: BTreeSet<_> = activations
+            .iter()
+            .filter(|activation| activation.load.crate_num == middle)
+            .map(|activation| {
+                tcx.sess
+                    .source_map()
+                    .span_to_snippet(activation.path_span)
+                    .unwrap()
+            })
+            .collect();
+        assert_eq!(
+            middle_paths,
+            BTreeSet::from(["middle::first".to_string(), "middle::second".to_string()])
+        );
+
+        let middle_load = activations
+            .iter()
+            .find(|activation| activation.load.crate_num == middle)
+            .unwrap()
+            .load;
+        assert_eq!(middle_load.kind, CrateDepKind::Unconditional);
+        let cold_closure = tcx.crate_dependency_closure(middle_load);
+        let warm_closure = tcx.crate_dependency_closure(middle_load);
+        assert!(std::ptr::eq(cold_closure, warm_closure));
+        let closure_names = crate_names(
+            tcx,
+            cold_closure.iter().map(|dependency| dependency.crate_num),
+        );
+        assert!(closure_names.contains("leaf"));
+        assert!(closure_names.contains("middle"));
+        assert!(!closure_names.contains("unrelated"));
+
+        let provider = crate_num(tcx, "provider");
+        assert_eq!(tcx.crate_dep_kind(provider), CrateDepKind::Unconditional);
+        let weak_load = only_path_load(tcx, activations, "weak");
+        let strong_load = only_path_load(tcx, activations, "strong");
+        assert_eq!(
+            dependency_kind(tcx, tcx.crate_dependency_closure(weak_load), "provider"),
+            CrateDepKind::MacrosOnly
+        );
+        assert_eq!(
+            dependency_kind(tcx, tcx.crate_dependency_closure(strong_load), "provider"),
+            CrateDepKind::Unconditional
+        );
+
+        let source_free = tcx.source_free_crate_activations(());
+        assert!(std::ptr::eq(source_free, tcx.source_free_crate_activations(())));
+        let source_free_names = crate_names(tcx, source_free.iter().map(|load| load.crate_num));
+        assert!(source_free_names.contains("forced"));
+        assert!(source_free_names.contains("profiler_runtime_provider"));
+
+        let forced = crate_num(tcx, "forced");
+        assert!(tcx
+            .resolutions(())
+            .extern_crate_map
+            .items()
+            .any(|(_, &crate_num)| crate_num == forced));
+
+        let macro_crate = crate_num(tcx, "macro_crate");
+        assert_eq!(tcx.crate_dep_kind(macro_crate), CrateDepKind::MacrosOnly);
+        let macro_load = only_path_load(tcx, activations, "macro_crate");
+        assert_eq!(
+            tcx.crate_dependency_closure(macro_load),
+            [ExternalCrateDependency {
+                crate_num: macro_crate,
+                kind: CrateDepKind::MacrosOnly,
+            }]
+        );
+
+        assert_eq!(
+            tcx.compiler_metadata_providers(provider),
+            [
+                CompilerMetadataProvider::DefaultLibAllocator,
+                CompilerMetadataProvider::WeakLangItem(LangItem::EhPersonality),
+                CompilerMetadataProvider::ExternallyImplementableItemImplementation,
+            ]
+        );
+        assert!(tcx
+            .compiler_metadata_providers(crate_num(tcx, "needs_only"))
+            .is_empty());
+        assert_eq!(
+            tcx.compiler_metadata_providers(crate_num(tcx, "native_link")),
+            [CompilerMetadataProvider::ExternalNativeLink]
+        );
+        assert_eq!(
+            tcx.compiler_metadata_requirements(crate_num(tcx, "needs_only")),
+            [
+                CompilerMetadataRequirement::Allocator,
+                CompilerMetadataRequirement::PanicRuntime,
+                CompilerMetadataRequirement::MissingLangItem(LangItem::EhPersonality),
+            ]
+        );
+        assert_eq!(
+            tcx.compiler_metadata_providers(crate_num(tcx, "compiler_builtins")),
+            [CompilerMetadataProvider::CompilerBuiltins]
+        );
+        assert_eq!(
+            tcx.compiler_metadata_providers(crate_num(tcx, "panic_runtime_provider")),
+            [CompilerMetadataProvider::PanicRuntime]
+        );
+        let profiler_runtime = crate_num(tcx, "profiler_runtime_provider");
+        assert_eq!(
+            tcx.compiler_metadata_providers(profiler_runtime),
+            [CompilerMetadataProvider::ProfilerRuntime]
+        );
+        assert!(
+            tcx.resolutions(()).extern_crate_loads.items().any(|(_, load)| {
+                load.crate_num == profiler_runtime && load.kind == CrateDepKind::Unconditional
+            })
+        );
+        assert!(source_free.iter().any(|load| {
+            load.crate_num == profiler_runtime && load.kind == CrateDepKind::Conditional
+        }));
+        assert_eq!(
+            tcx.compiler_metadata_providers(crate_num(tcx, "global_allocator_provider")),
+            [CompilerMetadataProvider::GlobalAllocator]
+        );
+        assert_eq!(
+            tcx.compiler_metadata_providers(crate_num(tcx, "alloc_error_handler_provider")),
+            [CompilerMetadataProvider::AllocErrorHandler]
+        );
+
+        Compilation::Stop
+    }
+}
