+struct RawDylibCallbacks;
+
+impl Callbacks for RawDylibCallbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+        assert_eq!(
+            tcx.compiler_metadata_providers(crate_num(tcx, "raw_dylib_native_link")),
+            [CompilerMetadataProvider::ExternalNativeLink]
+        );
+        Compilation::Stop
+    }
+}
+
+impl Callbacks for ConditionalActivationCallbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+        let generated = tcx.compiler_generated_crate_activations(());
+        assert!(std::ptr::eq(
+            generated,
+            tcx.compiler_generated_crate_activations(())
+        ));
+        let panic_runtime = generated
+            .iter()
+            .find(|activation| {
+                tcx.compiler_metadata_providers(activation.load.crate_num)
+                    .contains(&CompilerMetadataProvider::PanicRuntime)
+            })
+            .expect("panic runtime activation must be recorded");
+        let condition = panic_runtime
+            .condition
+            .expect("panic runtime activation must retain its condition");
+        assert_eq!(tcx.crate_name(condition).as_str(), "needs_panic_only");
+        assert_eq!(tcx.crate_dep_kind(condition), CrateDepKind::MacrosOnly);
+        assert_eq!(
+            tcx.compiler_metadata_requirements(condition),
+            [
+                CompilerMetadataRequirement::PanicRuntime,
+                CompilerMetadataRequirement::MissingLangItem(LangItem::EhPersonality),
+            ]
+        );
+        assert_eq!(panic_runtime.load.kind, CrateDepKind::Conditional);
+        assert!(!tcx
+            .source_free_crate_activations(())
+            .contains(&panic_runtime.load));
+        Compilation::Stop
+    }
+}
