+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(|| {
+        let args: Vec<_> = std::env::args().collect();
+        let sysroot = PathBuf::from(args.get(1).expect("expected sysroot"));
+        let linker = args.get(2).map(Path::new);
+        run_test(&sysroot, linker);
+    })
+}
