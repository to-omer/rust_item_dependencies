+fn compiler_metadata_providers<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    cnum: CrateNum,
+) -> &'tcx [CompilerMetadataProvider] {
+    let mut providers = Vec::new();
+    if tcx.is_compiler_builtins(cnum) {
+        providers.push(CompilerMetadataProvider::CompilerBuiltins);
+    }
+    if tcx.is_panic_runtime(cnum) {
+        providers.push(CompilerMetadataProvider::PanicRuntime);
+    }
+    if tcx.is_profiler_runtime(cnum) {
+        providers.push(CompilerMetadataProvider::ProfilerRuntime);
+    }
+    if tcx.native_libraries(cnum).iter().any(|library| {
+        matches!(library.kind, NativeLibKind::RawDylib { .. })
+            || (!tcx.crate_dep_kind(cnum).macros_only()
+                && native_libs::relevant_lib(tcx.sess, library)
+                && library.kind != NativeLibKind::WasmImportModule)
+    }) {
+        providers.push(CompilerMetadataProvider::ExternalNativeLink);
+    }
+    if tcx.has_global_allocator(cnum) {
+        providers.push(CompilerMetadataProvider::GlobalAllocator);
+    }
+    if tcx.has_alloc_error_handler(cnum) {
+        providers.push(CompilerMetadataProvider::AllocErrorHandler);
+    }
+    if tcx.has_default_lib_allocator(cnum) {
+        providers.push(CompilerMetadataProvider::DefaultLibAllocator);
+    }
+    // Weak lang items are selected from used crates, unlike the allocator,
+    // runtime, builtins, and EII scans which inspect every registered crate.
+    if tcx.used_crates(()).contains(&cnum) {
+        providers.extend(tcx.defined_lang_items(cnum).iter().filter_map(|&(_, item)| {
+            item.is_weak().then_some(CompilerMetadataProvider::WeakLangItem(item))
+        }));
+    }
+    if tcx
+        .externally_implementable_items(cnum)
+        .values()
+        .any(|(_, implementations)| !implementations.is_empty())
+    {
+        providers.push(CompilerMetadataProvider::ExternallyImplementableItemImplementation);
+    }
+    tcx.arena.alloc_from_iter(providers)
+}
+
+fn compiler_metadata_requirements<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    cnum: CrateNum,
+) -> &'tcx [CompilerMetadataRequirement] {
+    let cstore = CStore::from_tcx(tcx);
+    let cdata = cstore.get_crate_data(cnum);
+    let mut requirements = Vec::new();
+    if cdata.needs_allocator() {
+        requirements.push(CompilerMetadataRequirement::Allocator);
+    }
+    if cdata.needs_panic_runtime() {
+        requirements.push(CompilerMetadataRequirement::PanicRuntime);
+    }
+    requirements.extend(
+        tcx.missing_lang_items(cnum)
+            .iter()
+            .copied()
+            .filter(|item| item.is_weak())
+            .map(CompilerMetadataRequirement::MissingLangItem),
+    );
+    tcx.arena.alloc_from_iter(requirements)
+}
