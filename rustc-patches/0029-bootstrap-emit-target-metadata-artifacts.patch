+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct TargetMetadata {
+    build_compiler: Compiler,
+    compiler_sysroot: PathBuf,
+    target: TargetSelection,
+}
+
+impl CommandLineStep for TargetMetadata {
+    type Output = ();
+
+    fn should_run(run: ShouldRun<'_>) -> ShouldRun<'_> {
+        run.alias("rid-target-metadata")
+    }
+
+    fn is_default_step(_builder: &Builder<'_>) -> bool {
+        false
+    }
+
+    fn make_run(run: RunConfig<'_>) {
+        assert_eq!(
+            run.builder.kind,
+            Kind::Check,
+            "`rid-target-metadata` is only available with `x check`"
+        );
+        assert_eq!(run.builder.top_stage, 2, "`rid-target-metadata` requires `--stage 2`");
+        let build_compiler = Compiler::new(run.builder.top_stage, run.builder.host_target);
+        let compiler_sysroot = run
+            .builder
+            .out
+            .join(build_compiler.host)
+            .join(format!("stage{}", build_compiler.stage));
+        if !run.builder.config.dry_run() {
+            let rustc = compiler_sysroot.join("bin").join(exe("rustc", build_compiler.host));
+            assert!(
+                rustc.is_file(),
+                "`rid-target-metadata` requires an existing stage 2 compiler at {}",
+                rustc.display()
+            );
+        }
+        run.builder.ensure(TargetMetadata { build_compiler, compiler_sysroot, target: run.target });
+    }
+
+    fn run(self, builder: &Builder<'_>) {
+        let stamp = builder.ensure(Std {
+            build_compiler: self.build_compiler,
+            target: self.target,
+            crates: vec![],
+            mode: StdCheckMode::TargetMetadata { compiler_sysroot: self.compiler_sysroot.clone() },
+        });
+        let directory = builder
+            .out
+            .join(self.build_compiler.host)
+            .join(format!("stage{}-rid-target-metadata-artifacts", self.build_compiler.stage))
+            .join(self.target);
+        let sysroot = RmetaSysroot::from_stamp(builder, stamp, self.target, &directory);
+        t!(fs::write(sysroot.target_dir.join(TARGET_METADATA_COMPLETE_FILE), b""));
+    }
+
+    fn metadata(&self) -> Option<StepMetadata> {
+        Some(
+            StepMetadata::check("rid-target-metadata", self.target)
+                .built_by(self.build_compiler)
+                .stage(self.build_compiler.stage),
+        )
+    }
+}
