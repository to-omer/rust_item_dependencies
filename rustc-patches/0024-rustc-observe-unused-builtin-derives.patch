index 000000000..7fb644bef
--- /dev/null
+++ b/tests/ui-fulldeps/typeck-impl-dependencies-structural-pattern.rs
@@ -0,0 +1,167 @@
+//@ edition: 2024
+//@ revisions: current next
+//@ run-pass
+//@[current] run-flags: --sysroot {{sysroot-base}} --edition=2024 {{src-base}}/auxiliary/typeck-impl-dependencies-structural-pattern-input.rs
+//@[next] run-flags: --sysroot {{sysroot-base}} --edition=2024 -Znext-solver {{src-base}}/auxiliary/typeck-impl-dependencies-structural-pattern-input.rs
+//@ ignore-compare-mode-next-solver (explicit revisions)
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_span;
+
+use std::collections::HashSet;
+use std::process::ExitCode;
+
+use rustc_driver::Compilation;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::{DefId, LocalDefId};
+use rustc_interface::interface::Compiler;
+use rustc_middle::traits::TypeckImplDependenciesError;
+use rustc_middle::ty::{PseudoCanonicalInput, TyCtxt, TypingEnv};
+use rustc_span::Span;
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        let args: Vec<_> = std::env::args().collect();
+        rustc_driver::run_compiler(&args, &mut Callbacks);
+    })
+}
+
+struct Callbacks;
+
+impl rustc_driver::Callbacks for Callbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+
+        let next_solver = tcx.next_trait_solver_globally();
+        let structural_trait = tcx.lang_items().structural_peq_trait().unwrap();
+        let partial_eq_trait = tcx.lang_items().eq_trait().unwrap();
+        let inner = named_def(tcx, "Inner", DefKind::Struct);
+        let wrapper = named_def(tcx, "Wrapper", DefKind::Struct);
+        let non_structural = named_def(tcx, "NonStructural", DefKind::Struct);
+        let pattern_owner = named_def(tcx, "structural_pattern", DefKind::Fn).expect_local();
+        let expected = named_def(tcx, "EXPECTED", DefKind::Const { is_type_const: false });
+        let expected_ty = tcx.type_of(expected).instantiate_identity().skip_norm_wip();
+        let non_structural_ty =
+            tcx.type_of(non_structural).instantiate_identity().skip_norm_wip();
+        let inner_impl = impl_for_adt(tcx, structural_trait, inner).expect_local();
+        let inner_partial_eq_impl = impl_for_adt(tcx, partial_eq_trait, inner).expect_local();
+        let wrapper_impl = impl_for_adt(tcx, structural_trait, wrapper).expect_local();
+        let expected_impls = HashSet::from([inner_impl, inner_partial_eq_impl, wrapper_impl]);
+
+        let source_span = if next_solver {
+            assert!(matches!(
+                tcx.typeck_impl_dependencies(()),
+                Err(TypeckImplDependenciesError::IncompleteObservation)
+            ));
+            tcx.def_span(pattern_owner)
+        } else {
+            let cold = tcx.typeck_impl_dependencies(()).unwrap();
+            assert!(std::ptr::eq(cold, tcx.typeck_impl_dependencies(()).unwrap()));
+            let observed = cold
+                .iter()
+                .filter(|dependency| {
+                    dependency.source_owner == pattern_owner
+                        && expected_impls.contains(&dependency.impl_def_id)
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(observed.len(), 3);
+            assert_eq!(
+                observed.iter().map(|dependency| dependency.impl_def_id).collect::<HashSet<_>>(),
+                expected_impls
+            );
+            assert!(observed.iter().all(|dependency| {
+                dependency.associated_item.is_none()
+                    && snippet(tcx, dependency.source_span) == "EXPECTED"
+            }));
+            let source_span = observed[0].source_span;
+            assert!(observed.iter().all(|dependency| dependency.source_span == source_span));
+            source_span
+        };
+
+        let key = (
+            PseudoCanonicalInput {
+                typing_env: TypingEnv::fully_monomorphized(),
+                value: expected_ty,
+            },
+            pattern_owner,
+            source_span,
+        );
+        let direct = tcx.has_structural_eq_impl_with_impl_dependencies(key);
+        assert!(std::ptr::eq(
+            direct,
+            tcx.has_structural_eq_impl_with_impl_dependencies(key)
+        ));
+        assert_eq!(direct.result, expected_ty.is_structural_eq_shallow(tcx));
+        assert!(direct.result);
+        if next_solver {
+            assert!(matches!(
+                direct.dependencies,
+                Err(TypeckImplDependenciesError::IncompleteObservation)
+            ));
+        } else {
+            assert_eq!(
+                direct
+                    .dependencies
+                    .unwrap()
+                    .iter()
+                    .map(|dependency| dependency.impl_def_id)
+                    .collect::<HashSet<_>>(),
+                HashSet::from([inner_partial_eq_impl, wrapper_impl])
+            );
+        }
+
+        let non_structural_key = (
+            PseudoCanonicalInput {
+                typing_env: TypingEnv::fully_monomorphized(),
+                value: non_structural_ty,
+            },
+            pattern_owner,
+            source_span,
+        );
+        let non_structural_observed =
+            tcx.has_structural_eq_impl_with_impl_dependencies(non_structural_key);
+        assert_eq!(
+            non_structural_observed.result,
+            non_structural_ty.is_structural_eq_shallow(tcx)
+        );
+        assert!(!non_structural_observed.result);
+        assert!(non_structural_observed.dependencies.unwrap().is_empty());
+
+        Compilation::Stop
+    }
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id).as_str() == name)
+        .unwrap()
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&def_id| {
+            tcx.impl_trait_id(def_id) == trait_id
+                && tcx
+                    .impl_trait_ref(def_id)
+                    .skip_binder()
+                    .self_ty()
+                    .ty_adt_def()
+                    .is_some_and(|adt| adt.did() == adt_id)
+        })
+        .unwrap()
+}
+
+fn snippet(tcx: TyCtxt<'_>, span: Span) -> String {
+    tcx.sess.source_map().span_to_snippet(span).unwrap()
+}
