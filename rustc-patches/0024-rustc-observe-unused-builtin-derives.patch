+
+#[derive(Clone, Copy)]
+struct CloneCopy(u8);
+
+#[derive(Copy)]
+#[derive(Clone)]
+struct CopyThenClone(u8);
+
+#[derive(Clone)]
+#[derive(Copy)]
+struct CloneThenCopy(u8);
+
+#[derive(Copy, Clone)]
+struct GenericCopy<T>(T);
+
+#[derive(Eq, PartialEq, Ord, PartialOrd)]
+struct OrdPartialOrd(u8);
+
+#[derive(Eq, PartialEq, PartialOrd, Ord)]
+struct PartialOrdOrd(u8);
+
+#[derive(Eq, PartialEq, Ord)]
+#[derive(PartialOrd)]
+struct OrdThenPartialOrd(u8);
+
+#[derive(Eq, PartialEq, PartialOrd)]
