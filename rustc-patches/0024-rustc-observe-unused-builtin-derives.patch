diff --git a/tests/ui-fulldeps/derive-observer.rs b/tests/ui-fulldeps/derive-observer.rs
new file mode 100644
index 000000000..d7d792a3e
--- /dev/null
+++ b/tests/ui-fulldeps/derive-observer.rs
@@ -0,0 +1,339 @@
+//@ edition: 2024
+//@ run-pass
+//@ run-flags: --sysroot {{sysroot-base}} --edition=2024 {{src-base}}/auxiliary/derive-observer-input.rs
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_span;
+
+use std::cell::RefCell;
+use std::collections::{HashMap, HashSet};
+use std::process::ExitCode;
+
+use rustc_driver::Compilation;
+use rustc_hir::ItemKind;
+use rustc_interface::interface::Compiler;
+use rustc_middle::ty::{DeriveObservationWitness, MacroImplementationKind, TyCtxt};
+use rustc_span::hygiene::{ExpnId, ExpnKind, MacroKind};
+use rustc_span::Span;
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        let args: Vec<_> = std::env::args().collect();
+        rustc_driver::run_compiler(&args, &mut Callbacks);
+    })
+}
+
+struct Callbacks;
+
+impl rustc_driver::Callbacks for Callbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+        let resolutions = tcx.resolutions(());
+        assert!(resolutions.derive_observations_complete);
+
+        let derive_origins = RefCell::new(HashMap::new());
+        assert!(resolutions
+            .macro_invocation_origins
+            .items()
+            .filter(|(expansion, _)| {
+                matches!(
+                    expansion.expn_data().kind,
+                    ExpnKind::Macro(MacroKind::Derive, _)
+                )
+            })
+            .all(|(&expansion, origin)| {
+                derive_origins.borrow_mut().insert(expansion, origin);
+                true
+            }));
+        let derive_origins = derive_origins.into_inner();
+        assert_eq!(derive_origins.len(), 36);
+        assert!(derive_origins.values().all(|origin| {
+            origin.implementation_kind == MacroImplementationKind::Builtin
+                && origin.derive_source_index.is_some()
+        }));
+        assert!(resolutions
+            .macro_invocation_origins
+            .items()
+            .filter(|(expansion, _)| {
+                !matches!(
+                    expansion.expn_data().kind,
+                    ExpnKind::Macro(MacroKind::Derive, _)
+                )
+            })
+            .all(|(_, origin)| origin.derive_source_index.is_none()));
+
+        let mut children = HashMap::<ExpnId, Vec<(usize, ExpnId)>>::new();
+        for (&expansion, origin) in &derive_origins {
+            children.entry(origin.discovered_in_expansion).or_default().push((
+                origin.derive_source_index.unwrap(),
+                expansion,
+            ));
+        }
+        assert_eq!(children.len(), 17);
+        for children in children.values_mut() {
+            children.sort_by_key(|(source_index, _)| *source_index);
+            assert_eq!(
+                children.iter().map(|(source_index, _)| *source_index).collect::<Vec<_>>(),
+                (0..children.len()).collect::<Vec<_>>()
+            );
+            assert_eq!(
+                children.iter().map(|(_, expansion)| *expansion).collect::<HashSet<_>>().len(),
+                children.len()
+            );
+        }
+
+        let witnesses = RefCell::new(HashMap::new());
+        assert!(resolutions
+            .derive_observation_witnesses
+            .items()
+            .all(|(&target, &witness)| {
+                witnesses.borrow_mut().insert(target, witness);
+                true
+            }));
+        let witnesses = witnesses.into_inner();
+        assert_eq!(witnesses.len(), 18);
+        assert!(witnesses.values().all(|witness| witness.complete));
+        for target in witnesses.keys() {
+            let origin = &resolutions.macro_invocation_origins[target];
+            assert!(matches!(
+                target.expn_data().kind,
+                ExpnKind::Macro(MacroKind::Attr, name) if name.as_str() == "derive"
+            ));
+            assert_eq!(origin.derive_source_index, None);
+        }
+        let outer_targets = RefCell::new(Vec::new());
+        assert!(resolutions
+            .macro_invocation_origins
+            .items()
+            .filter(|(expansion, _)| {
+                matches!(
+                    expansion.expn_data().kind,
+                    ExpnKind::Macro(MacroKind::Attr, name) if name.as_str() == "derive"
+                )
+            })
+            .all(|(&target, _)| {
+                outer_targets.borrow_mut().push(target);
+                true
+        }));
+        let outer_targets = outer_targets.into_inner();
+        assert_eq!(outer_targets.len(), 18);
+        let empty_target = outer_targets
+            .iter()
+            .copied()
+            .find(|target| {
+                resolutions.macro_invocation_origins[target]
+                    .target_span
+                    .is_some_and(|span| snippet(tcx, span).contains("struct Empty"))
+            })
+            .expect("the empty derive target must have an observation witness");
+        let empty_witness = witnesses[&empty_target];
+        assert!(empty_witness.complete);
+        assert_eq!(empty_witness.child_count, 0);
+        assert_eq!(empty_witness.output_influence_count, 0);
+        assert_eq!(empty_witness.helper_use_count, 0);
+        let child_targets = derive_origins
+            .values()
+            .map(|origin| origin.discovered_in_expansion)
+            .collect::<Vec<_>>();
+        let influence_targets = RefCell::new(Vec::new());
+        assert!(resolutions.derive_output_influences.items().all(|influence| {
+            influence_targets.borrow_mut().push(influence.target_expansion);
+            true
+        }));
+        let influence_targets = influence_targets.into_inner();
+        let helper_targets = RefCell::new(Vec::new());
+        assert!(resolutions.derive_helper_uses.items().all(|helper| {
+            helper_targets.borrow_mut().push(helper.target_expansion);
+            true
+        }));
+        let helper_targets = helper_targets.into_inner();
+        assert!(observations_complete(
+            resolutions.derive_observations_complete,
+            &witnesses,
+            &outer_targets,
+            &child_targets,
+            &influence_targets,
+            &helper_targets
+        ));
+        let mut incomplete_witnesses = witnesses.clone();
+        let missing_witness = *incomplete_witnesses.keys().next().unwrap();
+        incomplete_witnesses.remove(&missing_witness);
+        assert!(!observations_complete(
+            resolutions.derive_observations_complete,
+            &incomplete_witnesses,
+            &outer_targets,
+            &child_targets,
+            &influence_targets,
+            &helper_targets
+        ));
+        let mut incomplete_witnesses = witnesses.clone();
+        incomplete_witnesses.values_mut().next().unwrap().complete = false;
+        assert!(!observations_complete(
+            resolutions.derive_observations_complete,
+            &incomplete_witnesses,
+            &outer_targets,
+            &child_targets,
+            &influence_targets,
+            &helper_targets
+        ));
+        for (missing_children, missing_influences, missing_helpers) in [
+            (&child_targets[1..], influence_targets.as_slice(), helper_targets.as_slice()),
+            (child_targets.as_slice(), &influence_targets[1..], helper_targets.as_slice()),
+            (child_targets.as_slice(), influence_targets.as_slice(), &helper_targets[1..]),
+        ] {
+            assert!(!observations_complete(
+                resolutions.derive_observations_complete,
+                &witnesses,
+                &outer_targets,
+                missing_children,
+                missing_influences,
+                missing_helpers
+            ));
+        }
+        assert!(!observations_complete(
+            false,
+            &witnesses,
+            &outer_targets,
+            &child_targets,
+            &influence_targets,
+            &helper_targets
+        ));
+
+        let expected_influences = HashSet::from([
+            ("CopyClone", "Clone", "Copy"),
+            ("CloneCopy", "Clone", "Copy"),
+            ("CopyThenClone", "Clone", "Copy"),
+            ("OrdPartialOrd", "PartialOrd", "Ord"),
+            ("PartialOrdOrd", "PartialOrd", "Ord"),
+            ("OrdThenPartialOrd", "PartialOrd", "Ord"),
+        ]);
+        assert_eq!(resolutions.derive_output_influences.len(), expected_influences.len());
+        assert!(resolutions.derive_output_influences.items().all(|influence| {
+                let dependent = derive_origins[&influence.dependent_expansion];
+                let provider = derive_origins[&influence.provider_expansion];
+                assert_eq!(influence.target_expansion, dependent.discovered_in_expansion);
+                assert_eq!(dependent.target_span, provider.target_span);
+                expected_influences.contains(&(
+                    target_name(tcx, dependent.target_span.unwrap()),
+                    macro_name(influence.dependent_expansion),
+                    macro_name(influence.provider_expansion),
+                ))
+            }));
+
+        assert_eq!(resolutions.derive_helper_uses.len(), 2);
+        let expected_uses = written_default_helper_spans(tcx);
+        assert_eq!(expected_uses.len(), 2);
+        assert!(resolutions.derive_helper_uses.items().all(|helper| {
+            assert!(expected_uses.contains(&helper.use_span));
+            assert_eq!(snippet(tcx, helper.use_span), "#[default]");
+            let provider = helper
+                .provider_expansion
+                .expect("a selected built-in derive helper has an exact provider");
+            let origin = derive_origins[&provider];
+            assert_eq!(helper.target_expansion, origin.discovered_in_expansion);
+            let target = origin.target_span.expect("derive helpers have a target item");
+            assert!(target.contains(helper.use_span));
+            assert_eq!(macro_name(provider), "Default");
+            true
+        }));
+
+        Compilation::Stop
+    }
+}
+
+fn observations_complete(
+    observations_complete: bool,
+    witnesses: &HashMap<ExpnId, DeriveObservationWitness>,
+    expected_targets: &[ExpnId],
+    children: &[ExpnId],
+    influences: &[ExpnId],
+    helpers: &[ExpnId],
+) -> bool {
+    fn counts(values: &[ExpnId]) -> HashMap<ExpnId, usize> {
+        let mut counts = HashMap::new();
+        for &value in values {
+            *counts.entry(value).or_default() += 1;
+        }
+        counts
+    }
+
+    if !observations_complete {
+        return false;
+    }
+    let child_counts = counts(children);
+    let influence_counts = counts(influences);
+    let helper_counts = counts(helpers);
+    expected_targets.iter().copied().collect::<HashSet<_>>()
+        == witnesses.keys().copied().collect()
+        && witnesses.iter().all(|(target, witness)| {
+            witness.complete
+                && child_counts.get(target).copied().unwrap_or(0) == witness.child_count
+                && influence_counts.get(target).copied().unwrap_or(0)
+                    == witness.output_influence_count
+                && helper_counts.get(target).copied().unwrap_or(0) == witness.helper_use_count
+        })
+}
+
+fn written_default_helper_spans(tcx: TyCtxt<'_>) -> HashSet<Span> {
+    let mut result = HashSet::new();
+    for owner in tcx.hir_crate_items(()).free_items() {
+        let item = tcx.hir_item(owner);
+        let ItemKind::Enum(_, _, definition) = item.kind else { continue };
+        for variant in definition.variants {
+            for attribute in tcx.hir_attrs(variant.hir_id) {
+                if snippet(tcx, attribute.span()) == "#[default]" {
+                    result.insert(attribute.span());
+                }
+            }
+        }
+    }
+    result
+}
+
+fn target_name(tcx: TyCtxt<'_>, span: Span) -> &'static str {
+    let text = snippet(tcx, span);
+    [
+        "CopyClone",
+        "CloneCopy",
+        "CopyThenClone",
+        "CloneThenCopy",
+        "GenericCopy",
+        "OrdPartialOrd",
+        "PartialOrdOrd",
+        "OrdThenPartialOrd",
+        "PartialOrdThenOrd",
+        "Unit",
+        "GenericOrd",
+        "FirstDefault",
+        "SecondDefault",
+    ]
+    .into_iter()
+    .find(|name| text.contains(name))
+    .unwrap_or_else(|| panic!("unknown derive target: {text}"))
+}
+
+fn macro_name(expansion: ExpnId) -> &'static str {
+    let ExpnKind::Macro(MacroKind::Derive, name) = expansion.expn_data().kind else {
+        panic!("expected a derive expansion")
+    };
+    match name.as_str() {
+        "Clone" => "Clone",
+        "Copy" => "Copy",
+        "Default" => "Default",
+        "Ord" => "Ord",
+        "PartialOrd" => "PartialOrd",
+        other => panic!("unexpected derive macro: {other}"),
+    }
+}
+
+fn snippet(tcx: TyCtxt<'_>, span: Span) -> String {
+    tcx.sess.source_map().span_to_snippet(span).unwrap()
+}
diff --git a/tests/ui-fulldeps/typeck-impl-dependencies-structural-pattern.rs b/tests/ui-fulldeps/typeck-impl-dependencies-structural-pattern.rs
