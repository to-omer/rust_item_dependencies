+struct PartialOrdThenOrd(u8);
+
+#[derive(Eq, PartialEq, Ord, PartialOrd)]
+struct Unit;
+
+#[derive(Eq, PartialEq, Ord, PartialOrd)]
+struct GenericOrd<T>(T);
+
+#[derive(Default)]
+enum FirstDefault {
+    #[default]
+    First,
+    Second,
+}
+
+#[derive(Default)]
