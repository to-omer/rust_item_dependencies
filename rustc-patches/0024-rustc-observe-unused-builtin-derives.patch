--- a/compiler/rustc_ty_utils/src/structural_match.rs
+++ b/compiler/rustc_ty_utils/src/structural_match.rs
@@ -1,8 +1,15 @@
 use rustc_hir::attrs::lang_items::LangItem;
 use rustc_infer::infer::TyCtxtInferExt;
 use rustc_middle::query::Providers;
-use rustc_middle::ty::{self, Ty, TyCtxt, TypingMode};
-use rustc_trait_selection::traits::{ObligationCause, ObligationCtxt};
+use rustc_middle::traits::{
+    StructuralEqImplDependencies, TypeckImplDependenciesError, TypeckImplDependency,
+};
+use rustc_middle::ty::{self, PseudoCanonicalInput, Ty, TyCtxt, TypingMode};
+use rustc_span::Span;
+use rustc_span::def_id::LocalDefId;
+use rustc_trait_selection::traits::{
+    ObligationCause, ObligationCtxt, TypeckImplDependencyRecorder,
+};
 
 /// This method returns true if and only if `adt_ty` itself has been marked as
 /// eligible for structural-match: namely, if it implements
@@ -31,6 +38,43 @@ fn has_structural_eq_impl<'tcx>(tcx: TyCtxt<'tcx>, adt_ty: Ty<'tcx>) -> bool {
     ocx.evaluate_obligations_error_on_ambiguity().no_errors()
 }
 
+fn has_structural_eq_impl_with_impl_dependencies<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    (input, owner, span): (PseudoCanonicalInput<'tcx, Ty<'tcx>>, LocalDefId, Span),
+) -> &'tcx StructuralEqImplDependencies<'tcx> {
+    debug_assert_eq!(input.typing_env, ty::TypingEnv::fully_monomorphized());
+    let adt_ty = input.value;
+    let infcx = &tcx.infer_ctxt().build(TypingMode::non_body_analysis());
+    let cause = ObligationCause::misc(span, owner);
+    let recorder = TypeckImplDependencyRecorder::shared();
+    let ocx = ObligationCtxt::new_with_typeck_impl_dependencies(infcx, recorder.clone());
+    let structural_peq_def_id = tcx.require_lang_item(LangItem::StructuralPeq, span);
+    ocx.register_bound(cause, ty::ParamEnv::empty(), adt_ty, structural_peq_def_id);
+
+    let result = ocx.evaluate_obligations_error_on_ambiguity().no_errors();
+    let dependencies = if result {
+        recorder
+            .borrow()
+            .finish(infcx)
+            .map(|mut dependencies| {
+                dependencies.sort_by_key(|dependency| {
+                    (
+                        tcx.def_path_hash(dependency.impl_def_id.to_def_id()),
+                        dependency.associated_item.map(|item| tcx.def_path_hash(item)),
+                    )
+                });
+                dependencies.dedup();
+                tcx.arena.alloc_from_iter(dependencies) as &[TypeckImplDependency]
+            })
+            .map_err(|()| TypeckImplDependenciesError::IncompleteObservation)
+    } else {
+        Ok(&[] as &[TypeckImplDependency])
+    };
+    tcx.arena.alloc(StructuralEqImplDependencies { result, dependencies })
+}
+
 pub(crate) fn provide(providers: &mut Providers) {
     providers.has_structural_eq_impl = has_structural_eq_impl;
+    providers.has_structural_eq_impl_with_impl_dependencies =
+        has_structural_eq_impl_with_impl_dependencies;
 }
