+    fn path_node(&self, repeats: &[(usize, usize)], depth: usize) -> Option<usize> {
+        if depth > repeats.len() {
+            return None;
+        }
+        let mut node = 0;
+        for &(iteration, _) in &repeats[..depth] {
+            node = *self.paths[node].children.get(&iteration)?;
+        }
+        Some(node)
