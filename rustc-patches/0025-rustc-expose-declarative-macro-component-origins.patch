+fn inventory_components(
+    tts: &[mbe::TokenTree],
+    component_ids: &mut FxHashMap<usize, usize>,
+    components: &mut Vec<MacroTranscriberComponent>,
+) {
+    let mut pending: Vec<_> = tts.iter().rev().map(|tree| (tree, None)).collect();
+    while let Some((tree, parent)) = pending.pop() {
+        let kind = match tree {
+            mbe::TokenTree::Token(..) => MacroTranscriberComponentKind::Token,
+            mbe::TokenTree::Delimited(..) => MacroTranscriberComponentKind::Delimiter,
+            mbe::TokenTree::MetaVar(..) => MacroTranscriberComponentKind::MetaVar,
+            mbe::TokenTree::MetaVarExpr(..) => MacroTranscriberComponentKind::MetaVarExpr,
+            mbe::TokenTree::Sequence(..) => MacroTranscriberComponentKind::Repetition,
+            mbe::TokenTree::MetaVarDecl { .. } => continue,
+        };
+        let id = components.len();
+        component_ids.insert(tree as *const mbe::TokenTree as usize, id);
+        components.push(MacroTranscriberComponent { kind, span: tree.span(), parent });
+        let children = match tree {
+            mbe::TokenTree::Delimited(_, _, delimited) => &delimited.tts,
+            mbe::TokenTree::Sequence(_, sequence) => &sequence.tts,
+            _ => continue,
+        };
+        pending.extend(children.iter().rev().map(|child| (child, Some(id))));
+    }
+}
