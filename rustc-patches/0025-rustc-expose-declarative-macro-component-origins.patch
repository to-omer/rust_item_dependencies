+            extern crate proc_macro;
+
+            use proc_macro::{Spacing, TokenStream, TokenTree};
+
+            #[proc_macro]
+            pub fn punct_spacing(input: TokenStream) -> TokenStream {
+                let joint = match input.into_iter().next() {
+                    Some(TokenTree::Punct(punct)) => punct.spacing() == Spacing::Joint,
+                    _ => panic!("expected one punctuation token"),
+                };
+                if joint { "1usize" } else { "0usize" }.parse().unwrap()
+            }
+
+            #[proc_macro]
+            pub fn last_spacing(input: TokenStream) -> TokenStream {
+                fn last_punctuation(input: TokenStream) -> Option<proc_macro::Punct> {
+                    let mut last = None;
+                    for tree in input {
+                        last = Some(tree);
+                    }
+                    match last? {
+                        TokenTree::Punct(punct) => Some(punct),
+                        TokenTree::Group(group) => last_punctuation(group.stream()),
+                        TokenTree::Ident(_) | TokenTree::Literal(_) => None,
+                    }
+                }
+                let punct = last_punctuation(input).expect("expected trailing punctuation");
+                if punct.spacing() == Spacing::Joint { "1usize" } else { "0usize" }
+                    .parse()
+                    .unwrap()
+            }
+        "#,
+    )
+    .unwrap();
+    rustc_driver::run_compiler(
+        &[
