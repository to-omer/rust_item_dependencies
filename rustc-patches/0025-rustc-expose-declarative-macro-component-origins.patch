+fn assert_expansion_ranges(expansion: &rustc_middle::ty::MacroDeclarativeExpansion) {
+    let output_len = expansion.output_tokens.len() as u32;
+    assert!(expansion
+        .definitions
+        .iter()
+        .all(|definition| definition.output.start < definition.output.end
+            && definition.output.end <= output_len));
+    assert!(expansion
+        .child_expansions
+        .iter()
+        .all(|child| child.output.start < child.output.end && child.output.end <= output_len));
+}
+
+fn assert_punctuation_contributors(
+    tcx: TyCtxt<'_>,
+    expansion: &rustc_middle::ty::MacroDeclarativeExpansion,
+    metavar: &str,
+    successors: &[Option<rustc_middle::ty::MacroInputTokenRange>],
+) {
+    let matcher = expansion.matcher.as_ref().unwrap();
+    let declaration = format!("${metavar}:");
+    let mut captures: Vec<_> = matcher
+        .captures
+        .iter()
+        .filter(|capture| {
+            tcx.sess
+                .source_map()
+                .span_to_snippet(capture.metavar_span)
+                .is_ok_and(|snippet| snippet.starts_with(&declaration))
+        })
+        .collect();
+    captures.sort_by_key(|capture| capture.path.clone());
+    assert_eq!(captures.len(), successors.len());
+    let component = format!("${metavar}");
+    for (capture, successor) in captures.into_iter().zip(successors) {
+        let outputs: Vec<_> = expansion
+            .output_tokens
+            .iter()
+            .filter(|origin| {
+                tcx.sess
+                    .source_map()
+                    .span_to_snippet(expansion.components[origin.component].span)
+                    .is_ok_and(|snippet| snippet == component)
+                    && origin
+                        .iterations
+                        .iter()
+                        .map(|iteration| iteration.index)
+                        .eq(capture.path.iter().copied())
+            })
+            .collect();
+        assert!(!outputs.is_empty());
+        let base = vec![capture.input];
+        if let Some(successor) = successor {
+            let with_successor = vec![capture.input, *successor];
+            assert_eq!(
+                outputs.iter().filter(|output| output.input_contributors == with_successor).count(),
+                1,
+                "${metavar} capture {:?} must attach its spacing successor to exactly one output",
+                capture.path,
+            );
+            assert!(outputs.iter().all(|output| {
+                output.input_contributors == base
+                    || output.input_contributors == with_successor
+            }));
+        } else {
+            assert!(outputs.iter().all(|output| output.input_contributors == base));
+        }
+    }
+}
+
+fn component_has_ancestor(
+    expansion: &rustc_middle::ty::MacroDeclarativeExpansion,
+    mut component: usize,
+    ancestor: usize,
+) -> bool {
+    while let Some(parent) = expansion.components[component].parent {
+        if parent == ancestor {
+            return true;
+        }
+        component = parent;
+    }
+    false
+}
+
+trait InputRangeExt {
+    fn range_is_empty(&self) -> bool;
+}
+
+impl InputRangeExt for rustc_middle::ty::MacroInputTokenRange {
+    fn range_is_empty(&self) -> bool {
+        self.start == self.end
+    }
+}
