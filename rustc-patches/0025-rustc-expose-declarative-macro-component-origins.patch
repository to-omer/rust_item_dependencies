+    fn spacing_successor(
+        &self,
+        capture: MacroInputTokenRange,
+    ) -> Option<Option<MacroInputTokenRange>> {
+        match *self
+            .spacing_successors
+            .get(capture.input_stream as usize)?
+            .get(capture.end as usize)?
