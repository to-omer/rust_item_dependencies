+fn output_origin_with_inputs(
+    tscx: &mut TranscrCtx<'_, '_>,
+    component: usize,
+    input_contributors: Vec<MacroInputTokenRange>,
+) -> MacroOutputTokenOrigin {
+    let mut complete = tscx.repeat_components.len() == tscx.repeats.len()
+        && tscx.repeat_matchers.len() == tscx.repeats.len();
+    let mut iterations = Vec::with_capacity(tscx.repeat_components.len());
+    let mut path_node = tscx.matcher_index.as_ref().map(|_| 0);
+    for (depth, ((&repetition_component, &(index, _)), matchers)) in
+        tscx.repeat_components.iter().zip(&tscx.repeats).zip(&tscx.repeat_matchers).enumerate()
+    {
+        let mut iteration_inputs = Vec::with_capacity(matchers.len());
+        for &id in matchers {
+            match path_node.and_then(|path_node| {
+                tscx.matcher_index.as_ref()?.repetition_input(path_node, id, index)
+            }) {
+                Some(input) => iteration_inputs.push(input),
+                None => complete = false,
+            }
+        }
+        iterations.push(MacroTranscriberIteration {
+            repetition_component,
+            index,
+            input_contributors: iteration_inputs,
+        });
+        path_node = path_node
+            .and_then(|path_node| tscx.matcher_index.as_ref()?.child_path(path_node, index));
+        if depth + 1 < tscx.repeat_components.len() && path_node.is_none() {
+            complete = false;
+        }
+    }
+    tscx.output_provenance_complete &= complete;
+    MacroOutputTokenOrigin { component, iterations, input_contributors }
+}
