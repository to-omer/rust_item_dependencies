+fn classify_macro_expansion_output_structure(
+    fragment: &AstFragment,
+) -> rustc_middle::ty::MacroExpansionOutputStructure {
+    use rustc_middle::ty::MacroExpansionOutputStructure::{Empty, Nonempty};
+
+    let empty = match fragment {
+        AstFragment::OptExpr(output) => output.is_none(),
+        AstFragment::Items(nodes) => nodes.is_empty(),
+        AstFragment::TraitItems(nodes)
+        | AstFragment::ImplItems(nodes)
+        | AstFragment::TraitImplItems(nodes) => nodes.is_empty(),
+        AstFragment::ForeignItems(nodes) => nodes.is_empty(),
+        AstFragment::Stmts(nodes) => nodes.is_empty(),
+        AstFragment::Arms(nodes) => nodes.is_empty(),
+        AstFragment::ExprFields(nodes) => nodes.is_empty(),
+        AstFragment::PatFields(nodes) => nodes.is_empty(),
+        AstFragment::GenericParams(nodes) => nodes.is_empty(),
+        AstFragment::Params(nodes) => nodes.is_empty(),
+        AstFragment::FieldDefs(nodes) => nodes.is_empty(),
+        AstFragment::Variants(nodes) => nodes.is_empty(),
+        AstFragment::WherePredicates(nodes) => nodes.is_empty(),
+        AstFragment::Crate(krate) => {
+            !krate.is_placeholder && krate.attrs.is_empty() && krate.items.is_empty()
+        }
+        AstFragment::Expr(_)
+        | AstFragment::MethodReceiverExpr(_)
+        | AstFragment::Pat(_)
+        | AstFragment::Ty(_) => false,
+    };
+    if empty { Empty } else { Nonempty }
+}
