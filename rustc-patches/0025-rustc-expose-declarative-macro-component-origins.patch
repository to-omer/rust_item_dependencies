+    let extension = if cfg!(target_os = "macos") {
+        "dylib"
+    } else if cfg!(target_os = "windows") {
+        "dll"
+    } else if cfg!(target_os = "aix") {
+        "a"
+    } else {
+        "so"
+    };
+    output.join(format!("{prefix}{crate_name}.{extension}"))
