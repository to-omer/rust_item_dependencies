+/// Shared status for parsing an observed declarative macro's output through `dyn MacResult`.
+#[derive(Clone)]
+pub struct DeclarativeMacroParseStatus {
+    invocation_id: LocalExpnId,
+    complete: Rc<Cell<bool>>,
+    root_macro_range: Rc<RefCell<Option<MacroParserRange>>>,
+}
+
+impl DeclarativeMacroParseStatus {
+    pub(crate) fn new(invocation_id: LocalExpnId) -> Self {
+        Self {
+            invocation_id,
+            complete: Rc::new(Cell::new(true)),
+            root_macro_range: Rc::new(RefCell::new(None)),
+        }
+    }
+
+    pub(crate) fn invalidate(&self) {
+        self.complete.set(false);
+    }
+
+    pub(crate) fn incomplete_invocation(&self) -> Option<LocalExpnId> {
+        (!self.complete.get()).then_some(self.invocation_id)
+    }
+
+    pub(crate) fn record_root_macro_range(&self, range: Option<MacroParserRange>) {
+        *self.root_macro_range.borrow_mut() = range;
+    }
+
+    pub(crate) fn root_macro_range(&self) -> Option<MacroParserRange> {
+        self.root_macro_range.borrow().clone()
+    }
+}
