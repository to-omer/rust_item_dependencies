+    fn capture(
+        &self,
+        repeats: &[(usize, usize)],
+        depth: usize,
+        input_stream: u32,
+        metavar_index: usize,
+    ) -> Option<MacroInputTokenRange> {
+        let node = self.path_node(repeats, depth)?;
