+/// Returns whether a transcribed tree ends in source punctuation whose spacing can depend on the
+/// following matcher input. `None` means that the tree contributes no source token. Invisible
+/// delimiters are compiler wrappers, so inspect their contents; written delimiters form a spacing
+/// boundary of their own.
+fn transcribed_tail_is_punctuation(tree: &TokenTree) -> Option<bool> {
+    let mut pending = vec![tree];
+    while let Some(tree) = pending.pop() {
+        match tree {
+            TokenTree::Token(token, _) => return Some(token.is_punct()),
+            TokenTree::Delimited(_, _, Delimiter::Invisible(_), stream) => {
+                pending.extend(stream.iter());
+            }
+            TokenTree::Delimited(..) => return Some(false),
+        }
+    }
+    None
