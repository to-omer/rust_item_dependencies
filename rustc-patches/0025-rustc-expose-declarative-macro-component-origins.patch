+#[derive(Clone, Debug)]
+pub struct TokenStreamObserverHandle {
+    identity: usize,
+    stream: Weak<Vec<TokenTree>>,
+}
+
+impl TokenStreamObserverHandle {
+    pub fn identity(&self) -> usize {
+        self.identity
+    }
+
+    pub fn matches(&self, stream: &TokenStream) -> bool {
+        self.stream.upgrade().is_some_and(|observed| Arc::ptr_eq(&observed, &stream.0))
+    }
+
+    pub fn matches_handle(&self, other: &TokenStreamObserverHandle) -> bool {
+        match (self.stream.upgrade(), other.stream.upgrade()) {
+            (Some(left), Some(right)) => Arc::ptr_eq(&left, &right),
+            _ => false,
+        }
+    }
+}
+
 impl TokenStream {
+    /// Stable for clones while the backing allocation is alive. Intended only
+    /// for compiler-internal observer side tables.
+    pub fn observer_identity(&self) -> usize {
+        Arc::as_ptr(&self.0) as usize
+    }
+
+    pub fn observer_handle(&self) -> TokenStreamObserverHandle {
+        TokenStreamObserverHandle {
+            identity: self.observer_identity(),
+            stream: Arc::downgrade(&self.0),
+        }
+    }
+
     pub fn new(tts: Vec<TokenTree>) -> TokenStream {
         TokenStream(Arc::new(tts))
     }
