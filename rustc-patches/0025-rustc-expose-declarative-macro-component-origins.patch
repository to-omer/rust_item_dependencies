+        const CAPTURE_COUNT: usize = 4_096;
+        const OPTIONAL_COUNT: usize = 512;
+
+        let matcher = (0..OPTIONAL_COUNT)
+            .map(|matcher_index| MatcherLoc::Sequence {
+                op: KleeneOp::ZeroOrOne,
+                span: Span::default(),
+                separator_span: None,
+                num_metavar_decls: 0,
+                idx_first_after: matcher_index + 1,
+                next_metavar: 0,
+                seq_depth: 0,
+            })
+            .chain(std::iter::once(MatcherLoc::Eof))
+            .collect::<Vec<_>>();
+        let mut state = MatcherState::new(true, 0, Vec::new(), vec![Span::default()]);
+        state.prepare_matcher(&matcher);
+        state.matches_mut().push(NamedMatch::MatchedSeq(
+            (0..CAPTURE_COUNT).map(|_| NamedMatch::MatchedSeq(Vec::new())).collect(),
+        ));
+        let accumulated_matches = Rc::clone(state.observed_matches().unwrap());
+        let mut skipped = MatcherPos { idx: 0, state: Rc::new(state) };
+
+        for matcher_index in 0..OPTIONAL_COUNT {
+            // Keep the branch that attempts the optional literal alive while the zero-length
+            // branch records its trace. Forking the trace must remain constant-time regardless of
+            // how many captures precede these optional matcher branches.
+            let attempted = MatcherPos { idx: matcher_index, state: Rc::clone(&skipped.state) };
