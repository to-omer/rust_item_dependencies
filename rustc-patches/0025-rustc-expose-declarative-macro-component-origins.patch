+    fn reference_spacing_successor(
+        matcher: &MacroMatcherObservation,
+        capture: MacroInputTokenRange,
+    ) -> Option<Option<MacroInputTokenRange>> {
+        if !capture.complete
+            || matcher
+                .input_streams
+                .get(capture.input_stream as usize)
+                .is_none_or(|stream| !stream.complete)
+        {
+            return None;
+        }
+        let candidate = matcher
+            .repetitions
+            .iter()
+            .filter(|repetition| repetition.input_stream == capture.input_stream)
+            .flat_map(|repetition| &repetition.instances)
+            .flat_map(|instance| &instance.iterations)
+            .map(|iteration| iteration.body)
+            .filter(|body| body.start >= capture.end && body.start < body.end)
+            .min_by_key(|body| (body.start, body.end - body.start));
+        let Some(candidate) = candidate else {
+            return Some(None);
+        };
+        if !candidate.complete {
+            return None;
+        }
+        let mut covered = capture.end;
+        while covered < candidate.start {
+            let next = matcher
+                .repetitions
+                .iter()
+                .filter(|repetition| repetition.input_stream == capture.input_stream)
+                .flat_map(|repetition| &repetition.instances)
+                .flat_map(|instance| &instance.iterations)
+                .filter_map(|iteration| iteration.separator_after)
+                .filter(|separator| {
+                    separator.start == covered
+                        && separator.end > covered
+                        && separator.end <= candidate.start
+                })
+                .max_by_key(|separator| separator.end);
+            let Some(next) = next else {
+                return Some(None);
+            };
+            if !next.complete {
+                return None;
+            }
+            covered = next.end;
+        }
+        Some(Some(candidate))
+    }
