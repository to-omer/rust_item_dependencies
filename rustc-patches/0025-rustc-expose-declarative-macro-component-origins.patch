+#[derive(Clone, Copy)]
+struct MacroOwnerOutputClassification {
+    precise: bool,
+    intrinsic: bool,
+}
+
+/// Classifies only the residual AST. Product roles are recorded from the same invocation walk
+/// that assigns child expansion ids, so type and pattern macros do not need token-side identity.
+fn classify_macro_owner_output(fragment: &AstFragment) -> MacroOwnerOutputClassification {
+    let (precise, intrinsic) = match fragment {
+        AstFragment::Items(items) => classify_items(items.iter().map(Box::as_ref)),
+        AstFragment::TraitItems(items)
+        | AstFragment::ImplItems(items)
+        | AstFragment::TraitImplItems(items) => classify_assoc_items(items.iter().map(Box::as_ref)),
+        AstFragment::ForeignItems(items) => classify_foreign_items(items.iter().map(Box::as_ref)),
+        AstFragment::Stmts(stmts) => classify_stmts(stmts),
+        AstFragment::Expr(expr) | AstFragment::MethodReceiverExpr(expr) => {
+            classify_value_expr(expr)
+        }
+        AstFragment::OptExpr(Some(expr)) => classify_value_expr(expr),
+        AstFragment::Pat(pat) => (true, !matches!(pat.kind, PatKind::MacCall(_))),
+        AstFragment::Ty(ty) => (true, !matches!(ty.kind, TyKind::MacCall(_))),
+        AstFragment::OptExpr(None) => (true, false),
+        AstFragment::Crate(_)
+        | AstFragment::Arms(_)
+        | AstFragment::ExprFields(_)
+        | AstFragment::PatFields(_)
+        | AstFragment::GenericParams(_)
+        | AstFragment::Params(_)
+        | AstFragment::FieldDefs(_)
+        | AstFragment::Variants(_)
+        | AstFragment::WherePredicates(_) => (false, true),
+    };
+    MacroOwnerOutputClassification { precise, intrinsic }
+}
+
+fn classify_items<'a>(mut items: impl Iterator<Item = &'a ast::Item>) -> (bool, bool) {
+    (items.all(|item| item.attrs.is_empty()), false)
+}
+
+fn classify_assoc_items<'a>(mut items: impl Iterator<Item = &'a ast::AssocItem>) -> (bool, bool) {
+    (items.all(|item| item.attrs.is_empty()), false)
+}
+
+fn classify_foreign_items<'a>(
+    mut items: impl Iterator<Item = &'a ast::ForeignItem>,
+) -> (bool, bool) {
+    (items.all(|item| item.attrs.is_empty()), false)
+}
+
+fn classify_stmts(stmts: &[ast::Stmt]) -> (bool, bool) {
+    stmts.iter().fold((true, false), |(complete, intrinsic), stmt| {
+        let (stmt_complete, stmt_intrinsic) = classify_effect_stmt(stmt);
+        (complete && stmt_complete, intrinsic || stmt_intrinsic)
+    })
+}
+
+fn classify_effect_stmt(stmt: &ast::Stmt) -> (bool, bool) {
+    match &stmt.kind {
+        StmtKind::Item(item) => (item.attrs.is_empty(), false),
+        StmtKind::MacCall(mac) => (mac.attrs.is_empty(), false),
+        StmtKind::Empty => (true, false),
+        StmtKind::Expr(expr) | StmtKind::Semi(expr) => classify_effect_expr(expr),
+        StmtKind::Let(_) => (true, true),
+    }
+}
+
+fn classify_effect_expr(expr: &ast::Expr) -> (bool, bool) {
+    if !expr.attrs.is_empty() {
+        return (false, true);
+    }
+    match &expr.kind {
+        ExprKind::Block(block, None) if block.rules == ast::BlockCheckMode::Default => {
+            classify_stmts(&block.stmts)
+        }
+        ExprKind::MacCall(_) => (true, false),
+        _ => (true, true),
+    }
+}
+
+fn classify_value_expr(expr: &ast::Expr) -> (bool, bool) {
+    if !expr.attrs.is_empty() {
+        return (false, true);
+    }
+    match &expr.kind {
+        ExprKind::Block(block, None) if block.rules == ast::BlockCheckMode::Default => {
+            let Some((last, effects)) = block.stmts.split_last() else { return (true, true) };
+            let (mut complete, mut intrinsic) = classify_stmts(effects);
+            let (last_complete, last_intrinsic) = match &last.kind {
+                StmtKind::Expr(value) => classify_value_expr(value),
+                _ => classify_effect_stmt(last),
+            };
+            complete &= last_complete;
+            intrinsic |= last_intrinsic;
+            if !matches!(last.kind, StmtKind::Expr(_)) {
+                intrinsic = true;
+            }
+            (complete, intrinsic)
+        }
+        ExprKind::MacCall(_) => (true, false),
+        _ => (true, true),
+    }
+}
+
+fn initial_owner_product_role(fragment: &AstFragment) -> MacroOwnerProductRole {
+    match fragment {
+        AstFragment::Expr(_)
+        | AstFragment::MethodReceiverExpr(_)
+        | AstFragment::OptExpr(Some(_))
+        | AstFragment::Pat(_)
+        | AstFragment::Ty(_)
+        | AstFragment::Stmts(_) => MacroOwnerProductRole::Required,
+        _ => MacroOwnerProductRole::Dependent,
     }
 }
 
