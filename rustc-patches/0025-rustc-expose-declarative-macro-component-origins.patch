+
+struct TokenStreamProvenanceFrame<'a> {
+    stream: &'a TokenStream,
+    index: usize,
+    start: u32,
+    close_after: bool,
+}
+
+fn collect_token_stream_provenance(
+    stream: &TokenStream,
+    streams: &mut Vec<(TokenStreamObserverHandle, Range<u32>)>,
+) -> Option<Range<u32>> {
+    let mut next_output_ordinal = 0u32;
+    let mut stack =
+        vec![TokenStreamProvenanceFrame { stream, index: 0, start: 0, close_after: false }];
+    while let Some(frame) = stack.last_mut() {
+        let Some(tree) = frame.stream.get(frame.index) else {
+            let frame = stack.pop().unwrap();
+            streams.push((frame.stream.observer_handle(), frame.start..next_output_ordinal));
+            if frame.close_after {
+                next_output_ordinal = next_output_ordinal.checked_add(1)?;
+            }
+            continue;
+        };
+        frame.index += 1;
+        match tree {
+            TokenTree::Token(..) => {
+                next_output_ordinal = next_output_ordinal.checked_add(1)?;
+            }
+            TokenTree::Delimited(_, _, delimiter, inner) => {
+                let written = !delimiter.skip();
+                if written {
+                    next_output_ordinal = next_output_ordinal.checked_add(1)?;
+                }
+                stack.push(TokenStreamProvenanceFrame {
+                    stream: inner,
+                    index: 0,
+                    start: next_output_ordinal,
+                    close_after: written,
+                });
+            }
+        }
+    }
+    Some(0..next_output_ordinal)
+}
