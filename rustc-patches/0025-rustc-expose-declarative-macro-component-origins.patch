+    let (expansion, tokens) = match parent {
+        Some((expansion, Some(tokens))) => (expansion, tokens),
+        Some((_, None)) => {
+            stream.complete = false;
+            return;
+        }
+        None => {
+            if stream.tokens.iter().any(|span| span.from_expansion()) {
+                stream.complete = false;
