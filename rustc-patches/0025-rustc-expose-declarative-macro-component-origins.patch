+    fn intern_path(&mut self, path: &[usize]) -> usize {
+        let mut node = 0;
+        for &iteration in path {
+            node = match self.paths[node].children.get(&iteration) {
+                Some(&child) => child,
+                None => {
+                    let child = self.paths.len();
+                    self.paths.push(MatcherPathNode::default());
+                    self.paths[node].children.insert(iteration, child);
+                    child
+                }
+            };
+        }
+        node
