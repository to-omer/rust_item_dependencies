+    #[test]
+    fn component_inventory_does_not_recurse_with_tree_depth() {
+        let mut trees = vec![mbe::TokenTree::Token(Token::new(token::Comma, DUMMY_SP))];
+        for _ in 0..DEEP_TREE_DEPTH {
+            trees = vec![mbe::TokenTree::Delimited(
+                DelimSpan::from_single(DUMMY_SP),
+                DelimSpacing::new(Spacing::Alone, Spacing::Alone),
+                mbe::Delimited { delim: Delimiter::Parenthesis, tts: trees },
+            )];
+        }
+
+        let mut component_ids = FxHashMap::default();
+        let mut components = Vec::new();
+        inventory_components(&trees, &mut component_ids, &mut components);
+        assert_eq!(components.len(), DEEP_TREE_DEPTH + 1);
+        assert_eq!(component_ids.len(), components.len());
+        assert_eq!(components[0].parent, None);
+        for (component, facts) in components.iter().enumerate().skip(1) {
+            assert_eq!(facts.parent, Some(component - 1));
