+fn matcher_observation_complete(observation: &MacroMatcherObservation) -> bool {
+    observation.input_streams.iter().all(|stream| stream.complete)
+        && observation.captures.iter().all(|capture| capture.input.complete)
+        && observation.repetitions.iter().all(|repetition| {
+            repetition.instances.iter().all(|instance| {
+                instance.input.complete
+                    && instance.iterations.iter().all(|iteration| {
+                        iteration.body.complete
+                            && iteration.separator_after.is_none_or(|range| range.complete)
+                    })
+            })
+        })
+}
+
+fn output_input_range_complete(
+    observation: &MacroMatcherObservation,
+    range: MacroInputTokenRange,
+) -> bool {
+    let Some(stream) = observation.input_streams.get(range.input_stream as usize) else {
+        return false;
+    };
+    if !range.complete
+        || !stream.complete
+        || range.start > range.end
+        || range.end as usize > stream.tokens.len()
+    {
+        return false;
+    }
+    match &stream.parent_output {
+        Some(parent) => parent.tokens.len() == stream.tokens.len(),
+        None => {
+            stream.boundaries.len() == stream.tokens.len() + 1
+                && stream.boundaries.iter().all(|boundary| !boundary.is_dummy())
+        }
+    }
+}
+
+fn output_inputs_complete(
+    observation: &MacroMatcherObservation,
+    output_tokens: &[MacroOutputTokenOrigin],
+) -> bool {
+    output_tokens.iter().all(|output| {
+        output
+            .input_contributors
+            .iter()
+            .chain(output.iterations.iter().flat_map(|iteration| &iteration.input_contributors))
+            .copied()
+            .all(|range| output_input_range_complete(observation, range))
+    })
+}
