+#[derive(Default)]
+struct LockstepIterDrivers {
+    ordered: Vec<MacroRulesNormalizedIdent>,
+    seen: FxHashSet<MacroRulesNormalizedIdent>,
+    #[cfg(test)]
+    membership_checks: usize,
+}
+
+impl LockstepIterDrivers {
+    fn insert(&mut self, name: MacroRulesNormalizedIdent) {
+        #[cfg(test)]
+        {
+            self.membership_checks += 1;
+        }
+        if self.seen.insert(name) {
+            self.ordered.push(name);
+        }
+    }
+
+    fn into_ordered(self) -> Vec<MacroRulesNormalizedIdent> {
+        self.ordered
+    }
+}
+
+fn record_lockstep_iter_driver(
+    name: MacroRulesNormalizedIdent,
+    interpolations: &FxHashMap<MacroRulesNormalizedIdent, NamedMatch>,
+    repeats: &[(usize, usize)],
+    drivers: &mut LockstepIterDrivers,
+) {
+    if matches!(lookup_cur_matched(name, interpolations, repeats), Some(MatchedSeq(_))) {
+        drivers.insert(name);
+    }
+}
+
+fn collect_lockstep_iter_drivers(
+    tree: &mbe::TokenTree,
+    interpolations: &FxHashMap<MacroRulesNormalizedIdent, NamedMatch>,
+    repeats: &[(usize, usize)],
+    drivers: &mut LockstepIterDrivers,
+) {
+    match tree {
+        mbe::TokenTree::Delimited(.., delimited) => {
+            for tree in &delimited.tts {
+                collect_lockstep_iter_drivers(tree, interpolations, repeats, drivers);
+            }
+        }
+        mbe::TokenTree::Sequence(_, sequence) => {
+            for tree in &sequence.tts {
+                collect_lockstep_iter_drivers(tree, interpolations, repeats, drivers);
+            }
+        }
+        mbe::TokenTree::MetaVar(_, name) | mbe::TokenTree::MetaVarDecl { name, .. } => {
+            record_lockstep_iter_driver(
+                MacroRulesNormalizedIdent::new(*name),
+                interpolations,
+                repeats,
+                drivers,
+            );
+        }
+        mbe::TokenTree::MetaVarExpr(_, expression) => {
+            expression.for_each_metavar((), |(), ident| {
+                record_lockstep_iter_driver(
+                    MacroRulesNormalizedIdent::new(*ident),
+                    interpolations,
+                    repeats,
+                    drivers,
+                );
+            });
+        }
+        mbe::TokenTree::Token(..) => {}
+    }
