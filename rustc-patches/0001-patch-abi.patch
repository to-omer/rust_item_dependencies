From d5a8ab134361f3c58439fed42b876a751652531a Mon Sep 17 00:00:00 2001
From: rust-item-dependencies <rust-item-dependencies@invalid.example>
Date: Tue, 11 Aug 2026 02:46:50 +0900
Subject: [PATCH] rustc_driver: publish rust-item-dependencies patch ABI

---
 compiler/rustc_driver_impl/src/lib.rs | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/compiler/rustc_driver_impl/src/lib.rs b/compiler/rustc_driver_impl/src/lib.rs
index e2c9f3f9..ee06a618 100644
--- a/compiler/rustc_driver_impl/src/lib.rs
+++ b/compiler/rustc_driver_impl/src/lib.rs
@@ -114,6 +114,15 @@ pub(super) fn install() {}
 /// Exit status code used for compilation failures and invalid flags.
 pub const EXIT_FAILURE: i32 = 1;
 
+/// The upstream revision against which the rust-item-dependencies observer ABI
+/// was implemented.
+pub const RUST_ITEM_DEPENDENCIES_BASE_REVISION: &str =
+    "969b803cbe1d4499f841ae0a49c637d8c70a0458";
+
+/// Incremented whenever the observer records consumed by rust-item-dependencies
+/// change incompatibly.
+pub const RUST_ITEM_DEPENDENCIES_PATCH_ABI: u32 = 1;
+
 pub const DEFAULT_BUG_REPORT_URL: &str = "https://github.com/rust-lang/rust/issues/new\
     ?labels=C-bug%2C+I-ICE%2C+T-compiler&template=ice.md";
 
