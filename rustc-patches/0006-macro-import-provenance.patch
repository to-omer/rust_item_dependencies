--- a/compiler/rustc_middle/src/ty/mod.rs
+++ b/compiler/rustc_middle/src/ty/mod.rs
@@ -256,6 +256,32 @@ pub enum MacroImplementationKind {
     GlobDelegation,
 }
 
+#[derive(Clone, Copy, Debug, Eq, PartialEq, StableHash)]
+pub enum MacroImportKind {
+    Single,
+    Glob,
+    ExternCrate,
+    MacroUse,
+    MacroExport,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, StableHash)]
+pub struct MacroImportStep {
+    pub kind: MacroImportKind,
+    /// Local source item or use-tree leaf that introduced this binding.
+    pub definition: LocalDefId,
+}
+
+#[derive(Clone, Debug, StableHash)]
+pub struct MacroResolvedImportUse {
+    pub path_span: Span,
+    pub segment_span: Span,
+    pub namespace: hir::def::Namespace,
+    pub target: Res<!>,
+    /// Ordered from the invocation-visible import towards the macro definition.
+    pub import_chain: Vec<MacroImportStep>,
+}
+
 #[derive(Clone, Debug, StableHash)]
 pub struct MacroInvocationOrigin {
     /// Expansion whose output contained this invocation when it was collected.
@@ -270,6 +296,8 @@ pub struct MacroInvocationOrigin {
     pub target_span: Option<Span>,
     pub fragment_kind: MacroInvocationFragmentKind,
     pub implementation_kind: MacroImplementationKind,
+    /// Final import/re-export paths selected for this invocation.
+    pub resolved_import_uses: Vec<MacroResolvedImportUse>,
 }
 
 #[derive(Debug)]
diff --git a/compiler/rustc_resolve/src/ident.rs b/compiler/rustc_resolve/src/ident.rs
index c855a43c..b607803b 100644
--- a/compiler/rustc_resolve/src/ident.rs
+++ b/compiler/rustc_resolve/src/ident.rs
@@ -1350,7 +1350,9 @@ fn finalize_module_binding(
         finalize: Finalize,
         shadowing: Shadowing,
     ) -> Result<Decl<'ra>, ControlFlow<Determinacy, Determinacy>> {
-        let Finalize { path_span, report_private, used, root_span, owner, .. } = finalize;
+        let Finalize {
+            path_span, report_private, used, root_span, owner, macro_invocation, ..
+        } = finalize;
 
         let Some(binding) = binding else {
             return Err(ControlFlow::Continue(Determined));
@@ -1384,6 +1386,9 @@ fn finalize_module_binding(
         if let Some(owner) = owner {
             self.record_import_use(owner, path_span, ident.span, binding);
         }
+        if let Some(invocation) = macro_invocation {
+            self.record_macro_import_use(invocation, path_span, ident.span, binding);
+        }
         self.record_use(ident, binding, used);
         return Ok(binding);
     }
