@@ -2340,6 +2357,52 @@ fn record_import_use(
         });
     }
 
+    fn record_macro_import_use(
+        &mut self,
+        invocation: LocalExpnId,
+        path_span: Span,
+        segment_span: Span,
+        binding: Decl<'ra>,
+    ) {
+        let mut import_chain = Vec::new();
+        let mut next_binding = binding;
+        while let DeclKind::Import { source_decl, import, .. } = next_binding.kind {
+            let (kind, definition) = match import.kind {
+                ImportKind::Single { def_id, .. } => (MacroImportKind::Single, def_id),
+                ImportKind::Glob { def_id, .. } => (MacroImportKind::Glob, def_id),
+                ImportKind::ExternCrate { def_id, .. } => (MacroImportKind::ExternCrate, def_id),
+                ImportKind::MacroUse { .. } => {
+                    (MacroImportKind::MacroUse, self.owner_def_id(import.root_id))
+                }
+                ImportKind::MacroExport => {
+                    (MacroImportKind::MacroExport, self.owner_def_id(import.root_id))
+                }
+            };
+            import_chain.push(MacroImportStep { kind, definition });
+            next_binding = source_decl;
+        }
+        if import_chain.is_empty() {
+            return;
+        }
+
+        let expansion = invocation.to_expn_id();
+        if !self.macro_invocation_origins.contains_key(&expansion) {
+            self.dcx()
+                .bug("a finalized macro import path must refer to a recorded macro invocation");
+        }
+        let origin = self.macro_invocation_origins.get_mut(&expansion).unwrap();
+        origin.resolved_import_uses.push(MacroResolvedImportUse {
+            path_span,
+            segment_span,
+            namespace: binding
+                .res()
+                .ns()
+                .expect("an imported macro path binding must have a namespace"),
+            target: binding.res().expect_non_local(),
+            import_chain,
+        });
+    }
+
     #[inline]
     fn add_to_glob_map(&mut self, import: Import<'_>, name: Symbol) {
         if let ImportKind::Glob { def_id, .. } = import.kind {
@@ -2842,6 +2905,11 @@ struct Finalize {
     /// `None` is used for diagnostic/speculative and macro resolution, which
     /// must not contribute path provenance facts.
     owner: Option<LocalDefId> = None,
+    /// Macro invocation whose path is being finalized after expansion.
+    ///
+    /// This is separate from `owner`: macro paths do not have a HIR owner at
+    /// resolution time, and speculative/diagnostic resolutions leave it empty.
+    macro_invocation: Option<LocalExpnId> = None,
 }
 
 impl Finalize {
@@ -2857,6 +2925,11 @@ fn with_owner(mut self, owner: Option<LocalDefId>) -> Finalize {
         self.owner = owner;
         self
     }
+
+    fn with_macro_invocation(mut self, invocation: Option<LocalExpnId>) -> Finalize {
+        self.macro_invocation = invocation;
+        self
+    }
 }
 
