     /// `compiler/rustc_monomorphize/src/collector.rs` for more context.
     pub mentioned_items: Option<Vec<Spanned<MentionedItem<'tcx>>>>,
 
+    /// Trait-associated function mentions captured before MIR optimization.
+    /// Unlike `mentioned_items`, this observer inventory is not rewritten by
+    /// the MIR inliner.
+    pub pre_optimization_associated_items: Option<Vec<Spanned<MentionedItem<'tcx>>>>,
