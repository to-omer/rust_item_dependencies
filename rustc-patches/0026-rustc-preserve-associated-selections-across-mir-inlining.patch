+fn check_pre_optimization_associated_items<'tcx>(tcx: TyCtxt<'tcx>) {
+    let owner = Instance::mono(tcx, tcx.entry_fn(()).unwrap().0);
+    let storage = named_def(tcx, "Storage", DefKind::Trait);
+    let arithmetic = named_def(tcx, "Arithmetic", DefKind::Trait);
+    let normalize = associated_item(tcx, storage, "normalize");
+    let reduce = associated_item(tcx, arithmetic, "reduce");
+    let storage_impl = tcx
+        .iter_local_def_id()
+        .map(|def_id| def_id.to_def_id())
+        .find(|&def_id| {
+            tcx.def_kind(def_id) == DefKind::Impl { of_trait: true }
+                && tcx.impl_trait_id(def_id) == storage
+                && tcx.generics_of(def_id).count() != 0
+        })
+        .unwrap();
+    let normalize_override = tcx.impl_item_implementor_ids(storage_impl)[&normalize];
+    let used = named_def(tcx, "Used", DefKind::Struct);
+    let defaulted = named_def(tcx, "Defaulted", DefKind::Struct);
+    let unused = named_def(tcx, "Unused", DefKind::Struct);
+    let stock_before = tcx.items_of_instance((owner, CollectionMode::UsedItems)).unwrap();
+    let successors = tcx
+        .mono_successors((MonoTraceRoot::Fn(owner), CollectionMode::UsedItems))
+        .unwrap();
+    let warm = tcx
+        .mono_successors((MonoTraceRoot::Fn(owner), CollectionMode::UsedItems))
+        .unwrap();
+    let mentioned_mode = tcx
+        .mono_successors((MonoTraceRoot::Fn(owner), CollectionMode::MentionedItems))
+        .unwrap();
+    assert!(std::ptr::eq(successors, warm));
+    let stock_after = tcx.items_of_instance((owner, CollectionMode::UsedItems)).unwrap();
+    assert_eq!(stock_before, stock_after);
+    assert_eq!(successors.used, stock_after.0);
+    assert_eq!(successors.mentioned, stock_after.1);
+    assert_eq!(
+        successors.pre_optimization_associated_items,
+        mentioned_mode.pre_optimization_associated_items
+    );
+    assert_eq!(successors.pre_optimization_associated_items.len(), 5);
+    let is_pre_optimization_cause = |cause| {
+        matches!(
+            cause,
+            MonoUseCause::PreOptimizationDirectCall
+                | MonoUseCause::PreOptimizationFunctionPointer
+                | MonoUseCause::PreOptimizationInlineAsmSymbol
+        )
+    };
+    assert!(successors
+        .facts
+        .iter()
+        .all(|fact| !is_pre_optimization_cause(fact.cause)));
+    assert!(successors
+        .proof_uses
+        .iter()
+        .all(|proof| !is_pre_optimization_cause(proof.cause)));
+    assert!(successors
+        .pre_optimization_associated_items
+        .iter()
+        .all(|proof| is_pre_optimization_cause(proof.cause)));
+    for (requested, self_type, selected, cause, snippet) in [
+        (
+            normalize,
+            used,
+            normalize_override,
+            MonoUseCause::PreOptimizationDirectCall,
+            "T::normalize(value)",
+        ),
+        (
+            normalize,
+            defaulted,
+            normalize,
+            MonoUseCause::PreOptimizationDirectCall,
+            "T::normalize(value)",
+        ),
+        (
+            reduce,
+            used,
+            reduce,
+            MonoUseCause::PreOptimizationDirectCall,
+            "T::reduce(value)",
+        ),
+        (
+            normalize,
+            used,
+            normalize_override,
+            MonoUseCause::PreOptimizationFunctionPointer,
+            "T::normalize",
+        ),
+        (
+            normalize,
+            used,
+            normalize_override,
+            MonoUseCause::PreOptimizationInlineAsmSymbol,
+            "std::arch::asm!(\"/* {normalize} */\", normalize = sym T::normalize)",
+        ),
+    ] {
+        let observed = successors
+            .pre_optimization_associated_items
+            .iter()
+            .find(|observed| {
+                matches!(
+                    observed.proof,
+                    MonoProof::AssociatedItem { request, .. }
+                        if request.value.0 == requested
+                            && request.value.1.type_at(0).ty_adt_def().is_some_and(|adt| adt.did() == self_type)
+                            && observed.cause == cause
+                )
+            })
+            .unwrap_or_else(|| panic!("missing propagated selection for {self_type:?}"));
+        let MonoProof::AssociatedItem { raw_instance, codegen_instance, .. } = observed.proof else {
+            panic!("expected an associated-item proof: {observed:?}")
+        };
+        assert_eq!(observed.from, MonoTraceNode::Item(MonoItem::Fn(owner)));
+        assert_eq!(observed.cause, cause);
+        assert_eq!(observed.collection, MonoTraceCollection::Mentioned);
+        assert_eq!(raw_instance, codegen_instance);
+        assert_eq!(raw_instance.def_id(), selected);
+        let MonoTraceSite::Source(span) = observed.site else {
+            panic!("pre-optimization selection lacked a source site: {observed:?}")
+        };
+        assert_eq!(tcx.sess.source_map().span_to_snippet(span).unwrap(), snippet);
+    }
+    assert!(successors.pre_optimization_associated_items.iter().all(|observed| {
+        let MonoProof::AssociatedItem { request, .. } = observed.proof else { return false };
+        request.value.1.type_at(0).ty_adt_def().is_none_or(|adt| adt.did() != unused)
+    }));
+    assert!(!successors.proof_uses.iter().any(|proof| {
+        matches!(
+            proof.proof,
+            MonoProof::AssociatedItem { request, .. }
+                if request.value.0 == reduce && proof.cause == MonoUseCause::DirectCall
+        )
+    }));
+}
+
