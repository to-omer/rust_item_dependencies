             tainted_by_errors,
@@ -419,6 +425,7 @@ pub fn new_cfg_only(basic_blocks: IndexVec<BasicBlock, BasicBlockData<'tcx>>) ->
             span: DUMMY_SP,
             required_consts: None,
             mentioned_items: None,
+            pre_optimization_associated_items: None,
             var_debug_info: Vec::new(),
             is_polymorphic: false,
             injection_phase: None,
@@ -770,6 +777,30 @@ pub fn mentioned_items(&self) -> &[Spanned<MentionedItem<'tcx>>] {
             None => panic!("mentioned_items for {:?} have not yet been set", self.source.def_id()),
         }
     }
+
+    #[track_caller]
+    pub fn set_pre_optimization_associated_items(
+        &mut self,
+        items: Vec<Spanned<MentionedItem<'tcx>>>,
+    ) {
+        assert!(
+            self.pre_optimization_associated_items.is_none(),
+            "pre-optimization associated items for {:?} have already been set",
+            self.source.def_id()
+        );
+        self.pre_optimization_associated_items = Some(items);
+    }
+
+    #[track_caller]
+    pub fn pre_optimization_associated_items(&self) -> &[Spanned<MentionedItem<'tcx>>] {
+        match &self.pre_optimization_associated_items {
+            Some(items) => items,
+            None => panic!(
+                "pre-optimization associated items for {:?} have not yet been set",
+                self.source.def_id()
+            ),
+        }
+    }
 }
 
