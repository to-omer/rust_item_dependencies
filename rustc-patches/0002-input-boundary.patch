 8 files changed, 80 insertions(+), 5 deletions(-)

diff --git a/compiler/rustc_builtin_macros/src/env.rs b/compiler/rustc_builtin_macros/src/env.rs
index aaa9117b..a7cc8f56 100644
--- a/compiler/rustc_builtin_macros/src/env.rs
+++ b/compiler/rustc_builtin_macros/src/env.rs
@@ -11,6 +11,7 @@
 use rustc_ast::{ExprKind, GenericArg, Mutability};
 use rustc_ast_pretty::pprust;
 use rustc_expand::base::{DummyResult, ExpandResult, ExtCtxt, MacEager, MacroExpanderResult};
+use rustc_session::ExternalResourceKind;
 use rustc_span::edit_distance::edit_distance;
 use rustc_span::{Ident, Span, Symbol, kw, sym};
 use thin_vec::thin_vec;
@@ -33,6 +34,12 @@ pub(crate) fn expand_option_env<'cx>(
     sp: Span,
     tts: TokenStream,
 ) -> MacroExpanderResult<'cx> {
+    if let Some(guar) =
+        cx.sess.reject_external_resource(ExternalResourceKind::OptionalEnvironment, sp)
+    {
+        return ExpandResult::Ready(DummyResult::any(sp, guar));
+    }
+
     let ExpandResult::Ready(mac_expr) = get_single_expr_from_tts(cx, sp, tts, "option_env!") else {
         return ExpandResult::Retry(());
     };
@@ -93,6 +100,10 @@ pub(crate) fn expand_env<'cx>(
     sp: Span,
     tts: TokenStream,
 ) -> MacroExpanderResult<'cx> {
+    if let Some(guar) = cx.sess.reject_external_resource(ExternalResourceKind::Environment, sp) {
+        return ExpandResult::Ready(DummyResult::any(sp, guar));
+    }
+
     let ExpandResult::Ready(mac) = get_exprs_from_tts(cx, tts) else {
         return ExpandResult::Retry(());
     };
