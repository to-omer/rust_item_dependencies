diff --git a/compiler/rustc_session/src/session.rs b/compiler/rustc_session/src/session.rs
index f30d825b..abac8c79 100644
--- a/compiler/rustc_session/src/session.rs
+++ b/compiler/rustc_session/src/session.rs
@@ -7,7 +7,7 @@
 
 use rustc_data_structures::fx::{FxHashMap, FxHashSet, FxIndexSet};
 use rustc_data_structures::profiling::{SelfProfiler, SelfProfilerRef};
-use rustc_data_structures::sync::{AppendOnlyVec, DynSend, DynSync, Lock};
+use rustc_data_structures::sync::{AppendOnlyVec, DynSend, DynSync, IntoDynSyncSend, Lock};
 use rustc_data_structures::{Limit, flock};
 use rustc_errors::annotate_snippet_emitter_writer::AnnotateSnippetEmitter;
 use rustc_errors::codes::*;
@@ -77,6 +77,39 @@ pub struct CompilerIO {
     pub temps_dir: Option<PathBuf>,
 }
 
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ExternalResourceKind {
+    Environment,
+    OptionalEnvironment,
+}
+
+impl ExternalResourceKind {
+    fn description(self) -> &'static str {
+        match self {
+            ExternalResourceKind::Environment => "env!",
+            ExternalResourceKind::OptionalEnvironment => "option_env!",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct ExternalResourceUse {
+    pub kind: ExternalResourceKind,
+    pub span: Span,
+}
+
+pub struct ExternalResourceGuard(IntoDynSyncSend<Box<dyn Fn(ExternalResourceUse) + Send + Sync>>);
+
+impl ExternalResourceGuard {
+    pub fn new(guard: impl Fn(ExternalResourceUse) + Send + Sync + 'static) -> Self {
+        ExternalResourceGuard(IntoDynSyncSend(Box::new(guard)))
+    }
+
+    fn report(&self, resource_use: ExternalResourceUse) {
+        (self.0)(resource_use);
+    }
+}
+
 pub trait DynLintStore: Any + DynSync + DynSend {
     /// Provides a way to access lint groups without depending on `rustc_lint`
     fn lint_groups_iter(&self) -> Box<dyn Iterator<Item = LintGroup> + '_>;
@@ -392,6 +425,10 @@ pub struct Session {
     /// File paths accessed during the build.
     pub file_depinfo: Lock<FxIndexSet<Symbol>>,
 
+    /// When present, rejects compile-time resource access before the external
+    /// state is read and reports the attempted access to the compiler driver.
+    pub external_resource_guard: Option<ExternalResourceGuard>,
+
     target_filesearch: Arc<FileSearch>,
     host_filesearch: Arc<FileSearch>,
 
@@ -452,6 +489,19 @@ pub struct LintGroup {
 }
 
 impl Session {
+    pub fn reject_external_resource(
+        &self,
+        kind: ExternalResourceKind,
+        span: Span,
+    ) -> Option<ErrorGuaranteed> {
+        let guard = self.external_resource_guard.as_ref()?;
+        guard.report(ExternalResourceUse { kind, span });
+        Some(self.dcx().span_err(
+            span,
+            format!("compile-time resource access through {} is disabled", kind.description()),
+        ))
+    }
+
     pub fn miri_unleashed_feature(&self, span: Span, feature_gate: Option<Symbol>) {
         self.miri_unleashed_features.lock().push((span, feature_gate));
     }
@@ -1346,6 +1396,7 @@ pub fn build_session(
         using_internal_features,
         env_depinfo: Default::default(),
         file_depinfo: Default::default(),
+        external_resource_guard: None,
         target_filesearch,
         host_filesearch,
         replaced_intrinsics: FxHashSet::default(), // filled by `run_compiler`
