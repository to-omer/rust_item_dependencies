+//@ edition: 2024
+//@ run-pass
+//@ run-flags: --sysroot {{sysroot-base}} --edition=2024 {{src-base}}/auxiliary/typeck-impl-dependencies-copy-use-input.rs
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_span;
+
+use std::process::ExitCode;
+
+use rustc_driver::Compilation;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::{DefId, LocalDefId};
+use rustc_interface::interface::Compiler;
+use rustc_middle::traits::TypeckImplDependency;
+use rustc_middle::ty::TyCtxt;
+use rustc_span::Span;
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        let args: Vec<_> = std::env::args().collect();
+        rustc_driver::run_compiler(&args, &mut Callbacks);
+    })
+}
+
+struct Callbacks;
+
+impl rustc_driver::Callbacks for Callbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+
+        let ordinary_copy = named_def(tcx, "ordinary_copy", DefKind::Fn).expect_local();
+        let closure_capture = named_def(tcx, "closure_capture", DefKind::Fn).expect_local();
+        let captured_closure = tcx
+            .hir_body_owners()
+            .find(|&owner| {
+                tcx.def_kind(owner) == DefKind::Closure
+                    && tcx.typeck_root_def_id_local(owner) == closure_capture
+            })
+            .unwrap();
+        let ordinary = named_def(tcx, "Ordinary", DefKind::Struct);
+        let captured = named_def(tcx, "Captured", DefKind::Struct);
+        let copy = tcx.lang_items().copy_trait().unwrap();
+        let ordinary_impl = impl_for_adt(tcx, copy, ordinary).expect_local();
+        let captured_impl = impl_for_adt(tcx, copy, captured).expect_local();
+        let captured_use_span = first_let_initializer_span(tcx, captured_closure);
+
+        let ordinary_built = tcx.mir_built_with_impl_dependencies(ordinary_copy);
+        assert!(std::ptr::eq(
+            ordinary_built,
+            tcx.mir_built_with_impl_dependencies(ordinary_copy)
+        ));
+        assert!(std::ptr::eq(ordinary_built.body, tcx.mir_built(ordinary_copy)));
+        let ordinary_dependencies = ordinary_built.dependencies.unwrap();
+        assert_eq!(ordinary_dependencies.len(), 2);
+        assert!(ordinary_dependencies.iter().all(|dependency| {
+            dependency.source_owner == ordinary_copy
+                && dependency.impl_def_id == ordinary_impl
+                && dependency.associated_item.is_none()
+        }));
+        assert_eq!(
+            ordinary_dependencies
+                .iter()
+                .map(|dependency| dependency.source_span)
+                .collect::<std::collections::HashSet<_>>()
+                .len(),
+            2
+        );
+
+        let typeck_dependencies = tcx
+            .typeck(closure_capture)
+            .typeck_impl_dependencies
+            .as_deref()
+            .unwrap();
+        assert_eq!(
+            semantic_dependencies(typeck_dependencies)
+                .into_iter()
+                .filter(|(_, _, implementation, _)| *implementation == captured_impl)
+                .collect::<Vec<_>>(),
+            [
+                (captured_closure, captured_use_span, captured_impl, None),
+                (captured_closure, captured_use_span, captured_impl, None),
+            ]
+        );
+
+        let closure_built = tcx.mir_built_with_impl_dependencies(captured_closure);
+        assert!(std::ptr::eq(
+            closure_built,
+            tcx.mir_built_with_impl_dependencies(captured_closure)
+        ));
+        assert!(std::ptr::eq(closure_built.body, tcx.mir_built(captured_closure)));
+        assert_eq!(
+            semantic_dependencies(closure_built.dependencies.unwrap()),
+            [(captured_closure, captured_use_span, captured_impl, None)]
+        );
+
+        let cold = tcx.typeck_impl_dependencies(()).unwrap();
+        let warm = tcx.typeck_impl_dependencies(()).unwrap();
+        assert!(std::ptr::eq(cold, warm));
+        let copy_dependencies = cold
+            .iter()
+            .filter(|dependency| {
+                dependency.impl_def_id == ordinary_impl || dependency.impl_def_id == captured_impl
+            })
+            .copied()
+            .collect::<Vec<_>>();
+        assert_eq!(
+            copy_dependencies
+                .iter()
+                .filter(|dependency| {
+                    dependency.source_owner == ordinary_copy
+                        && dependency.impl_def_id == ordinary_impl
+                })
+                .count(),
+            2
+        );
+        let captured_dependencies = copy_dependencies
+            .iter()
+            .filter(|dependency| {
+                dependency.source_owner == captured_closure
+                    && dependency.impl_def_id == captured_impl
+            })
+            .copied()
+            .collect::<Vec<_>>();
+        assert_eq!(captured_dependencies.len(), 1);
+        assert_eq!(
+            semantic_dependencies(&captured_dependencies),
+            [(captured_closure, captured_use_span, captured_impl, None)]
+        );
+
+        Compilation::Stop
+    }
+}
+
+fn first_let_initializer_span(tcx: TyCtxt<'_>, owner: LocalDefId) -> Span {
+    let body = tcx.hir_body_owned_by(owner);
+    let rustc_hir::ExprKind::Block(block, _) = body.value.kind else {
+        panic!("expected closure block")
+    };
+    let rustc_hir::StmtKind::Let(local) = block.stmts[0].kind else {
+        panic!("expected closure let statement")
+    };
+    local.init.unwrap().span
+}
+
+fn semantic_dependencies(
+    dependencies: &[TypeckImplDependency],
+) -> Vec<(LocalDefId, Span, LocalDefId, Option<DefId>)> {
+    dependencies
+        .iter()
+        .map(|dependency| {
+            (
+                dependency.source_owner,
+                dependency.source_span,
+                dependency.impl_def_id,
+                dependency.associated_item,
+            )
+        })
+        .collect()
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id).as_str() == name)
+        .unwrap()
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&def_id| {
+            tcx.impl_trait_id(def_id) == trait_id
+                && tcx
+                    .impl_trait_ref(def_id)
+                    .skip_binder()
+                    .self_ty()
+                    .ty_adt_def()
+                    .is_some_and(|adt| adt.did() == adt_id)
+        })
+        .unwrap()
+}
