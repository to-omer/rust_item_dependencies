+        // `AsyncDrop` uses its own applicability callback and does not yet expose the committed
+        // proof. Keep the stock diagnostics but make observation of that unstable path explicit.
+        observation.borrow_mut().mark_incomplete();
         if let Some(async_dtor) = adt_async_destructor(tcx, def_id) {
