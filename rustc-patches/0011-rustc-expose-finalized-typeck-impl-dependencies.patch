+//@ edition: 2024
+//@ run-pass
+//@ run-flags: --sysroot {{sysroot-base}} --edition=2024 {{src-base}}/auxiliary/typeck-impl-dependencies-copy-coherence-input.rs
+//@ ignore-stage1 (requires matching sysroot built with in-tree compiler)
+//@ ignore-cross-compile
+//@ ignore-remote
+
+#![feature(rustc_private)]
+
+extern crate rustc_abi;
+extern crate rustc_driver;
+extern crate rustc_hir;
+extern crate rustc_interface;
+extern crate rustc_middle;
+extern crate rustc_span;
+
+use std::process::ExitCode;
+
+use rustc_abi::FieldIdx;
+use rustc_driver::Compilation;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::{DefId, LocalDefId};
+use rustc_interface::interface::Compiler;
+use rustc_middle::traits::TypeckImplDependency;
+use rustc_middle::ty::TyCtxt;
+
+fn main() -> ExitCode {
+    rustc_driver::catch_with_exit_code(move || {
+        let args: Vec<_> = std::env::args().collect();
+        rustc_driver::run_compiler(&args, &mut Callbacks);
+    })
+}
+
+struct Callbacks;
+
+impl rustc_driver::Callbacks for Callbacks {
+    fn after_analysis<'tcx>(&mut self, _compiler: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        tcx.sess.dcx().abort_if_errors();
+
+        let copy = tcx.lang_items().copy_trait().unwrap();
+        let copy_field = named_def(tcx, "CopyField", DefKind::Struct);
+        let copy_container = named_def(tcx, "CopyContainer", DefKind::Struct);
+        let copy_field_impl = impl_for_adt(tcx, copy, copy_field).expect_local();
+        let copy_container_impl = impl_for_adt(tcx, copy, copy_container).expect_local();
+        let field = &tcx.adt_def(copy_container).non_enum_variant().fields[FieldIdx::ZERO];
+        let Some(rustc_hir::Node::Field(field)) = tcx.hir_get_if_local(field.did) else {
+            panic!("expected local CopyContainer field")
+        };
+        let expected = (copy_container_impl, field.ty.span, copy_field_impl, None);
+
+        let coherence = tcx.coherent_trait_with_impl_dependencies(copy);
+        assert!(std::ptr::eq(coherence, tcx.coherent_trait_with_impl_dependencies(copy)));
+        assert!(coherence.result.is_ok());
+        assert_eq!(semantic_dependencies(coherence.dependencies.unwrap()), [expected]);
+
+        let crate_dependencies = tcx.typeck_impl_dependencies(()).unwrap();
+        assert!(std::ptr::eq(crate_dependencies, tcx.typeck_impl_dependencies(()).unwrap()));
+        assert_eq!(
+            semantic_dependencies(crate_dependencies)
+                .into_iter()
+                .filter(|(owner, _, implementation, _)| {
+                    *owner == copy_container_impl && *implementation == copy_field_impl
+                })
+                .collect::<Vec<_>>(),
+            [expected]
+        );
+
+        Compilation::Stop
+    }
+}
+
+fn semantic_dependencies(
+    dependencies: &[TypeckImplDependency],
+) -> Vec<(LocalDefId, rustc_span::Span, LocalDefId, Option<DefId>)> {
+    dependencies
+        .iter()
+        .map(|dependency| {
+            (
+                dependency.source_owner,
+                dependency.source_span,
+                dependency.impl_def_id,
+                dependency.associated_item,
+            )
+        })
+        .collect()
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id).as_str() == name)
+        .unwrap()
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&def_id| {
+            tcx.impl_trait_id(def_id) == trait_id
+                && tcx
+                    .impl_trait_ref(def_id)
+                    .skip_binder()
+                    .self_ty()
+                    .ty_adt_def()
+                    .is_some_and(|adt| adt.did() == adt_id)
+        })
+        .unwrap()
+}
