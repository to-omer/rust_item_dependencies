+    let (infcx, param_env) = tcx.infer_ctxt().ignoring_regions().build_with_typing_env(typing_env);
+    let cause = ObligationCause::misc(span, owner);
+    let observed = infcx.at(&cause, param_env).query_normalize_with_impl_dependencies(value);
+    match observed {
+        Ok((Normalized { value: normalized_value, obligations }, dependencies)) => {
+            assert_eq!(
+                obligations.iter().find(|predicate| not_outlives_predicate(predicate.predicate)),
+                None,
+            );
