+                })
+                .map(|dependency| source_coordinates(tcx, dependency.source_span))
+                .collect::<HashSet<_>>();
+            assert_eq!(leaf_sites, expected_leaf_sites);
+            let shell_sites = cold
+                .iter()
+                .filter(|dependency| {
+                    dependency.source_owner == repeated_projection_coercions
+                        && dependency.impl_def_id == impl_def_id
+                        && dependency.associated_item.is_none()
+                })
+                .map(|dependency| source_coordinates(tcx, dependency.source_span))
+                .collect::<HashSet<_>>();
+            assert_eq!(shell_sites, expected_shell_sites);
+        }
+
+        assert_eq!(
+            cold.iter()
+                .filter(|dependency| {
+                    dependency.impl_def_id == deref_impl
+                        && dependency.associated_item == Some(target_impl_item)
+                })
+                .map(|dependency| {
+                    (
+                        dependency.source_owner,
+                        source_coordinates(tcx, dependency.source_span),
+                    )
+                })
+                .collect::<HashSet<_>>(),
+            HashSet::from([
+                (deref_impl_item.expect_local(), (50, 5, 50, 26)),
+                (deref_body, (61, 5, 61, 13)),
+            ])
+        );
+
+        assert_eq!(
+            exact_dependencies(cold, operator_body, add_impl, Some(add_output_impl_item), tcx),
+            HashSet::from([(operator_body, (98, 9, 98, 10), add_impl, Some(add_output_impl_item))])
+        );
+        assert_eq!(
+            exact_dependencies(
+                cold,
+                pointer_body,
+                pointer_output_impl,
+                Some(pointer_output_impl_item),
+                tcx,
+            ),
+            HashSet::from([(
+                pointer_body,
+                (117, 35, 117, 47),
+                pointer_output_impl,
+                Some(pointer_output_impl_item),
+            )])
+        );
+
+        Compilation::Stop
+    }
+}
+
+fn exact_dependencies(
+    dependencies: &[TypeckImplDependency],
+    owner: LocalDefId,
+    impl_def_id: LocalDefId,
+    associated_item: Option<DefId>,
+    tcx: TyCtxt<'_>,
+) -> HashSet<(LocalDefId, (usize, usize, usize, usize), LocalDefId, Option<DefId>)> {
+    dependencies
+        .iter()
+        .filter(|dependency| {
+            dependency.source_owner == owner
+                && dependency.impl_def_id == impl_def_id
+                && dependency.associated_item == associated_item
+        })
+        .map(|dependency| {
+            (
+                dependency.source_owner,
+                source_coordinates(tcx, dependency.source_span),
+                dependency.impl_def_id,
+                dependency.associated_item,
+            )
+        })
+        .collect()
+}
+
+fn source_coordinates(tcx: TyCtxt<'_>, span: Span) -> (usize, usize, usize, usize) {
+    let source_map = tcx.sess.source_map();
+    let lo = source_map.lookup_char_pos(span.lo());
+    let hi = source_map.lookup_char_pos(span.hi());
+    assert_eq!(lo.file.name, hi.file.name);
+    (lo.line, lo.col.to_usize() + 1, hi.line, hi.col.to_usize() + 1)
+}
+
+fn semantic_dependencies(
+    dependencies: &[TypeckImplDependency],
+) -> HashSet<(LocalDefId, LocalDefId, Option<DefId>)> {
+    dependencies
+        .iter()
+        .map(|dependency| {
+            (
+                dependency.source_owner,
+                dependency.impl_def_id,
+                dependency.associated_item,
+            )
+        })
+        .collect()
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id).as_str() == name)
+        .unwrap()
+}
+
+fn associated_item(tcx: TyCtxt<'_>, owner: DefId, name: &str) -> DefId {
+    tcx.associated_items(owner)
+        .in_definition_order()
+        .find(|item| item.opt_name().is_some_and(|item_name| item_name.as_str() == name))
+        .unwrap()
+        .def_id
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&def_id| {
+            tcx.impl_trait_id(def_id) == trait_id
+                && tcx
+                    .impl_trait_ref(def_id)
+                    .skip_binder()
+                    .self_ty()
+                    .ty_adt_def()
+                    .is_some_and(|adt| adt.did() == adt_id)
+        })
+        .unwrap()
+}
+
+fn only_impl_for_trait(tcx: TyCtxt<'_>, trait_id: DefId) -> DefId {
+    let mut impls = tcx
+        .iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .filter(|&def_id| tcx.impl_trait_id(def_id) == trait_id);
+    let impl_def_id = impls.next().unwrap();
+    assert_eq!(impls.next(), None);
+    impl_def_id
+}
