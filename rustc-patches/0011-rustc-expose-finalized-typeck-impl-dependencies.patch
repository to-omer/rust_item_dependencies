+                tcx.erase_and_anonymize_regions(infcx.resolve_vars_if_possible(normalized_value));
+            let result = if erased.has_infer() { Err(NoSolution) } else { Ok(erased) };
+            let dependencies = match (result, dependencies) {
+                (Ok(_), Ok(dependencies)) => {
+                    Ok(tcx.arena.alloc_from_iter(dependencies) as &[TypeckImplDependency])
+                }
+                _ => Err(TypeckImplDependenciesError::IncompleteObservation),
+            };
+            NormalizedGenericArgImplDependencies { result, dependencies }
+        }
+        Err(NoSolution) => NormalizedGenericArgImplDependencies {
+            result: Err(NoSolution),
+            dependencies: Err(TypeckImplDependenciesError::IncompleteObservation),
+        },
+    }
