@@ -0,0 +1,260 @@
+use rustc_hir::HirId;
+use rustc_hir::intravisit::{self, Visitor};
+use rustc_middle::traits::{
+    CodegenAssociatedItemProof, ImplSource, TypeckImplDependenciesError, TypeckImplDependency,
+};
+use rustc_middle::ty::{self, TyCtxt, TypeVisitableExt, Unnormalized};
+use rustc_span::Span;
+use rustc_span::def_id::{DefId, LocalDefId};
+
+pub(crate) fn typeck_impl_dependencies<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    (): (),
+) -> Result<&'tcx [TypeckImplDependency], TypeckImplDependenciesError> {
+    let mut dependencies = Vec::new();
+    observe_finalized_bodies(tcx, &mut dependencies)?;
+    observe_well_formed_items(tcx, &mut dependencies)?;
+    observe_compared_impl_items(tcx, &mut dependencies)?;
+    dependencies.sort_by_key(|dependency| {
+        (
+            tcx.def_path_hash(dependency.source_owner.to_def_id()),
+            dependency.source_span.lo(),
+            dependency.source_span.hi(),
+            tcx.def_path_hash(dependency.impl_def_id.to_def_id()),
+            dependency.associated_item.map(|item| tcx.def_path_hash(item)),
+        )
+    });
+    dependencies.dedup();
+    Ok(tcx.arena.alloc_from_iter(dependencies))
+}
+
+fn observe_finalized_bodies<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    dependencies: &mut Vec<TypeckImplDependency>,
+) -> Result<(), TypeckImplDependenciesError> {
+    let mut roots =
+        tcx.hir_body_owners().map(|owner| tcx.typeck_root_def_id_local(owner)).collect::<Vec<_>>();
+    roots.sort_by_key(|root| tcx.def_path_hash(root.to_def_id()));
+    roots.dedup();
+
+    for root in roots {
+        let results = tcx.typeck(root);
+        if results.tainted_by_errors.is_some() {
+            return Err(TypeckImplDependenciesError::IncompleteObservation);
+        }
+        let recorded = results
+            .typeck_impl_dependencies
+            .as_deref()
+            .ok_or(TypeckImplDependenciesError::IncompleteObservation)?;
+        dependencies.extend_from_slice(recorded);
+        if !results.coroutine_stalled_predicates.is_empty() {
+            let observed = tcx.check_coroutine_obligations_with_impl_dependencies(root);
+            let cached = tcx.check_coroutine_obligations_with_impl_dependencies(root);
+            if !std::ptr::eq(observed, cached) || observed.result.is_err() {
+                return Err(TypeckImplDependenciesError::IncompleteObservation);
+            }
+            dependencies.extend_from_slice(observed.dependencies?);
+        }
+        for (local_id, result) in results.type_dependent_defs().items_in_stable_order() {
+            let (_, item) =
+                result.as_ref().map_err(|_| TypeckImplDependenciesError::IncompleteObservation)?;
+            if tcx.trait_of_assoc(*item).is_none() {
+                continue;
+            }
+            let site = HirId { owner: results.hir_owner, local_id };
+            let args = results
+                .node_args_opt(site)
+                .ok_or(TypeckImplDependenciesError::IncompleteObservation)?;
+            let owner = tcx.hir_enclosing_body_owner(site);
+            let span = tcx.hir_span(site);
+            observe_body_associated_item(tcx, owner, span, *item, args, dependencies)?;
+        }
+
+        for (local_id, adjustments) in results.adjustments().items_in_stable_order() {
+            let site = HirId { owner: results.hir_owner, local_id };
+            let mut source_ty = results
+                .node_type_opt(site)
+                .ok_or(TypeckImplDependenciesError::IncompleteObservation)?;
+            for adjustment in adjustments {
+                if let ty::adjustment::Adjust::Deref(ty::adjustment::DerefAdjustKind::Overloaded(
+                    deref,
+                )) = adjustment.kind
+                {
+                    let item = deref.method_call(tcx);
+                    let args = tcx.mk_args(&[source_ty.into()]);
+                    observe_body_associated_item(
+                        tcx,
+                        tcx.hir_enclosing_body_owner(site),
+                        deref.span,
+                        item,
+                        args,
+                        dependencies,
+                    )?;
+                }
+                source_ty = adjustment.target;
+            }
+        }
+    }
+
+    let mut owners = tcx.hir_body_owners().collect::<Vec<_>>();
+    owners.sort_by_key(|owner| tcx.def_path_hash(owner.to_def_id()));
+    owners.dedup();
+    for owner in owners {
+        let results = tcx.typeck(tcx.typeck_root_def_id_local(owner));
+        let mut paths = ResolvedAssociatedPaths::default();
+        paths.visit_expr(tcx.hir_body_owned_by(owner).value);
+        for (item, hir_id, span) in paths.items {
+            if tcx.trait_of_assoc(item).is_none() {
+                continue;
+            }
+            let args = results
+                .node_args_opt(hir_id)
+                .ok_or(TypeckImplDependenciesError::IncompleteObservation)?;
+            observe_body_associated_item(tcx, owner, span, item, args, dependencies)?;
+        }
+
+        let built = tcx.mir_built_with_impl_dependencies(owner);
+        if !std::ptr::eq(built, tcx.mir_built_with_impl_dependencies(owner)) {
+            return Err(TypeckImplDependenciesError::IncompleteObservation);
+        }
+        dependencies.extend_from_slice(built.dependencies?);
+    }
+    Ok(())
+}
+
+fn observe_body_associated_item<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    owner: LocalDefId,
+    span: Span,
+    item: DefId,
+    args: ty::GenericArgsRef<'tcx>,
+    dependencies: &mut Vec<TypeckImplDependency>,
+) -> Result<(), TypeckImplDependenciesError> {
+    if args.has_non_region_infer() || args.has_escaping_bound_vars() {
+        return Err(TypeckImplDependenciesError::Unresolved);
+    }
+    let typing_env = if args.has_non_region_param() {
+        ty::TypingEnv::post_analysis(tcx, owner)
+    } else {
+        ty::TypingEnv::fully_monomorphized()
+    };
+    let args = tcx
+        .try_normalize_erasing_regions(typing_env, Unnormalized::new_wip(args))
+        .map_err(|_| TypeckImplDependenciesError::Unresolved)?;
+    let trait_id =
+        tcx.trait_of_assoc(item).ok_or(TypeckImplDependenciesError::IncompleteObservation)?;
+    let trait_ref = ty::TraitRef::from_assoc(tcx, trait_id, args);
+    let selection_key = typing_env.as_query_input(trait_ref);
+    let source = tcx
+        .codegen_select_candidate(selection_key)
+        .map_err(|error| TypeckImplDependenciesError::Selection(error.into()))?;
+    if matches!(source, ImplSource::Param(_) | ImplSource::Builtin(..)) {
+        return Ok(());
+    }
+    let key = tcx.erase_and_anonymize_regions(typing_env.as_query_input((item, args)));
+    let proof = associated_item_proof(tcx, key)?;
+    let ImplSource::UserDefined(source) = &proof.source else {
+        return Ok(());
+    };
+    let Some(impl_def_id) = source.impl_def_id.as_local() else {
+        return Ok(());
+    };
+    if !dependencies
+        .iter()
+        .any(|dependency| dependency.source_owner == owner && dependency.impl_def_id == impl_def_id)
+    {
+        return Err(TypeckImplDependenciesError::IncompleteObservation);
+    }
+    dependencies.push(TypeckImplDependency {
+        source_owner: owner,
+        source_span: span,
+        impl_def_id,
+        associated_item: Some(proof.leaf_item),
+    });
+    Ok(())
+}
+
+fn observe_well_formed_items<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    dependencies: &mut Vec<TypeckImplDependency>,
+) -> Result<(), TypeckImplDependenciesError> {
+    let items = tcx.hir_crate_items(());
+    let mut owners = items
+        .free_items()
+        .map(|item| item.owner_id.def_id)
+        .chain(items.impl_items().map(|item| item.owner_id.def_id))
+        .chain(items.trait_items().map(|item| item.owner_id.def_id))
+        .chain(items.foreign_items().map(|item| item.owner_id.def_id))
+        .chain(items.nested_bodies())
+        .chain(items.opaques())
+        .collect::<Vec<_>>();
+    owners.sort_by_key(|owner| tcx.def_path_hash(owner.to_def_id()));
+    owners.dedup();
+
+    for owner in owners {
+        let observed = tcx.check_well_formed_with_impl_dependencies(owner);
+        let cached = tcx.check_well_formed_with_impl_dependencies(owner);
+        if !std::ptr::eq(observed, cached) || observed.result.is_err() {
+            return Err(TypeckImplDependenciesError::IncompleteObservation);
+        }
+        dependencies.extend_from_slice(observed.dependencies?);
+    }
+    Ok(())
+}
+
+fn observe_compared_impl_items<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    dependencies: &mut Vec<TypeckImplDependency>,
+) -> Result<(), TypeckImplDependenciesError> {
+    let mut owners = tcx
+        .hir_crate_items(())
+        .impl_items()
+        .map(|item| item.owner_id.def_id)
+        .filter(|&owner| {
+            matches!(tcx.associated_item(owner).container, ty::AssocContainer::TraitImpl(Ok(_)))
+        })
+        .collect::<Vec<_>>();
+    owners.sort_by_key(|owner| tcx.def_path_hash(owner.to_def_id()));
+    owners.dedup();
+
+    for owner in owners {
+        let observed = tcx.compare_impl_item_with_impl_dependencies(owner);
+        let cached = tcx.compare_impl_item_with_impl_dependencies(owner);
+        if !std::ptr::eq(observed, cached) || observed.result.is_err() {
+            return Err(TypeckImplDependenciesError::IncompleteObservation);
+        }
+        dependencies.extend_from_slice(observed.dependencies?);
+    }
+    Ok(())
+}
+
+fn associated_item_proof<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    key: ty::PseudoCanonicalInput<'tcx, (DefId, ty::GenericArgsRef<'tcx>)>,
+) -> Result<&'tcx CodegenAssociatedItemProof<'tcx>, TypeckImplDependenciesError> {
+    let cold = tcx
+        .codegen_associated_item_proof(key)
+        .map_err(TypeckImplDependenciesError::AssociatedItem)?;
+    let warm = tcx
+        .codegen_associated_item_proof(key)
+        .map_err(TypeckImplDependenciesError::AssociatedItem)?;
+    std::ptr::eq(cold, warm)
+        .then_some(cold)
+        .ok_or(TypeckImplDependenciesError::IncompleteObservation)
+}
+
+#[derive(Default)]
+struct ResolvedAssociatedPaths {
+    items: Vec<(DefId, HirId, Span)>,
+}
+
+impl<'tcx> Visitor<'tcx> for ResolvedAssociatedPaths {
+    fn visit_expr(&mut self, expression: &'tcx rustc_hir::Expr<'tcx>) {
+        if let rustc_hir::ExprKind::Path(rustc_hir::QPath::Resolved(_, path)) = expression.kind
+            && let Some(item) = path.res.opt_def_id()
+        {
+            self.items.push((item, expression.hir_id, expression.span));
+        }
+        intravisit::walk_expr(self, expression);
+    }
+}
