+        let drop_impl_item = tcx.impl_item_implementor_ids(drop_impl)[&drop_trait_item];
+
+        let direct = tcx.adt_destructor_with_impl_dependencies(dropped);
+        assert!(std::ptr::eq(direct, tcx.adt_destructor_with_impl_dependencies(dropped)));
+        assert_eq!(direct.result.unwrap().did, drop_impl_item);
+        let direct_dependencies = direct.dependencies.unwrap();
+        assert_eq!(direct_dependencies.len(), 1);
+        assert_eq!(direct_dependencies[0].source_owner, dropped);
+        assert_eq!(direct_dependencies[0].source_span, tcx.def_span(dropped));
+        assert_eq!(direct_dependencies[0].impl_def_id, drop_impl);
+        assert_eq!(direct_dependencies[0].associated_item, Some(drop_impl_item));
+
+        let no_drop = tcx.adt_destructor_with_impl_dependencies(plain);
+        assert!(std::ptr::eq(no_drop, tcx.adt_destructor_with_impl_dependencies(plain)));
+        assert!(no_drop.result.is_none());
+        assert!(no_drop.dependencies.unwrap().is_empty());
+
+        assert_eq!(
+            cold.iter()
+                .filter(|dependency| dependency.source_owner == dropped)
+                .map(|dependency| (
+                    dependency.source_span,
+                    dependency.impl_def_id,
+                    dependency.associated_item,
+                ))
+                .collect::<Vec<_>>(),
+            vec![(tcx.def_span(dropped), drop_impl, Some(drop_impl_item))]
+        );
+        assert!(cold.iter().all(|dependency| dependency.source_owner != plain));
+
+        Compilation::Stop
+    }
+}
+
+fn named_def(tcx: TyCtxt<'_>, name: &str, kind: DefKind) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .find(|&def_id| tcx.def_kind(def_id) == kind && tcx.item_name(def_id).as_str() == name)
+        .unwrap()
+}
+
+fn associated_item(tcx: TyCtxt<'_>, owner: DefId, name: &str) -> DefId {
+    tcx.associated_items(owner)
+        .in_definition_order()
+        .find(|item| item.opt_name().is_some_and(|item_name| item_name.as_str() == name))
+        .unwrap()
+        .def_id
+}
+
+fn impl_for_adt(tcx: TyCtxt<'_>, trait_id: DefId, adt_id: DefId) -> DefId {
+    tcx.iter_local_def_id()
+        .map(LocalDefId::to_def_id)
+        .filter(|&def_id| tcx.def_kind(def_id) == DefKind::Impl { of_trait: true })
+        .find(|&def_id| {
+            tcx.impl_trait_id(def_id) == trait_id
+                && tcx
+                    .impl_trait_ref(def_id)
+                    .skip_binder()
+                    .self_ty()
+                    .ty_adt_def()
+                    .is_some_and(|adt| adt.did() == adt_id)
+        })
+        .unwrap()
+}
