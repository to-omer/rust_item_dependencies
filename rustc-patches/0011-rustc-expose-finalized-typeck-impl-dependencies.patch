+fn try_normalize_generic_arg_after_erasing_regions_with_impl_dependencies<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    (goal, owner, span): (PseudoCanonicalInput<'tcx, ty::GenericArg<'tcx>>, LocalDefId, Span),
+) -> NormalizedGenericArgImplDependencies<'tcx> {
