index 00000000..36fb2f6b
--- /dev/null
+++ b/compiler/rustc_trait_selection/src/traits/typeck_impl_dependencies.rs
@@ -0,0 +1,509 @@
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::rc::Rc;
+
+use rustc_data_structures::fx::{FxHashMap, FxHashSet};
+use rustc_infer::infer::InferCtxt;
+use rustc_infer::traits::{Obligation, PredicateObligation};
+use rustc_middle::traits::{ImplSource, ObligationCause, TypeckImplDependency};
+use rustc_middle::ty::{self, TyCtxt, TypeVisitableExt, Upcast};
+use rustc_span::def_id::{CRATE_DEF_ID, DefId};
+
+pub type SharedTypeckImplDependencyRecorder<'tcx> = Rc<RefCell<TypeckImplDependencyRecorder<'tcx>>>;
+
+#[derive(Clone)]
+struct PendingDependency<'tcx> {
+    key: (ty::ParamEnv<'tcx>, ty::Predicate<'tcx>),
+    impl_def_id: rustc_span::def_id::LocalDefId,
+    associated_item: Option<DefId>,
+    selected_args: ty::GenericArgsRef<'tcx>,
+}
+
+#[derive(Clone)]
+struct ObligationOrigin<'tcx> {
+    key: (ty::ParamEnv<'tcx>, ty::Predicate<'tcx>),
+    owner: rustc_span::def_id::LocalDefId,
+    span: rustc_span::Span,
+}
+
+#[derive(Clone)]
+struct OriginPropagation<'tcx> {
+    parent: (ty::ParamEnv<'tcx>, ty::Predicate<'tcx>),
+    child: (ty::ParamEnv<'tcx>, ty::Predicate<'tcx>),
+}
+
+type ProjectionKey<'tcx> = (ty::ParamEnv<'tcx>, ty::AliasTerm<'tcx>);
+
+#[derive(Clone)]
+struct PendingProjectionDependency<'tcx> {
+    key: ProjectionKey<'tcx>,
+    impl_def_id: rustc_span::def_id::LocalDefId,
+    associated_item: Option<DefId>,
+    selected_args: ty::GenericArgsRef<'tcx>,
+}
+
+#[derive(Clone)]
+struct ProjectionOrigin<'tcx> {
+    key: ProjectionKey<'tcx>,
+    owner: rustc_span::def_id::LocalDefId,
+    span: rustc_span::Span,
+}
+
+#[derive(Clone, Default)]
+pub struct TypeckImplDependencyRecorder<'tcx> {
+    dependencies: Vec<PendingDependency<'tcx>>,
+    origins: Vec<ObligationOrigin<'tcx>>,
+    origin_propagations: Vec<OriginPropagation<'tcx>>,
+    projection_dependencies: Vec<PendingProjectionDependency<'tcx>>,
+    projection_origins: Vec<ProjectionOrigin<'tcx>>,
+    projection_results: Vec<ProjectionKey<'tcx>>,
+    inherited_projection_results: Vec<ProjectionKey<'tcx>>,
+    finalized_dependencies: Vec<TypeckImplDependency>,
+    incomplete: bool,
+    muted: usize,
+}
+
+impl<'tcx> TypeckImplDependencyRecorder<'tcx> {
+    pub fn shared() -> SharedTypeckImplDependencyRecorder<'tcx> {
+        Rc::new(RefCell::new(Self::default()))
+    }
+
+    pub fn shared_transaction(
+        parent: &SharedTypeckImplDependencyRecorder<'tcx>,
+    ) -> SharedTypeckImplDependencyRecorder<'tcx> {
+        let parent = parent.borrow();
+        let mut inherited_projection_results = parent.projection_results.clone();
+        for result in &parent.inherited_projection_results {
+            if !inherited_projection_results.contains(result) {
+                inherited_projection_results.push(*result);
+            }
+        }
+        Rc::new(RefCell::new(Self { inherited_projection_results, ..Self::default() }))
+    }
+
+    pub fn register_origin(&mut self, obligation: &PredicateObligation<'tcx>) {
+        if self.muted != 0 {
+            return;
+        }
+        if obligation.cause.body_def_id == CRATE_DEF_ID {
+            return;
+        }
+        if let Some(projection) = obligation.predicate.as_projection_clause() {
+            let Some(projection) = projection.no_bound_vars() else {
+                return;
+            };
+            self.register_projection_origin(
+                obligation.param_env,
+                projection.projection_term,
+                &obligation.cause,
+            );
+        }
+        let key = (obligation.param_env, obligation.predicate);
+        let origin = ObligationOrigin {
+            key,
+            owner: obligation.cause.body_def_id,
+            span: obligation.cause.span,
+        };
+        // Resolve and deduplicate in `finish`; eager linear deduplication is quadratic for large
+        // generated bodies.
+        self.origins.push(origin);
+    }
+
+    pub(crate) fn record_selection<N>(
+        &mut self,
+        tcx: TyCtxt<'tcx>,
+        obligation: &Obligation<'tcx, ty::PolyTraitPredicate<'tcx>>,
+        source: &ImplSource<'tcx, N>,
+    ) {
+        let predicate: ty::Predicate<'tcx> = obligation.predicate.upcast(tcx);
+        self.record_impl_source(&obligation.with(tcx, predicate), source, None);
+    }
+
+    pub fn register_nested_origin(
+        &mut self,
+        parent: &PredicateObligation<'tcx>,
+        child: &PredicateObligation<'tcx>,
+    ) {
+        if self.muted != 0 {
+            return;
+        }
+        self.register_origin(parent);
+        self.register_origin(child);
+        let propagation = OriginPropagation {
+            parent: (parent.param_env, parent.predicate),
+            child: (child.param_env, child.predicate),
+        };
+        // As with origins, inference can make distinct input keys equal, so `finish` is the
+        // authoritative and cheaper place to deduplicate.
+        self.origin_propagations.push(propagation);
+    }
+
+    pub fn commit_transaction(&mut self, transaction: &Self) {
+        if self.muted != 0 {
+            return;
+        }
+        if transaction.muted != 0 {
+            self.incomplete = true;
+            return;
+        }
+        self.incomplete |= transaction.incomplete;
+        self.dependencies.extend(transaction.dependencies.iter().cloned());
+        self.origins.extend(transaction.origins.iter().cloned());
+        self.origin_propagations.extend(transaction.origin_propagations.iter().cloned());
+        self.projection_dependencies.extend(transaction.projection_dependencies.iter().cloned());
+        self.projection_origins.extend(transaction.projection_origins.iter().cloned());
+        self.finalized_dependencies.extend_from_slice(&transaction.finalized_dependencies);
+        for result in &transaction.projection_results {
+            if !self.projection_results.contains(result) {
+                self.projection_results.push(*result);
+            }
+        }
+    }
+
+    /// Freeze values selected inside an inference probe before that probe rolls back.
+    pub fn resolve_transaction(&mut self, infcx: &InferCtxt<'tcx>) -> Result<(), ()> {
+        for dependency in &mut self.dependencies {
+            dependency.key = infcx.resolve_vars_if_possible(dependency.key);
+            dependency.selected_args = infcx.resolve_vars_if_possible(dependency.selected_args);
+            if dependency.key.has_non_region_infer()
+                || dependency.key.has_escaping_bound_vars()
+                || dependency.selected_args.has_non_region_infer()
+                || dependency.selected_args.has_escaping_bound_vars()
+            {
+                return Err(());
+            }
+        }
+        for origin in &mut self.origins {
+            origin.key = infcx.resolve_vars_if_possible(origin.key);
+            if origin.key.has_non_region_infer() || origin.key.has_escaping_bound_vars() {
+                return Err(());
+            }
+        }
+        for propagation in &mut self.origin_propagations {
+            propagation.parent = infcx.resolve_vars_if_possible(propagation.parent);
+            propagation.child = infcx.resolve_vars_if_possible(propagation.child);
+            if propagation.parent.has_non_region_infer()
+                || propagation.parent.has_escaping_bound_vars()
+                || propagation.child.has_non_region_infer()
+                || propagation.child.has_escaping_bound_vars()
+            {
+                return Err(());
+            }
+        }
+        for dependency in &mut self.projection_dependencies {
+            dependency.key = infcx.resolve_vars_if_possible(dependency.key);
+            dependency.selected_args = infcx.resolve_vars_if_possible(dependency.selected_args);
+            if dependency.key.has_non_region_infer()
+                || dependency.key.has_escaping_bound_vars()
+                || dependency.selected_args.has_non_region_infer()
+                || dependency.selected_args.has_escaping_bound_vars()
+            {
+                return Err(());
+            }
+        }
+        for origin in &mut self.projection_origins {
+            origin.key = infcx.resolve_vars_if_possible(origin.key);
+            if origin.key.has_non_region_infer() || origin.key.has_escaping_bound_vars() {
+                return Err(());
+            }
+        }
+        for result in &mut self.projection_results {
+            *result = infcx.resolve_vars_if_possible(*result);
+            if result.has_non_region_infer() || result.has_escaping_bound_vars() {
+                return Err(());
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn record_projection<N>(
+        &mut self,
+        obligation: &Obligation<'tcx, ty::AliasTerm<'tcx>>,
+        source: &ImplSource<'tcx, N>,
+        associated_item: Option<DefId>,
+    ) {
+        if self.muted != 0 {
+            return;
+        }
+        let ImplSource::UserDefined(source) = source else { return };
+        let Some(impl_def_id) = source.impl_def_id.as_local() else { return };
+        self.projection_dependencies.push(PendingProjectionDependency {
+            key: (obligation.param_env, obligation.predicate),
+            impl_def_id,
+            associated_item,
+            selected_args: source.args,
+        });
+    }
+
+    pub(crate) fn mark_incomplete(&mut self) {
+        if self.muted == 0 {
+            self.incomplete = true;
+        }
+    }
+
+    pub fn commit_finalized_dependencies(
+        &mut self,
+        dependencies: Result<Vec<TypeckImplDependency>, ()>,
+    ) {
+        if self.muted != 0 {
+            return;
+        }
+        match dependencies {
+            Ok(dependencies) => self.finalized_dependencies.extend(dependencies),
+            Err(()) => self.incomplete = true,
+        }
+    }
+
+    pub(crate) fn mute(&mut self) {
+        self.muted += 1;
+    }
+
+    pub(crate) fn unmute(&mut self) {
+        self.muted = self.muted.checked_sub(1).expect("unbalanced impl dependency mute");
+    }
+
+    pub(crate) fn is_recording(&self) -> bool {
+        self.muted == 0
+    }
+
+    pub(crate) fn observe_projection(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+        cause: &ObligationCause<'tcx>,
+    ) {
+        if self.muted == 0 {
+            self.register_projection_origin(param_env, projection, cause);
+        }
+    }
+
+    pub(crate) fn projection_has_result(
+        &self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+    ) -> bool {
+        let key = (param_env, projection);
+        self.projection_results.contains(&key) || self.inherited_projection_results.contains(&key)
+    }
+
+    pub(crate) fn record_projection_result(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+    ) {
+        let key = (param_env, projection);
+        if self.muted == 0 && !self.projection_results.contains(&key) {
+            self.projection_results.push(key);
+        }
+    }
+
+    fn register_projection_origin(
+        &mut self,
+        param_env: ty::ParamEnv<'tcx>,
+        projection: ty::AliasTerm<'tcx>,
+        cause: &ObligationCause<'tcx>,
+    ) {
+        if cause.body_def_id == CRATE_DEF_ID {
+            return;
+        }
+        let origin = ProjectionOrigin {
+            key: (param_env, projection),
+            owner: cause.body_def_id,
+            span: cause.span,
+        };
+        if !self.projection_origins.iter().any(|existing| {
+            existing.key == origin.key
+                && existing.owner == origin.owner
+                && existing.span == origin.span
+        }) {
+            self.projection_origins.push(origin);
+        }
+    }
+
+    fn record_impl_source<N>(
+        &mut self,
+        obligation: &PredicateObligation<'tcx>,
+        source: &ImplSource<'tcx, N>,
+        associated_item: Option<DefId>,
+    ) {
+        if self.muted != 0 {
+            return;
+        }
+        let ImplSource::UserDefined(source) = source else { return };
+        let Some(impl_def_id) = source.impl_def_id.as_local() else { return };
+        self.register_origin(obligation);
+        self.dependencies.push(PendingDependency {
+            key: (obligation.param_env, obligation.predicate),
+            impl_def_id,
+            associated_item,
+            selected_args: source.args,
+        });
+    }
+
+    pub fn finish(&self, infcx: &InferCtxt<'tcx>) -> Result<Vec<TypeckImplDependency>, ()> {
+        if self.incomplete || self.muted != 0 || infcx.tainted_by_errors().is_some() {
+            return Err(());
+        }
+        let mut origins = Vec::new();
+        let mut seen_origins = FxHashSet::default();
+        for origin in &self.origins {
+            let key = infcx.resolve_vars_if_possible(origin.key);
+            if key.has_non_region_infer() || key.has_escaping_bound_vars() {
+                return Err(());
+            }
+            let origin = ObligationOrigin { key, owner: origin.owner, span: origin.span };
+            if seen_origins.insert((origin.key, origin.owner, origin.span)) {
+                origins.push(origin);
+            }
+        }
+        let mut propagations = Vec::new();
+        let mut seen_propagations = FxHashSet::default();
+        for propagation in &self.origin_propagations {
+            let parent = infcx.resolve_vars_if_possible(propagation.parent);
+            let child = infcx.resolve_vars_if_possible(propagation.child);
+            if parent.has_non_region_infer()
+                || parent.has_escaping_bound_vars()
+                || child.has_non_region_infer()
+                || child.has_escaping_bound_vars()
+            {
+                return Err(());
+            }
+            if seen_propagations.insert((parent, child)) {
+                propagations.push(OriginPropagation { parent, child });
+            }
+        }
+        let mut children = FxHashMap::<_, Vec<_>>::default();
+        for propagation in propagations {
+            children.entry(propagation.parent).or_default().push(propagation.child);
+        }
+        let mut pending = origins.iter().cloned().collect::<VecDeque<_>>();
+        while let Some(origin) = pending.pop_front() {
+            if let Some(children) = children.get(&origin.key) {
+                for &child in children {
+                    let propagated =
+                        ObligationOrigin { key: child, owner: origin.owner, span: origin.span };
+                    if seen_origins.insert((propagated.key, propagated.owner, propagated.span)) {
+                        origins.push(propagated.clone());
+                        pending.push_back(propagated);
+                    }
+                }
+            }
+        }
+
+        let mut origins_by_key = FxHashMap::<_, Vec<_>>::default();
+        for origin in &origins {
+            origins_by_key.entry(origin.key).or_default().push((origin.owner, origin.span));
+        }
+        let mut dependencies = self.finalized_dependencies.clone();
+        let mut selected_by_key = FxHashMap::default();
+        for pending in &self.dependencies {
+            let args = infcx.resolve_vars_if_possible(pending.selected_args);
+            if args.has_non_region_infer() || args.has_escaping_bound_vars() {
+                return Err(());
+            }
+            let key = infcx.resolve_vars_if_possible(pending.key);
+            if key.has_non_region_infer() || key.has_escaping_bound_vars() {
+                return Err(());
+            }
+            let selected = (pending.impl_def_id, pending.associated_item);
+            if let Some(previous) = selected_by_key.get(&key) {
+                if *previous != selected {
+                    return Err(());
+                }
+            } else {
+                selected_by_key.insert(key, selected);
+            }
+            let Some(origins) = origins_by_key.get(&key) else { return Err(()) };
+            for &(source_owner, source_span) in origins {
+                dependencies.push(TypeckImplDependency {
+                    source_owner,
+                    source_span,
+                    impl_def_id: pending.impl_def_id,
+                    associated_item: pending.associated_item,
+                });
+            }
+        }
+
+        let mut projection_origins = self
+            .projection_origins
+            .iter()
+            .map(|origin| {
+                let key = infcx.resolve_vars_if_possible(origin.key);
+                if key.has_non_region_infer() || key.has_escaping_bound_vars() {
+                    Err(())
+                } else {
+                    Ok(ProjectionOrigin { key, owner: origin.owner, span: origin.span })
+                }
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        let mut seen_projection_origins = projection_origins
+            .iter()
+            .map(|origin| (origin.key, origin.owner, origin.span))
+            .collect::<FxHashSet<_>>();
+        for origin in &origins {
+            let Some(projection) = origin.key.1.as_projection_clause() else { continue };
+            let Some(projection) = projection.no_bound_vars() else { return Err(()) };
+            let projection_origin = ProjectionOrigin {
+                key: (origin.key.0, projection.projection_term),
+                owner: origin.owner,
+                span: origin.span,
+            };
+            if seen_projection_origins.insert((
+                projection_origin.key,
+                projection_origin.owner,
+                projection_origin.span,
+            )) {
+                projection_origins.push(projection_origin);
+            }
+        }
+        let mut projection_origins_by_key = FxHashMap::<_, Vec<_>>::default();
+        for origin in &projection_origins {
+            projection_origins_by_key
+                .entry(origin.key)
+                .or_default()
+                .push((origin.owner, origin.span));
+        }
+        let mut projection_results = FxHashSet::default();
+        if !self.projection_dependencies.is_empty() {
+            for result in &self.projection_results {
+                let result = infcx.resolve_vars_if_possible(*result);
+                if result.has_non_region_infer() || result.has_escaping_bound_vars() {
+                    continue;
+                }
+                projection_results.insert(result);
+            }
+        }
+        let mut projection_selected_by_key = FxHashMap::default();
+        for pending in &self.projection_dependencies {
+            let args = infcx.resolve_vars_if_possible(pending.selected_args);
+            if args.has_non_region_infer() || args.has_escaping_bound_vars() {
+                return Err(());
+            }
+            let key = infcx.resolve_vars_if_possible(pending.key);
+            if key.has_non_region_infer() || key.has_escaping_bound_vars() {
+                return Err(());
+            }
+            let selected = (pending.impl_def_id, pending.associated_item);
+            if let Some(previous) = projection_selected_by_key.get(&key) {
+                if *previous != selected {
+                    return Err(());
+                }
+            } else {
+                projection_selected_by_key.insert(key, selected);
+            }
+            if !projection_results.contains(&key) {
+                return Err(());
+            }
+            let Some(origins) = projection_origins_by_key.get(&key) else { return Err(()) };
+            for &(source_owner, source_span) in origins {
+                dependencies.push(TypeckImplDependency {
+                    source_owner,
+                    source_span,
+                    impl_def_id: pending.impl_def_id,
+                    associated_item: pending.associated_item,
+                });
+            }
+        }
+        Ok(dependencies)
+    }
+}
