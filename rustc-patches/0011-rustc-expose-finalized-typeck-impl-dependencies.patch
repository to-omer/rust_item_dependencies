+fn normalize_canonicalized_projection_with_impl_dependencies<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    (goal, owner, span): (CanonicalAliasGoal<'tcx>, LocalDefId, Span),
+) -> CanonicalNormalizationImplDependencies<'tcx> {
+    let (infcx, ParamEnvAnd { param_env, value: goal }, var_values) =
+        tcx.infer_ctxt().build_with_canonical(span, &goal);
+    let recorder = TypeckImplDependencyRecorder::shared();
+    let ocx: ObligationCtxt<'_, '_, ScrubbedTraitError<'tcx>> =
+        ObligationCtxt::new_scrubbed_with_typeck_impl_dependencies(&infcx, recorder.clone());
+    let result = (|| {
+        debug_assert!(!ocx.infcx.next_trait_solver());
+        let mut selcx = SelectionContext::with_query_mode_and_typeck_impl_dependency_recorder(
+            ocx.infcx,
+            TraitQueryMode::Standard,
+            recorder.clone(),
+        );
+        let cause = ObligationCause::misc(span, owner);
+        let mut obligations = PredicateObligations::new();
+        let normalized_term = traits::normalize_projection_term(
+            &mut selcx,
+            param_env,
+            goal,
+            cause,
+            0,
+            &mut obligations,
+        );
+        obligations.extend(const_arg_has_type_obligation(tcx, param_env, normalized_term, goal));
+        ocx.register_obligations(obligations);
+        let errors = ocx.try_evaluate_obligations();
+        if !errors.no_errors() {
